hML\"><semantics><mrow><msub><mi>\u03b2<\/mi><mi mathvariant=\"normal\">\u2113<\/mi><\/msub><\/mrow><annotation encoding=\"application\/x-tex\">\\beta_\\ell<\/annotation><\/semantics><\/math>\u200b\u3001RIS \u589e\u76ca <math xmlns=\"http:\/\/www.w3.org\/1998\/Math\/MathML\"><semantics><mrow><msub><mi>\u03b2<\/mi><mi>r<\/mi><\/msub><\/mrow><annotation encoding=\"application\/x-tex\">\\beta_r<\/annotation><\/semantics><\/math>\u200b \u7684\u89e3\u6790\u8868\u8fbe\u5f0f\uff0c\u8bc1\u660e\u5f02\u6b65 RIS \u914d\u7f6e\u653b\u51fb\uff08Attack 2\uff09\u6bd4\u975e\u5bf9\u79f0 RIS \u7ed3\u6784\u653b\u51fb\uff08Attack 1\uff09\u5177\u6709\u66f4\u5f3a\u7684\u7834\u574f\u529b\uff0c\u5e76\u7ed9\u51fa RIS \u90e8\u7f72\u4f4d\u7f6e\u5bf9\u653b\u51fb\u6548\u679c\u5f71\u54cd\u7684\u7406\u8bba\u8fb9\u754c\uff08\u5f53 Alice\/Bob \u4e0e RIS \u8ddd\u79bb\u4e3a Alice-Bob \u95f4\u8ddd\u7684 20% \u65f6\uff0c<math xmlns=\"http:\/\/www.w3.org\/1998\/Math\/MathML\"><semantics><mrow><msub><mi>\u03b2<\/mi><mi>r<\/mi><\/msub><mo>&gt;<\/mo><mn>0.01<\/mn><\/mrow><annotation encoding=\"application\/x-tex\">\\beta_r &gt; 0.01<\/annotation><\/semantics><\/math>\uff0c\u653b\u51fb\u53ef\u884c\uff09\u3002<\/li>\n\n\n\n<li class=\"lab-feature-list\"><strong>\u63d0\u51fa CPR-CRKG \u9632\u5fa1\u65b9\u6848\uff0c\u5229\u7528\u5bbd\u5e26\u591a\u5f84\u5206\u79bb\u5254\u9664\u6c61\u67d3\u8def\u5f84<\/strong>\uff1a\u57fa\u4e8e OFDM \u5bbd\u5e26\u4fe1\u53f7\u7684\u65f6\u57df\u5206\u8fa8\u80fd\u529b\uff0c\u5bf9\u4fe1\u9053\u4f30\u8ba1\u77e9\u9635\u8fdb\u884c IDCT \u53d8\u6362\u4ee5\u5206\u79bb\u5404\u591a\u5f84\u5206\u91cf\uff0c\u901a\u8fc7\u6bd4\u8f83\u4e0a\u4e0b\u884c\u8def\u5f84\u7684\u81ea\u76f8\u5173\u7cfb\u6570\u68c0\u6d4b RIS \u611f\u5e94\u8def\u5f84\uff0c\u5e76\u5c06\u5176\u4ece\u53ef\u7528\u8def\u5f84\u96c6\u5408\u4e2d\u5254\u9664\uff0c\u4ece\u800c\u5728\u4e0d\u4f9d\u8d56\u4fe1\u606f\u534f\u5546\u7684\u60c5\u51b5\u4e0b\u6062\u590d\u5bc6\u94a5\u751f\u6210\u80fd\u529b\uff1b\u6574\u4f53\u590d\u6742\u5ea6\u4e3a <math xmlns=\"http:\/\/www.w3.org\/1998\/Math\/MathML\"><semantics><mrow><mi>O<\/mi><mo stretchy=\"false\">(<\/mo><msup><mi>K<\/mi><mn>2<\/mn><\/msup><msub><mi>N<\/mi><mi>p<\/mi><\/msub><mo>+<\/mo><mi>K<\/mi><mi>log<\/mi><mo>\u2061<\/mo><mi>K<\/mi><mo>+<\/mo><msub><mi>N<\/mi><mi>p<\/mi><\/msub><msub><mi>N<\/mi><mrow><mi>s<\/mi><mi>e<\/mi><mi>l<\/mi><\/mrow><\/msub><mo stretchy=\"false\">)<\/mo><\/mrow><annotation encoding=\"application\/x-tex\">O(K^2 N_p + K \\log K + N_p N_{sel})<\/annotation><\/semantics><\/math>\u3002<\/li>\n<\/ul>\n\n\n\n<div class=\"wp-block-uagb-advanced-heading uagb-block-2f9d57f4 lab-subheading\"><h3 class=\"uagb-heading-text\">\ud83d\udd27 \u65b9\u6cd5\u6982\u89c8<\/h3><\/div>\n\n\n\n<div class=\"wp-block-group lab-paper-results is-nowrap is-layout-flex wp-container-core-group-is-layout-3a88641f wp-block-group-is-layout-flex\">\n<div class=\"wp-block-uagb-image uagb-block-b46d2053 wp-block-uagb-image--layout-default wp-block-uagb-image--effect-static wp-block-uagb-image--align-none wp-container-content-9cfa9a5a\"><figure class=\"wp-block-uagb-image__figure\"><img decoding=\"async\" srcset=\"http:\/\/jiushihema.github.io/pls_lab\/wp-content\/uploads\/2026\/03\/PixPin_2026-03-23_16-57-00.png ,http:\/\/jiushihema.github.io/pls_lab\/wp-content\/uploads\/2026\/03\/PixPin_2026-03-23_16-57-00.png 780w, http:\/\/jiushihema.github.io/pls_lab\/wp-content\/uploads\/2026\/03\/PixPin_2026-03-23_16-57-00.png 360w\" sizes=\"auto, (max-width: 480px) 150px\" src=\"http:\/\/jiushihema.github.io/pls_lab\/wp-content\/uploads\/2026\/03\/PixPin_2026-03-23_16-57-00.png\" alt=\"\" class=\"uag-image-1070\" width=\"802\" height=\"656\" title=\"PixPin_2026-03-23_16-57-00\" loading=\"lazy\" role=\"img\"\/><\/figure><\/div>\n\n\n\n<div class=\"wp-block-group is-vertical is-layout-flex wp-container-core-group-is-layout-831b2db5 wp-block-group-is-layout-flex\">\n<p class=\"lab-experiment-caption has-medium-font-size wp-block-paragraph\">\u7cfb\u7edf\u7531\u5355\u5929\u7ebf Alice\u3001Bob \u548c\u653b\u51fb\u8005 Eve \u7ec4\u6210\uff0c\u91c7\u7528 TDD-OFDM \u534f\u8bae\uff08\u5982 IEEE 802.11n Wi-Fi\uff09\u8fdb\u884c\u53cc\u5411\u4fe1\u9053\u63a2\u6d4b\u3002\u6709\u6548\u4fe1\u9053\u4e3a\u76f4\u63a5\u94fe\u8def\u4e0e RIS \u611f\u5e94\u94fe\u8def\u7684\u53e0\u52a0 <math xmlns=\"http:\/\/www.w3.org\/1998\/Math\/MathML\"><semantics><mrow><msub><mover accent=\"true\"><mi>h<\/mi><mo>~<\/mo><\/mover><mrow><mi>b<\/mi><mi>a<\/mi><\/mrow><\/msub><mo stretchy=\"false\">(<\/mo><mi>t<\/mi><mo separator=\"true\">,<\/mo><mi>k<\/mi><mo stretchy=\"false\">)<\/mo><mo>=<\/mo><msub><mi>h<\/mi><mi>d<\/mi><\/msub><mo stretchy=\"false\">(<\/mo><mi>k<\/mi><mo stretchy=\"false\">)<\/mo><mo>+<\/mo><msub><mi>\u03b2<\/mi><mi>r<\/mi><\/msub><mi mathvariant=\"normal\">\u03a6<\/mi><mo stretchy=\"false\">(<\/mo><mi>t<\/mi><mo stretchy=\"false\">)<\/mo><msup><mi>e<\/mi><mrow><mi>j<\/mi><msub><mi>\u03d5<\/mi><mi>r<\/mi><\/msub><mo stretchy=\"false\">(<\/mo><mi>t<\/mi><mo stretchy=\"false\">)<\/mo><\/mrow><\/msup><\/mrow><annotation encoding=\"application\/x-tex\">\\tilde{h}_{ba}(t, k) = h_d(k) + \\beta_r \\Phi(t) e^{j\\phi_r(t)}<\/annotation><\/semantics><\/math>\uff0c\u5176\u4e2d RIS \u53cd\u5c04\u77e9\u9635 <math xmlns=\"http:\/\/www.w3.org\/1998\/Math\/MathML\"><semantics><mrow><mi mathvariant=\"normal\">\u03a6<\/mi><mo stretchy=\"false\">(<\/mo><mi>t<\/mi><mo stretchy=\"false\">)<\/mo><\/mrow><annotation encoding=\"application\/x-tex\">\\Phi(t)<\/annotation><\/semantics><\/math> \u7684\u975e\u4e92\u6613\u6027\u662f\u653b\u51fb\u7684\u6838\u5fc3\u3002<strong>\u653b\u51fb\u9636\u6bb5<\/strong>\uff0cEve \u4ee4\u4e0a\u884c\u4e0e\u4e0b\u884c\u7684 <math xmlns=\"http:\/\/www.w3.org\/1998\/Math\/MathML\"><semantics><mrow><mi mathvariant=\"normal\">\u03a6<\/mi><mo stretchy=\"false\">(<\/mo><mi>t<\/mi><mo stretchy=\"false\">)<\/mo><\/mrow><annotation encoding=\"application\/x-tex\">\\Phi(t)<\/annotation><\/semantics><\/math> \u4e0d\u4e00\u81f4\uff08Attack 1\uff09\u6216\u5728\u63a2\u6d4b\u95f4\u9694\u5185\u968f\u673a\u5207\u6362\uff08Attack 2\uff09\uff0c\u4f7f <math xmlns=\"http:\/\/www.w3.org\/1998\/Math\/MathML\"><semantics><mrow><msub><mover accent=\"true\"><mi>h<\/mi><mo>~<\/mo><\/mover><mrow><mi>b<\/mi><mi>a<\/mi><\/mrow><\/msub><\/mrow><annotation encoding=\"application\/x-tex\">\\tilde{h}_{ba}<\/annotation><\/semantics><\/math>\u200b \u4e0e <math xmlns=\"http:\/\/www.w3.org\/1998\/Math\/MathML\"><semantics><mrow><msub><mover accent=\"true\"><mi>h<\/mi><mo>~<\/mo><\/mover><mrow><mi>a<\/mi><mi>b<\/mi><\/mrow><\/msub><\/mrow><annotation encoding=\"application\/x-tex\">\\tilde{h}_{ab}<\/annotation><\/semantics><\/math>\u200b \u5931\u53bb\u4e92\u6613\u6027\uff0cBDR \u5347\u9ad8\u81f3 0.15~0.2 \u7684\u8bef\u5dee\u5e95\u9650\u3002<strong>\u9632\u5fa1\u9636\u6bb5<\/strong>\uff0cCPR-CRKG \u5229\u7528\u5bbd\u5e26 OFDM \u7684\u65f6\u57df\u5206\u8fa8\u7387\uff0c\u901a\u8fc7 IDCT \u5c06\u9891\u57df\u4fe1\u9053\u4f30\u8ba1\u77e9\u9635 <math xmlns=\"http:\/\/www.w3.org\/1998\/Math\/MathML\"><semantics><mrow><mover accent=\"true\"><mi>H<\/mi><mo>~<\/mo><\/mover><\/mrow><annotation encoding=\"application\/x-tex\">\\tilde{H}<\/annotation><\/semantics><\/math> \u6620\u5c04\u5230\u65f6\u57df\u8def\u5f84\u57df <math xmlns=\"http:\/\/www.w3.org\/1998\/Math\/MathML\"><semantics><mrow><mover accent=\"true\"><mi>G<\/mi><mo>~<\/mo><\/mover><\/mrow><annotation encoding=\"application\/x-tex\">\\tilde{G}<\/annotation><\/semantics><\/math>\uff0c\u5bf9\u6bcf\u6761\u8def\u5f84\u8ba1\u7b97\u81ea\u76f8\u5173\u7cfb\u6570\u4ee5\u68c0\u6d4b\u5feb\u901f\u53d8\u5316\u7684 RIS \u8def\u5f84\uff0c\u534f\u5546\u6392\u9664\u540e\u4ec5\u5bf9\u5269\u4f59\u8def\u5f84\u8fdb\u884c\u91cf\u5316\u4e0e\u5bc6\u94a5\u63d0\u53d6\u3002<\/p>\n<\/div>\n<\/div>\n\n\n\n<div class=\"wp-block-uagb-advanced-heading uagb-block-dda34f26 lab-subheading\"><h3 class=\"uagb-heading-text\">\ud83d\udcca \u5b9e\u9a8c\u7ed3\u679c<\/h3><\/div>\n\n\n\n<div class=\"wp-block-group lab-paper-results is-nowrap is-layout-flex wp-container-core-group-is-layout-3a88641f wp-block-group-is-layout-flex\">\n<div class=\"wp-block-group is-vertical is-layout-flex wp-container-core-group-is-layout-831b2db5 wp-block-group-is-layout-flex\">\n<div class=\"wp-block-uagb-image uagb-block-080de2b0 wp-block-uagb-image--layout-default wp-block-uagb-image--effect-static wp-block-uagb-image--align-none wp-container-content-9cfa9a5a\"><figure class=\"wp-block-uagb-image__figure\"><img decoding=\"async\" srcset=\"http:\/\/jiushihema.github.io/pls_lab\/wp-content\/uploads\/2026\/03\/PixPin_2026-03-23_16-58-06.png ,http:\/\/jiushihema.github.io/pls_lab\/wp-content\/uploads\/2026\/03\/PixPin_2026-03-23_16-58-06.png 780w, http:\/\/jiushihema.github.io/pls_lab\/wp-content\/uploads\/2026\/03\/PixPin_2026-03-23_16-58-06.png 360w\" sizes=\"auto, (max-width: 480px) 150px\" src=\"http:\/\/jiushihema.github.io/pls_lab\/wp-content\/uploads\/2026\/03\/PixPin_2026-03-23_16-58-06.png\" alt=\"\" class=\"uag-image-1071\" width=\"802\" height=\"656\" title=\"PixPin_2026-03-23_16-58-06\" loading=\"lazy\" role=\"img\"\/><\/figure><\/div>\n\n\n\n<div class=\"wp-block-uagb-image uagb-block-080de2b0 wp-block-uagb-image--layout-default wp-block-uagb-image--effect-static wp-block-uagb-image--align-none wp-container-content-9cfa9a5a\"><figure class=\"wp-block-uagb-image__figure\"><img decoding=\"async\" srcset=\"http:\/\/jiushihema.github.io/pls_lab\/wp-content\/uploads\/2026\/03\/PixPin_2026-03-23_16-58-17.png ,http:\/\/jiushihema.github.io/pls_lab\/wp-content\/uploads\/2026\/03\/PixPin_2026-03-23_16-58-17.png 780w, http:\/\/jiushihema.github.io/pls_lab\/wp-content\/uploads\/2026\/03\/PixPin_2026-03-23_16-58-17.png 360w\" sizes=\"auto, (max-width: 480px) 150px\" src=\"http:\/\/jiushihema.github.io/pls_lab\/wp-content\/uploads\/2026\/03\/PixPin_2026-03-23_16-58-17.png\" alt=\"\" class=\"uag-image-1072\" width=\"802\" height=\"656\" title=\"PixPin_2026-03-23_16-58-17\" loading=\"lazy\" role=\"img\"\/><\/figure><\/div>\n<\/div>\n\n\n\n<div class=\"wp-block-group is-vertical is-layout-flex wp-container-core-group-is-layout-831b2db5 wp-block-group-is-layout-flex\">\n<p class=\"lab-experiment-caption has-medium-font-size wp-block-paragraph\"><strong>\u5728\u771f\u5b9e Wi-Fi + \u81ea\u5236 RIS \u539f\u578b\u8054\u5408\u5b9e\u9a8c\u4e2d\uff0cRIS \u5e72\u6270\u653b\u51fb\u4f7f\u5408\u6cd5\u7528\u6237 BDR \u5e73\u5747\u63d0\u5347 20%\uff0c\u800c CPR-CRKG \u9632\u5fa1\u65b9\u6848\u5c06 BDR \u964d\u81f3\u63a5\u8fd1\u65e0\u653b\u51fb\u6c34\u5e73\u7684\u7ea6 1\/4<\/strong>\uff1a\u5982\u539f\u6587 <strong>Fig. 12<\/strong> \u6240\u793a\uff0cBDR \u968f RIS \u8c03\u5236\u9891\u7387\u7ebf\u6027\u589e\u957f\u76f4\u81f3 <math xmlns=\"http:\/\/www.w3.org\/1998\/Math\/MathML\"><semantics><mrow><msub><mi>f<\/mi><mi>r<\/mi><\/msub><mo>=<\/mo><msub><mi>f<\/mi><mi>p<\/mi><\/msub><\/mrow><annotation encoding=\"application\/x-tex\">f_r = f_p<\/annotation><\/semantics><\/math>\u200b \u65f6\u8fbe\u5230\u9971\u548c\uff0c\u5728\u8ddd Alice \u7ea6 2 m \u7684\u5178\u578b\u4f4d\u7f6e\u53ef\u5b9e\u73b0\u7ea6 20% \u7684 BDR \u63d0\u5347\uff1b<strong>Fig. 13<\/strong> \u7684\u7a7a\u95f4\u70ed\u529b\u56fe\u8fdb\u4e00\u6b65\u663e\u793a\uff0c\u5f53 RIS \u9760\u8fd1 Alice \u4e14\u5165\u5c04\u89d2\u8f83\u5c0f\u65f6\u653b\u51fb\u6548\u679c\u6700\u5f3a\uff0c\u6700\u9ad8\u53ef\u8fbe\u7ea6 30% \u7684 BDR \u63d0\u5347\u3002<strong>Fig. 9<\/strong> \u7684\u4eff\u771f\u7ed3\u679c\u5219\u8868\u660e\uff0c\u5728 CPR-CRKG \u9632\u62a4\u4e0b\uff0c\u53d7\u653b\u51fb\u65b9\u6848\u7684 BDR \u66f2\u7ebf\uff08\u865a\u7ebf\uff09\u7ea6\u4e3a\u5bf9\u5e94\u653b\u51fb\u66f2\u7ebf\uff08\u5b9e\u7ebf\uff09\u7684\u56db\u5206\u4e4b\u4e00\uff0c\u4e14\u5728 SNR &lt; 15 dB \u65f6 CPR-CRKG \u7684 BDR \u751a\u81f3\u4f4e\u4e8e\u65e0\u653b\u51fb\u7684\u539f\u59cb CRKG \u65b9\u6848\uff0c\u9a8c\u8bc1\u4e86\u9632\u5fa1\u65b9\u6848\u5bf9\u566a\u58f0\u4e0e\u653b\u51fb\u7684\u53cc\u91cd\u6291\u5236\u6548\u679c\u3002<\/p>\n\n\n\n<div class=\"wp-block-uagb-image uagb-block-080de2b0 wp-block-uagb-image--layout-default wp-block-uagb-image--effect-static wp-block-uagb-image--align-none wp-container-content-9cfa9a5a\"><figure class=\"wp-block-uagb-image__figure\"><img decoding=\"async\" srcset=\"http:\/\/jiushihema.github.io/pls_lab\/wp-content\/uploads\/2026\/03\/PixPin_2026-03-23_16-57-51.png ,http:\/\/jiushihema.github.io/pls_lab\/wp-content\/uploads\/2026\/03\/PixPin_2026-03-23_16-57-51.png 780w, http:\/\/jiushihema.github.io/pls_lab\/wp-content\/uploads\/2026\/03\/PixPin_2026-03-23_16-57-51.png 360w\" sizes=\"auto, (max-width: 480px) 150px\" src=\"http:\/\/jiushihema.github.io/pls_lab\/wp-content\/uploads\/2026\/03\/PixPin_2026-03-23_16-57-51.png\" alt=\"\" class=\"uag-image-1073\" width=\"802\" height=\"656\" title=\"PixPin_2026-03-23_16-57-51\" loading=\"lazy\" role=\"img\"\/><\/figure><\/div>\n<\/div>\n<\/div>\n\n\n\n<div class=\"wp-block-uagb-advanced-heading uagb-block-e3c2d50d lab-subheading\"><h3 class=\"uagb-heading-text\">\ud83d\udcdd \u5f15\u7528<\/h3><\/div>\n\n\n\n<pre class=\"wp-block-code lab-bibtex-code has-small-font-size\"><code>@article{li2024risjamming,\r\n  author    = {Guyue Li and Paul Staat and Haoyu Li and Markus Heinrichs and Christian Zenger and Rainer Kronberger and Harald Elders-Boll and Christof Paar and Aiqun Hu},\r\n  title     = {{RIS}-Jamming: Breaking Key Consistency in Channel Reciprocity-Based Key Generation},\r\n  journal   = {IEEE Transactions on Information Forensics and Security},\r\n  volume    = {19},\r\n  pages     = {5090--5105},\r\n  year      = {2024},\r\n  doi       = {10.1109\/TIFS.2024.3389569}\r\n}\r\n<\/code><\/pre>\n<\/div>\n\n\n\n<hr class=\"wp-block-separator has-alpha-channel-opacity is-style-wide\" style=\"margin-top:var(--wp--preset--spacing--20);margin-bottom:var(--wp--preset--spacing--20)\"\/>\n\n\n\n<div class=\"wp-block-group is-layout-flow wp-block-group-is-layout-flow\">\n<div style=\"height:100px\" aria-hidden=\"true\" class=\"wp-block-spacer\"><\/d