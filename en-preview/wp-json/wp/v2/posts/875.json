wp-element-button\" href=\"http:\/\/localhost:10011\/wp-content\/uploads\/2026\/03\/Real-World_Aircraft_Recognition_Based_on_RF_Fingerprinting_With_Few_Labeled_ADS-B_Signals.pdf\">\ud83d\udcc4 PDF<\/a><\/div>\n\n\n\n<div class=\"wp-block-button is-style-fill\"><a class=\"wp-block-button__link wp-element-button\" href=\"https:\/\/doi.org\/10.1109\/TVT.2023.3314491\" target=\"_blank\" rel=\"https:\/\/doi.org\/10.1109\/LWC.2023.3330809 noreferrer noopener\">\ud83d\udd17 DOI \u94fe\u63a5<\/a><\/div>\n<\/div>\n<\/div>\n\n\n\n<hr class=\"wp-block-separator has-text-color has-contrast-3-color has-alpha-channel-opacity has-contrast-3-background-color has-background is-style-wide\" style=\"margin-top:var(--wp--preset--spacing--20);margin-bottom:var(--wp--preset--spacing--20)\"\/>\n\n\n\n<div class=\"wp-block-group is-layout-flow wp-block-group-is-layout-flow\">\n<div class=\"wp-block-uagb-advanced-heading uagb-block-46005010 lab-subheading\"><h3 class=\"uagb-heading-text\">\ud83d\udccc \u6458\u8981<\/h3><\/div>\n\n\n\n<figure class=\"wp-block-pullquote has-text-align-left lab-abstract-quote has-small-font-size\" style=\"margin-right:var(--wp--preset--spacing--10);margin-left:var(--wp--preset--spacing--10);padding-top:0;padding-right:0;padding-bottom:0;padding-left:0\"><blockquote><p>\u81ea\u52a8\u76f8\u5173\u76d1\u89c6\u5e7f\u64ad\uff08ADS-B\uff09\u88ab\u89c6\u4e3a\u822a\u7a7a\u8fd0\u8f93\u7cfb\u7edf\u4e2d\u96f7\u8fbe\u7684\u66ff\u4ee3\u65b9\u6848\uff0c\u7136\u800c\u5176\u7f3a\u4e4f\u8ba4\u8bc1\u4e0e\u52a0\u5bc6\u673a\u5236\uff0c\u4f7f\u5176\u6613\u53d7\u653b\u51fb\u3002\u672c\u6587\u63d0\u51fa\u4e00\u79cd\u566a\u58f0\u9c81\u68d2\u7684\u5c04\u9891\u6307\u7eb9\u65b9\u6cd5\uff0c\u4ee5\u5e94\u5bf9\u5c0f\u6837\u672c\u6761\u4ef6\u4e0b\u7684\u5b9e\u9645\u98de\u673a\u8bc6\u522b\u573a\u666f\u3002\u6211\u4eec\u8bbe\u8ba1\u4e86\u4e00\u79cd\u901a\u8fc7\u5bf9\u65e0\u6548\u4fe1\u53f7\u8fdb\u884c\u96f6\u586b\u5145\u6765\u63d0\u5347\u566a\u58f0\u9c81\u68d2\u6027\u7684\u9884\u5904\u7406\u65b9\u6cd5\uff0c\u5e76\u91c7\u7528\u57fa\u4e8e\u5b6a\u751f\u7f51\u7edc\u7684\u5c0f\u6837\u672c\u8bad\u7ec3\u65b9\u6848\u8fdb\u884c RFF \u8bc6\u522b\u3002\u8be5\u65b9\u6cd5\u5728\u771f\u5b9e\u4e16\u754c ADS-B \u6570\u636e\u96c6\u4e0a\u8fdb\u884c\u8bc4\u4f30\uff0c\u7ed3\u679c\u8868\u660e\uff1a\u5728\u5c0f\u6837\u672c\u60c5\u51b5\u4e0b\uff0c\u4fe1\u53f7\u9884\u5904\u7406\u76f8\u6bd4\u76f4\u63a5\u4f7f\u7528\u539f\u59cb\u4fe1\u53f7\u53ef\u5c06\u98de\u673a\u8bc6\u522b\u51c6\u786e\u7387\u63d0\u5347\u7ea6 20%\uff1b\u5373\u4f7f\u4ec5\u4f7f\u7528\u6570\u5341\u4e2a\u6807\u6ce8\u6837\u672c\uff0c\u6240\u63d0\u65b9\u6cd5\u4e5f\u80fd\u8fbe\u5230\u8d85\u8fc7 90% \u7684\u8bc6\u522b\u51c6\u786e\u7387\uff0c\u8f83\u5176\u4ed6 CNN \u8bc6\u522b\u5668\u9ad8\u51fa 30% \u4ee5\u4e0a\u3002<\/p><\/blockquote><\/figure>\n\n\n\n<div class=\"wp-block-uagb-advanced-heading uagb-block-6adec98e lab-subheading\"><h3 class=\"uagb-heading-text\">\ud83d\udca1 \u6838\u5fc3\u8d21\u732e<\/h3><\/div>\n\n\n\n<ul start=\"1\" style=\"border-style:none;border-width:0px\" class=\"wp-block-list lab-feature-list\">\n<li class=\"lab-feature-list\"><strong>\u63d0\u51fa\u9762\u5411\u771f\u5b9e ADS-B \u573a\u666f\u7684\u566a\u58f0\u9c81\u68d2\u9884\u5904\u7406\u65b9\u6cd5<\/strong>\uff1a\u9488\u5bf9\u771f\u5b9e\u91c7\u96c6\u7684 ADS-B \u4fe1\u53f7\u4e2d\u5b58\u5728\u5927\u91cf\u65e0\u6548\u7247\u6bb5\uff08\u5982\u524d\u5bfc\u7801\u4e4b\u5916\u7684\u566a\u58f0\u6bb5\uff09\u7684\u95ee\u9898\uff0c\u8bbe\u8ba1\u4e86\u57fa\u4e8e\u96f6\u586b\u5145\u7684\u4fe1\u53f7\u9884\u5904\u7406\u6d41\u7a0b\uff0c\u6709\u6548\u5c4f\u853d\u65e0\u6548\u4fe1\u53f7\u5e72\u6270\uff0c\u663e\u8457\u63d0\u5347\u6a21\u578b\u5728\u4f4e SNR \u6761\u4ef6\u4e0b\u7684\u9c81\u68d2\u6027\u3002<\/li>\n\n\n\n<li class=\"lab-feature-list\"><strong>\u5c06\u5b6a\u751f\u7f51\u7edc\u5f15\u5165 ADS-B \u5c04\u9891\u6307\u7eb9\u8bc6\u522b\u7684\u5c0f\u6837\u672c\u5b66\u4e60\u6846\u67b6<\/strong>\uff1a\u6784\u5efa\u4e86\u57fa\u4e8e\u5b6a\u751f\u7f51\u7edc\u7684\u5ea6\u91cf\u5b66\u4e60\u65b9\u6848\uff0c\u901a\u8fc7\u5b66\u4e60\u6837\u672c\u5bf9\u4e4b\u95f4\u7684\u76f8\u4f3c\u6027\u800c\u975e\u76f4\u63a5\u5206\u7c7b\uff0c\u4f7f\u6a21\u578b\u80fd\u591f\u5728\u6bcf\u7c7b\u4ec5\u6709\u6570\u5341\u4e2a\u6807\u6ce8\u6837\u672c\u7684\u6781\u7aef\u5c0f\u6837\u672c\u6761\u4ef6\u4e0b\u5b8c\u6210\u98de\u673a\u8eab\u4efd\u8bc6\u522b\uff0c\u89e3\u51b3\u4e86\u4f20\u7edf CNN \u65b9\u6cd5\u5bf9\u5927\u91cf\u6807\u6ce8\u6570\u636e\u7684\u4f9d\u8d56\u95ee\u9898\u3002<\/li>\n\n\n\n<li class=\"lab-feature-list\"><strong>\u5728\u771f\u5b9e\u4e16\u754c\u6570\u636e\u96c6\u4e0a\u5b9e\u73b0\u4e86\u5bf9\u73b0\u6709\u65b9\u6cd5\u7684\u5168\u9762\u8d85\u8d8a<\/strong>\uff1a\u5728\u771f\u5b9e\u91c7\u96c6\u7684\u5927\u89c4\u6a21 ADS-B \u6570\u636e\u96c6\u4e0a\u8fdb\u884c\u7cfb\u7edf\u8bc4\u4f30\uff0c\u6240\u63d0\u65b9\u6cd5\u5728\u5c0f\u6837\u672c\u6761\u4ef6\u4e0b\u8bc6\u522b\u51c6\u786e\u7387\u8d85\u8fc7 90%\uff0c\u76f8\u8f83\u5176\u4ed6 CNN \u57fa\u7ebf\u65b9\u6cd5\u63d0\u5347\u8d85\u8fc7 30%\uff0c\u9a8c\u8bc1\u4e86\u65b9\u6cd5\u5728\u5b9e\u9645\u90e8\u7f72\u573a\u666f\u4e2d\u7684\u53ef\u884c\u6027\u4e0e\u4f18\u8d8a\u6027\u3002<\/li>\n<\/ul>\n\n\n\n<div class=\"wp-block-uagb-advanced-heading uagb-block-2f9d57f4 lab-subheading\"><h3 class=\"uagb-heading-text\">\ud83d\udd27 \u65b9\u6cd5\u6982\u89c8<\/h3><\/div>\n\n\n\n<div class=\"wp-block-group lab-paper-results is-nowrap is-layout-flex wp-container-core-group-is-layout-3a88641f wp-block-group-is-layout-flex\">\n<div class=\"wp-block-uagb-image uagb-block-b46d2053 wp-block-uagb-image--layout-default wp-block-uagb-image--effect-static wp-block-uagb-image--align-none wp-container-content-9cfa9a5a\"><figure class=\"wp-block-uagb-image__figure\"><img decoding=\"async\" srcset=\"http:\/\/localhost:10011\/wp-content\/uploads\/2026\/01\/8ee4ceaf-a5d5-4001-a35c-4dd5a7a5a83a.png ,http:\/\/localhost:10011\/wp-content\/uploads\/2026\/01\/8ee4ceaf-a5d5-4001-a35c-4dd5a7a5a83a.png 780w, http:\/\/localhost:10011\/wp-content\/uploads\/2026\/01\/8ee4ceaf-a5d5-4001-a35c-4dd5a7a5a83a.png 360w\" sizes=\"auto, (max-width: 480px) 150px\" src=\"http:\/\/localhost:10011\/wp-content\/uploads\/2026\/01\/8ee4ceaf-a5d5-4001-a35c-4dd5a7a5a83a.png\" alt=\"\" class=\"uag-image-428\" width=\"802\" height=\"656\" title=\"8ee4ceaf-a5d5-4001-a35c-4dd5a7a5a83a\" loading=\"lazy\" role=\"img\"\/><\/figure><\/div>\n\n\n\n<div class=\"wp-block-group is-vertical is-layout-flex wp-container-core-group-is-layout-831b2db5 wp-block-group-is-layout-flex\">\n<p class=\"lab-experiment-caption has-medium-font-size wp-block-paragraph\">\u672c\u6587\u63d0\u51fa\u7684 RFF \u8bc6\u522b\u6846\u67b6\u7531\u4e24\u4e2a\u6838\u5fc3\u6a21\u5757\u4e32\u8054\u6784\u6210\u3002<strong>\u7b2c\u4e00\u9636\u6bb5<\/strong>\uff0c\u539f\u59cb I\/Q \u4fe1\u53f7\u7ecf\u96f6\u586b\u5145\uff08ZP\uff09\u9884\u5904\u7406\u7b97\u6cd5\u5904\u7406\uff0c\u901a\u8fc7\u7c97\u540c\u6b65\u4e0e\u7cbe\u540c\u6b65\u5b9a\u4f4d\u6709\u6548\u8109\u51b2\u533a\u95f4\uff0c\u6ee4\u9664\u4f4e\u7535\u5e73\u566a\u58f0\u6bb5\u5e76\u91cd\u5efa\u4fe1\u53f7\uff0c\u663e\u8457\u63d0\u5347\u4fe1\u53f7\u8d28\u91cf\u3002<strong>\u7b2c\u4e8c\u9636\u6bb5<\/strong>\uff0c\u9884\u5904\u7406\u540e\u7684\u4fe1\u53f7\u8fdb\u5165\u4e24\u9636\u6bb5\u5b6a\u751f\u7f51\u7edc\u8bad\u7ec3\u65b9\u6848\uff1a\u9996\u5148\u4ee5\u4fe1\u53f7\u5bf9\u4e3a\u8f93\u5165\u8bad\u7ec3\u5b6a\u751f\u7f51\u7edc\u83b7\u5f97 RFF \u7279\u5f81\u63d0\u53d6\u5668\uff0c\u518d\u7ed3\u5408 MLP \u5206\u7c7b\u5668\u8fdb\u884c\u5fae\u8c03\uff0c\u6700\u7ec8\u8f93\u51fa\u98de\u673a\u8eab\u4efd\u8bc6\u522b\u7ed3\u679c\u3002<\/p>\n<\/div>\n<\/div>\n\n\n\n<div class=\"wp-block-uagb-advanced-heading uagb-block-dda34f26 lab-subheading\"><h3 class=\"uagb-heading-text\">\ud83d\udcca \u5b9e\u9a8c\u7ed3\u679c<\/h3><\/div>\n\n\n\n<div class=\"wp-block-group lab-paper-results is-nowrap is-layout-flex wp-container-core-group-is-layout-3a88641f wp-block-group-is-layout-flex\">\n<div class=\"wp-block-uagb-image uagb-block-080de2b0 wp-block-uagb-image--layout-default wp-block-uagb-image--effect-static wp-block-uagb-image--align-none wp-container-content-9cfa9a5a\"><figure class=\"wp-block-uagb-image__figure\"><img decoding=\"async\" srcset=\"http:\/\/localhost:10011\/wp-content\/uploads\/2026\/03\/a3d420dd59e4354d91145054e2ab4ef2.png ,http:\/\/localhost:10011\/wp-content\/uploads\/2026\/03\/a3d420dd59e4354d91145054e2ab4ef2.png 780w, http:\/\/localhost:10011\/wp-content\/uploads\/2026\/03\/a3d420dd59e4354d91145054e2ab4ef2.png 360w\" sizes=\"auto, (max-width: 480px) 150px\" src=\"http:\/\/localhost:10011\/wp-content\/uploads\/2026\/03\/a3d420dd59e4354d91145054e2ab4ef2.png\" alt=\"\" class=\"uag-image-876\" width=\"802\" height=\"656\" title=\"a3d420dd59e4354d91145054e2ab4ef2\" loading=\"lazy\" role=\"img\"\/><\/figure><\/div>\n\n\n\n<div class=\"wp-block-group is-vertical is-layout-flex wp-container-core-group-is-layout-831b2db5 wp-block-group-is-layout-flex\">\n<p class=\"lab-experiment-caption has-medium-font-size wp-block-paragraph\">\u5b9e\u9a8c\u5728\u771f\u5b9e\u91c7\u96c6\u7684 ADS-B \u6570\u636e\u96c6\uff08198 \u7c7b\u3001\u5171 1300 \u4e07\u6837\u672c\uff09\u4e0a\u8fdb\u884c\u8bc4\u4f30\u3002\u7ed3\u679c\u8868\u660e\uff0cZP \u9884\u5904\u7406\u5728\u6bcf\u7c7b\u4ec5 10 \u4e2a\u6837\u672c\u65f6\u53ef\u5e26\u6765\u8d85\u8fc7 20% \u7684\u51c6\u786e\u7387\u63d0\u5347\uff0c\u4e14\u6837\u672c\u8d8a\u5c11\u589e\u76ca\u8d8a\u663e\u8457\u3002\u6240\u63d0\u5b6a\u751f\u7f51\u7edc\u65b9\u6848\u5728\u4efb\u610f\u6837\u672c\u89c4\u6a21\u4e0b\u5747\u4f18\u4e8e CNN\u3001DRCN\u3001QGAN \u7b49\u57fa\u7ebf\u65b9\u6cd5\uff0c\u4ec5\u51ed\u6570\u5341\u4e2a\u6807\u6ce8\u6837\u672c\u5373\u53ef\u8fbe\u5230\u7ea6 90% \u7684\u8bc6\u522b\u51c6\u786e\u7387\u3002\u6b64\u5916\uff0cSiamese + MLP \u7ec4\u5408\u7684\u63a8\u7406\u901f\u5ea6\u7ea6\u4e3a Siamese + KNN \u7684 7 \u500d\uff0c\u66f4\u9002\u5408\u5b9e\u65f6\u90e8\u7f72\u573a\u666f\u3002<\/p>\n<\/div>\n<\/div>\n\n\n\n<div class=\"wp-block-uagb-advanced-heading uagb-block-e3c2d50d lab-subheading\"><h3 class=\"uagb-heading-text\">\ud83d\udcdd \u5f15\u7528<\/h3><\/div>\n\n\n\n<pre class=\"wp-block-code lab-bibtex-code has-small-font-size\"><code>@article{zhang2024realworld,\n  author    = {Zechen Zhang and Guyue Li and Jitong Shi and Haobo Li and Aiqun Hu},\n  title     = {Real-World Aircraft Recognition Based on {RF} Fingerprinting With Few Labeled {ADS-B} Signals},\n  journal   = {IEEE Transactions on Vehicular Technology},\n  volume    = {73},\n  number    = {2},\n  pages     = {2866--2871},\n  month     = feb,\n  year      = {2024},\n  doi       = {10.1109\/TVT.2023.3314491}\n}\n<\/code><\/pre>\n<\/div>\n\n\n\n<hr class=\"wp-block-separator has-alpha-channel-opacity is-style-wide\" style=\"margin-top:var(--wp--preset--spacing--20);margin-bottom:var(--wp--preset--spacing--20)\"\/>\n\n\n\n<div class=\"wp-block-group is-layout-flow wp-block-group-is-layout-flow\">\n<div style=\"height:100px\" aria-hidden=\"true\" class=\"wp-block-spacer\"><\/div>\n\n\n\n<div class=\"wp-block-group is-content-justification-space-between is-nowrap is-layout-flex wp-container-core-group-is-layout-788841da wp-block-group-is-layout-flex\">\n\n<\/div>\n<\/div>\n<\/div>\n","protected":false},"excerpt":{"rendered":"<p>\u5728\u771f\u5b9e\u822a\u7a7a\u73af\u5883\u4e2d\uff0c\u83b7\u53d6\u5927\u91cf\u6709\u6807\u7b7e\u7684\u98de\u673a ADS-B \u4fe1\u53f7\u6781\u5176\u56f0\u96be\uff0c\u4e14\u4fe1\u53f7\u5e38\u53d7\u5f3a\u566a\u58f0\u5e72\u6270\u3002\u9488\u5bf9\u8fd9\u4e00\u201c\u5c0f\u6837\u672c\u201d\u96be\u9898\uff0c\u672c\u8bfe\u9898\u7ec4\u63d0\u51fa\u4e86\u4e00\u79cd\u7ed3\u5408\u8865\u96f6\uff08ZP\uff09\u9884\u5904\u7406\u4e0e\u5b6a\u751f\u7f51\u7edc\uff08Siamese Network\uff09\u7684\u5c04\u9891\u6307\u7eb9\u8bc6\u522b\u65b0\u6846\u67b6\u3002\u8be5\u65b9\u6cd5\u901a\u8fc7\u6743\u503c\u5171\u4eab\u548c\u4e24\u9636\u6bb5\u8bad\u7ec3\u7b56\u7565\uff0c\u6709\u6548\u89e3\u51b3\u4e86\u8fc7\u62df\u5408\u95ee\u9898\uff0c\u5728\u5c11\u91cf\u6807\u7b7e\u6