{"id":432,"date":"2026-01-29T10:51:20","date_gmt":"2026-01-29T10:51:20","guid":{"rendered":"http:\/\/localhost:10005\/?p=432"},"modified":"2026-01-29T10:55:18","modified_gmt":"2026-01-29T10:55:18","slug":"few-shot-ads-b-rff-constellation-density-map","status":"publish","type":"post","link":"http:\/\/localhost:10005\/few-shot-ads-b-rff-constellation-density-map\/","title":{"rendered":"\u57fa\u4e8e\u661f\u5ea7\u5bc6\u5ea6\u56fe\u7684ADS-B\u4fe1\u53f7\u6307\u7eb9\u5728\u7ebf\u8bc6\u522b"},"content":{"rendered":"\n<h3 class=\"wp-block-heading\">\u7814\u7a76\u80cc\u666f<\/h3>\n\n\n\n<p>\u5728\u5b9e\u9645\u7684ADS-B\u4fe1\u53f7\u76d1\u6d4b\u4e2d\uff0c\u6211\u4eec\u9762\u4e34\u7740\u6781\u7aef\u7684\u6570\u636e\u6311\u6218\uff1a<\/p>\n\n\n\n<ol start=\"1\" class=\"wp-block-list\">\n<li><strong>\u6837\u672c\u6781\u5176\u7f3a\u4e4f\uff1a<\/strong> \u5408\u6cd5\u8bbe\u5907\u7684\u4fe1\u53f7\u6837\u672c\u5f80\u5f80\u5f88\u5c11\uff0c\u6709\u65f6\u751a\u81f3\u53ea\u6709\u4e2a\u4f4d\u6570\uff08Single-digit level\uff09\u3002<\/li>\n\n\n\n<li><strong>\u52a8\u6001\u6027\u5f3a\uff1a<\/strong> \u7ecf\u5e38\u6709\u65b0\u7684\u98de\u673a\u8fdb\u5165\u7a7a\u57df\uff0c\u7cfb\u7edf\u9700\u8981\u5177\u5907\u5feb\u901f\u201c\u8ba4\u8bc6\u201d\u65b0\u8bbe\u5907\u7684\u80fd\u529b\uff08\u5373\u5728\u7ebf\u767b\u8bb0\uff09\uff0c\u800c\u4f20\u7edf\u7684\u6df1\u5ea6\u5b66\u4e60\u6a21\u578b\u96be\u4ee5\u5728\u4e0d\u91cd\u65b0\u8bad\u7ec3\u7684\u60c5\u51b5\u4e0b\u9002\u5e94\u65b0\u7c7b\u522b\u3002<\/li>\n<\/ol>\n\n\n\n<h3 class=\"wp-block-heading\">\u6838\u5fc3\u67b6\u6784<\/h3>\n\n\n\n<figure class=\"wp-block-image size-full\"><img loading=\"lazy\" decoding=\"async\" width=\"780\" height=\"533\" src=\"http:\/\/localhost:10005\/wp-content\/uploads\/2026\/01\/d2655296-46eb-422f-82d1-9443093d9a1b.png\" alt=\"\" class=\"wp-image-433\" srcset=\"http:\/\/localhost:10005\/wp-content\/uploads\/2026\/01\/d2655296-46eb-422f-82d1-9443093d9a1b.png 780w, http:\/\/localhost:10005\/wp-content\/uploads\/2026\/01\/d2655296-46eb-422f-82d1-9443093d9a1b-300x205.png 300w, http:\/\/localhost:10005\/wp-content\/uploads\/2026\/01\/d2655296-46eb-422f-82d1-9443093d9a1b-768x525.png 768w\" sizes=\"auto, (max-width: 780px) 100vw, 780px\" \/><\/figure>\n\n\n\n<p>\u4e3a\u4e86\u89e3\u51b3\u4e0a\u8ff0\u95ee\u9898\uff0c\u6211\u4eec\u8bbe\u8ba1\u4e86\u4e00\u5957\u5305\u542b\u4e09\u4e2a\u9636\u6bb5\u7684\u8bc6\u522b\u7cfb\u7edf\uff08\u5982\u56fe1\uff09\uff1a<\/p>\n\n\n\n<ol start=\"1\" class=\"wp-block-list\">\n<li><strong>\u79bb\u7ebf\u8bad\u7ec3\uff08Offline Training\uff09\uff1a<\/strong> \u5229\u7528\u5df2\u6709\u7684\u79bb\u7ebf\u8bbe\u5907\u6570\u636e\uff0c\u5c06\u4fe1\u53f7\u8f6c\u6362\u4e3a <strong>\u661f\u5ea7\u5bc6\u5ea6\u56fe<\/strong>\uff0c\u8bad\u7ec3\u7279\u5f81\u63d0\u53d6\u7f51\u7edc\uff0c\u4f7f\u5176\u5b66\u4f1a\u63d0\u53d6\u5177\u6709\u8fa8\u522b\u529b\u7684\u6307\u7eb9\u7279\u5f81\u3002<\/li>\n\n\n\n<li><strong>\u5728\u7ebf\u767b\u8bb0\uff08Online Registration\uff09\uff1a<\/strong> \u5f53\u65b0\u8bbe\u5907\uff08\u5982\u8bf7\u6c42\u767b\u8bb0\u7684\u98de\u673a\uff09\u51fa\u73b0\u65f6\uff0c\u7cfb\u7edf\u4ec5\u9700\u5c11\u91cf\u6837\u672c\u5373\u53ef\u63d0\u53d6\u5176\u7279\u5f81\uff0c\u5e76\u5c06\u5176\u5b58\u5165\u201c\u5c04\u9891\u6307\u7eb9\u6307\u7eb9\u5e93\u201d\uff0c\u5b8c\u6210\u6ce8\u518c\u3002<\/li>\n\n\n\n<li><strong>\u5728\u7ebf\u8bc6\u522b\uff08Online Identification\uff09\uff1a<\/strong> \u7cfb\u7edf\u5b9e\u65f6\u91c7\u96c6\u4fe1\u53f7\uff0c\u4e0e\u6307\u7eb9\u5e93\u4e2d\u7684\u7279\u5f81\u6bd4\u5bf9\uff0c\u5feb\u901f\u5224\u65ad\u8bbe\u5907\u662f\u201c\u5408\u6cd5\u7528\u6237\u201d\u8fd8\u662f\u201c\u975e\u6cd5\u653b\u51fb\u8005\u201d\u3002<\/li>\n<\/ol>\n\n\n\n<h3 class=\"wp-block-heading\">\u661f\u5ea7\u5bc6\u5ea6\u56fe + \u5b6a\u751f\u7f51\u7edc<\/h3>\n\n\n\n<div class=\"wp-block-group is-nowrap is-layout-flex wp-container-core-group-is-layout-6c531013 wp-block-group-is-layout-flex\">\n<figure class=\"wp-block-image size-full\"><img loading=\"lazy\" decoding=\"async\" width=\"505\" height=\"260\" src=\"http:\/\/localhost:10005\/wp-content\/uploads\/2026\/01\/3d3c45af-5b66-4451-ba45-e8fe6bf44a18.png\" alt=\"\" class=\"wp-image-436\" srcset=\"http:\/\/localhost:10005\/wp-content\/uploads\/2026\/01\/3d3c45af-5b66-4451-ba45-e8fe6bf44a18.png 505w, http:\/\/localhost:10005\/wp-content\/uploads\/2026\/01\/3d3c45af-5b66-4451-ba45-e8fe6bf44a18-300x154.png 300w\" sizes=\"auto, (max-width: 505px) 100vw, 505px\" \/><\/figure>\n\n\n\n<figure class=\"wp-block-image size-full\"><img loading=\"lazy\" decoding=\"async\" width=\"252\" height=\"763\" src=\"http:\/\/localhost:10005\/wp-content\/uploads\/2026\/01\/image.png\" alt=\"\" class=\"wp-image-437\" srcset=\"http:\/\/localhost:10005\/wp-content\/uploads\/2026\/01\/image.png 252w, http:\/\/localhost:10005\/wp-content\/uploads\/2026\/01\/image-99x300.png 99w\" sizes=\"auto, (max-width: 252px) 100vw, 252px\" \/><\/figure>\n<\/div>\n\n\n\n<p>\u4e3a\u4e86\u5728\u6781\u5c0f\u6837\u672c\u4e0b\u63d0\u9ad8\u8bc6\u522b\u51c6\u786e\u7387\uff0c\u6211\u4eec\u5f15\u5165\u4e86\u4e24\u9879\u5173\u952e\u6280\u672f\uff1a<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li><strong>\u7279\u5f81\u964d\u566a\uff1a<\/strong> \u4e0d\u540c\u4e8e\u76f4\u63a5\u5904\u7406\u539f\u59cb\u6ce2\u5f62\uff0c\u6211\u4eec\u63d0\u53d6\u4fe1\u53f7\u7684 <strong>\u661f\u5ea7\u5bc6\u5ea6\u56fe\uff08Constellation Density Map\uff09<\/strong> \u4f5c\u4e3a\u7f51\u7edc\u8f93\u5165\u3002\u8fd9\u79cd\u56fe\u50cf\u5316\u7684\u7279\u5f81\u80fd\u6709\u6548\u6291\u5236\u73af\u5883\u566a\u58f0\uff0c\u7a81\u51fa\u8c03\u5236\u4fe1\u53f7\u7684\u7edf\u8ba1\u89c4\u5f8b\u3002<\/li>\n\n\n\n<li><strong>\u5dee\u5f02\u5b66\u4e60\uff1a<\/strong> \u91c7\u7528 <strong>\u5b6a\u751f\u7f51\u7edc\uff08Siamese Network\uff09<\/strong> \u67b6\u6784\uff08\u5982\u56fe2\u5de6\u56fe\uff09\u3002\u7f51\u7edc\u5305\u542b\u4e24\u4e2a\u5171\u4eab\u6743\u91cd\u7684 CNN \u5206\u652f\uff08\u56fe2\u53f3\u56fe\u4e3a CNN \u7ec6\u8282\uff09\uff0c\u901a\u8fc7\u8ba1\u7b97\u4e24\u4e2a\u8f93\u5165\u6837\u672c\u7279\u5f81\u5411\u91cf\u7684\u6b27\u6c0f\u8ddd\u79bb\uff0c\u5b66\u4e60\u201c\u540c\u7c7b\u201d\u4e0e\u201c\u4e0d\u540c\u7c7b\u201d\u4e4b\u95f4\u7684\u5dee\u5f02\u3002\u8fd9\u79cd\u673a\u5236\u5229\u7528\u4e86\u5148\u9a8c\u4fe1\u606f\uff0c\u6781\u5927\u7f13\u89e3\u4e86\u5c0f\u6837\u672c\u5bfc\u81f4\u7684\u8fc7\u62df\u5408\u95ee\u9898\u3002<\/li>\n<\/ul>\n\n\n\n<h2 class=\"wp-block-heading\">\u603b\u7ed3<\/h2>\n\n\n\n<p>\u672c\u7814\u7a76\u63d0\u51fa\u4e86\u4e00\u79cd\u5b9e\u7528\u7684 ADS-B \u5c04\u9891\u6307\u7eb9\u8bc6\u522b\u65b9\u6848\uff0c\u901a\u8fc7\u201c\u661f\u5ea7\u5bc6\u5ea6\u56fe\u201d\u589e\u5f3a\u7279\u5f81\u9c81\u68d2\u6027\uff0c\u5229\u7528\u201c\u5b6a\u751f\u7f51\u7edc\u201d\u89e3\u51b3\u5c0f\u6837\u672c\u96be\u9898\uff0c\u5e76\u6784\u5efa\u4e86\u5b8c\u6574\u7684\u5728\u7ebf\u5e94\u7528\u6d41\u7a0b\u3002\u5b9e\u9a8c\u8868\u660e\uff0c\u5373\u4f7f\u5728\u5404\u8bbe\u5907\u6837\u672c\u6570\u91cf\u6781\u5c11\uff08\u4e2a\u4f4d\u7ea7\u522b\uff09\u7684\u6781\u7aef\u6761\u4ef6\u4e0b\uff0c\u8be5\u65b9\u6cd5\u4f9d\u7136\u80fd\u4fdd\u6301\u8f83\u9ad8\u7684\u8bc6\u522b\u51c6\u786e\u7387\u3002<\/p>\n","protected":false},"excerpt":{"rendered":"<p>\u9488\u5bf9\u822a\u7a7a\u5b89\u5168\u4e2dADS-B\u4fe1\u53f7\u6837\u672c\u6781\u5176\u532e\u4e4f\uff08\u751a\u81f3\u4e2a\u4f4d\u7ea7\u522b\uff09\u7684\u96be\u9898\uff0c\u672c\u8bfe\u9898\u7ec4\u63d0\u51fa\u4e86\u4e00\u79cd\u57fa\u4e8e \u661f\u5ea7\u5bc6\u5ea6\u56fe \u4e0e \u5b6a\u751f\u7f51\u7edc \u7684\u5c04\u9891\u6307\u7eb9\u8bc6\u522b\u65b0\u6846\u67b6\u3002\u8be5\u65b9\u6848\u4e0d\u4ec5\u5229\u7528\u661f\u5ea7\u56fe\u7279\u5f81\u89e3\u51b3\u4e86\u4f4e\u4fe1\u566a\u6bd4\u5e72\u6270\uff0c\u8fd8\u521b\u65b0\u6027\u5730\u8bbe\u8ba1\u4e86\u201c\u79bb\u7ebf\u8bad\u7ec3+\u5728\u7ebf\u767b\u8bb0\u201d\u673a\u5236\uff0c\u5b9e\u73b0\u4e86\u5bf9\u65b0\u63a5\u5165\u8bbe\u5907\u7684\u5feb\u901f\u5b66\u4e60\u4e0e\u7cbe\u51c6\u8bc6\u522b\u3002<\/p>\n","protected":false},"author":1,"featured_media":433,"co