{"id":405,"date":"2026-01-27T12:29:40","date_gmt":"2026-01-27T12:29:40","guid":{"rendered":"http:\/\/plslab.local\/?p=405"},"modified":"2026-01-27T12:39:39","modified_gmt":"2026-01-27T12:39:39","slug":"malicious-ris-secret-key-acquisition-attack-defense","status":"publish","type":"post","link":"http:\/\/plslab.local\/malicious-ris-secret-key-acquisition-attack-defense\/","title":{"rendered":"\u57fa\u4e8e\u6076\u610fRIS\u7684\u5bc6\u94a5\u7a83\u53d6\u653b\u51fb\u4e0e\u9632\u5fa1\u7b56\u7565"},"content":{"rendered":"\n<h3 class=\"wp-block-heading\">\u7814\u7a76\u80cc\u666f<\/h3>\n\n\n\n<p>\u5728\u7269\u7406\u5c42\u5b89\u5168\u7814\u7a76\u4e2d\uff0c\u6211\u4eec\u901a\u5e38\u5229\u7528 RIS \u6765\u589e\u5f3a\u5408\u6cd5\u7528\u6237\u7684\u4fe1\u9053\u8d28\u91cf\u3002\u7136\u800c\uff0c\u5982\u679c RIS \u88ab\u6076\u610f\u653b\u51fb\u8005\u63a7\u5236\uff08Malicious RIS\uff09\uff0c\u5b83\u5c06\u5bf9\u7cfb\u7edf\u7684\u5b89\u5168\u6027\u6784\u6210\u4e25\u91cd\u5a01\u80c1\u3002\u672c\u7814\u7a76\u63a2\u8ba8\u4e86\u4e00\u79cd\u9690\u853d\u6027\u6781\u5f3a\u7684\u4e3b\u52a8\u653b\u51fb\u65b9\u5f0f\uff1a\u6076\u610f RIS \u5982\u4f55\u5728\u4e0d\u5f15\u8d77\u5408\u6cd5\u7528\u6237\u8b66\u89c9\u7684\u60c5\u51b5\u4e0b\uff0c\u7a83\u53d6\u7269\u7406\u5c42\u5bc6\u94a5\u3002<\/p>\n\n\n\n<h3 class=\"wp-block-heading\">\u653b\u51fb\u539f\u7406<\/h3>\n\n\n\n<div class=\"wp-block-group is-nowrap is-layout-flex wp-container-core-group-is-layout-6c531013 wp-block-group-is-layout-flex\">\n<figure class=\"wp-block-image size-full\"><img loading=\"lazy\" decoding=\"async\" width=\"1011\" height=\"517\" src=\"http:\/\/plslab.local\/wp-content\/uploads\/2026\/01\/572bf1ac-6203-4e2d-b273-a1f55259ddfa.png\" alt=\"\" class=\"wp-image-406\" srcset=\"http:\/\/plslab.local\/wp-content\/uploads\/2026\/01\/572bf1ac-6203-4e2d-b273-a1f55259ddfa.png 1011w, http:\/\/plslab.local\/wp-content\/uploads\/2026\/01\/572bf1ac-6203-4e2d-b273-a1f55259ddfa-300x153.png 300w, http:\/\/plslab.local\/wp-content\/uploads\/2026\/01\/572bf1ac-6203-4e2d-b273-a1f55259ddfa-768x393.png 768w\" sizes=\"auto, (max-width: 1011px) 100vw, 1011px\" \/><\/figure>\n\n\n\n<div class=\"wp-block-group is-vertical is-layout-flex wp-container-core-group-is-layout-fe9cc265 wp-block-group-is-layout-flex\">\n<h5 class=\"wp-block-heading\">\u5982\u56fe1\u6240\u793a\uff0cEve \u5229\u7528\u6076\u610f RIS \u5bf9 Alice \u548c Bob \u4e4b\u95f4\u7684\u4fe1\u9053\u8fdb\u884c\u64cd\u63a7\u3002<\/h5>\n\n\n\n<ul class=\"wp-block-list\">\n<li><strong>\u653b\u51fb\u7b56\u7565\uff1a<\/strong> \u5728\u5947\u6570\u8f6e\u548c\u5076\u6570\u8f6e\u4fe1\u9053\u63a2\u6d4b\u4e2d\uff0cRIS \u5206\u522b\u5c06\u6240\u6709\u53cd\u5c04\u7cfb\u6570\u8bbe\u7f6e\u4e3a 0 \u548c 1\u3002<\/li>\n\n\n\n<li><strong>\u653b\u51fb\u6548\u679c\uff1a<\/strong> \u8fd9\u79cd\u5468\u671f\u6027\u7684\u8c03\u63a7\u4f1a\u5bfc\u81f4\u5408\u6cd5\u7528\u6237\u7684\u63a5\u6536\u4fe1\u53f7\u5f3a\u5ea6\uff08RSS\uff09\u51fa\u73b0\u5468\u671f\u6027\u7684\u589e\u5f3a\u548c\u51cf\u5f31\uff0c\u4ece\u800c\u4f7f\u751f\u6210\u7684\u5bc6\u94a5\u6bd4\u7279\u5448\u73b0\u51fa\u201c0\u30011\u201d\u4ea4\u66ff\u7684\u89c4\u5f8b\u3002<\/li>\n\n\n\n<li><strong>\u9690\u853d\u6027\uff1a<\/strong> \u8be5\u653b\u51fb\u7684\u5173\u952e\u5728\u4e8e\uff0c\u5b83<strong>\u4e0d\u7834\u574f\u5bc6\u94a5\u7684\u4e00\u81f4\u6027<\/strong>\uff0c\u4f7f\u5f97 Alice \u548c Bob \u96be\u4ee5\u5bdf\u89c9\u5f02\u5e38\u3002<\/li>\n<\/ul>\n<\/div>\n<\/div>\n\n\n\n<h3 class=\"wp-block-heading\">\u9632\u5fa1\u7b56\u7565<\/h3>\n\n\n\n<p>\u4e3a\u4e86\u62b5\u5fa1\u8fd9\u79cd\u653b\u51fb\uff0c\u6211\u4eec\u63d0\u51fa\u4e86\u4e00\u79cd**\u57fa\u4e8e\u52a8\u6001\u79c1\u6709\u5bfc\u9891\uff08Channel-based Dynamic Private Pilot, CDPP\uff09**\u7684\u9632\u5fa1\u65b9\u6cd5\u3002<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li><strong>\u6838\u5fc3\u601d\u60f3\uff1a<\/strong> \u901a\u8fc7\u589e\u52a0\u4fe1\u9053\u7684\u52a8\u6001\u53d8\u5316\uff0c\u51cf\u8f7b RIS \u5bf9\u4fe1\u9053\u7684\u63a7\u5236\u4f5c\u7528\u3002<\/li>\n\n\n\n<li><strong>\u5177\u4f53\u6b65\u9aa4\uff1a<\/strong>\n<ol start=\"1\" class=\"wp-block-list\">\n<li><strong>\u4e0b\u884c\u63a2\u6d4b\uff1a<\/strong> Alice \u53d1\u9001\u7684\u63a2\u6d4b\u4fe1\u53f7\u662f\u5bfc\u9891\u4e0e\u4eba\u5de5\u968f\u673a\u7cfb\u6570 $w$ \u7684\u4e58\u79ef\u3002<\/li>\n\n\n\n<li><strong>\u4e0a\u884c\u63a2\u6d4b\uff1a<\/strong> Bob \u53d1\u9001\u5bfc\u9891\uff0cAlice \u5c06\u63a5\u6536\u4fe1\u53f7\u4e0e\u968f\u673a\u7cfb\u6570 $w$ \u76f8\u4e58\u5f97\u5230\u7ed3\u679c\u3002\u901a\u8fc7\u5f15\u5165\u968f\u673a\u7cfb\u6570 $w$\uff0c\u4fe1\u9053\u7684\u53d8\u5316\u4e0d\u518d\u4ec5\u53d6\u51b3\u4e8e RIS \u7684\u53cd\u5c04\u77e9\u9635\uff0c\u4ece\u800c\u5927\u5e45\u964d\u4f4e\u4e86\u653b\u51fb\u7684\u6210\u529f\u7387\u3002<\/li>\n<\/ol>\n<\/li>\n<\/ul>\n\n\n\n<h3 class=\"wp-block-heading\">\u4eff\u771f\u9a8c\u8bc1<\/h3>\n\n\n\n<div class=\"wp-block-group is-nowrap is-layout-flex wp-container-core-group-is-layout-6c531013 wp-block-group-is-layout-flex\">\n<figure class=\"wp-block-image size-full\"><img loading=\"lazy\" decoding=\"async\" width=\"855\" height=\"645\" src=\"http:\/\/plslab.local\/wp-content\/uploads\/2026\/01\/d8db44c2-ca15-4cc6-8b90-0fc58bd5d2a5.png\" alt=\"\" class=\"wp-image-409\" srcset=\"http:\/\/plslab.local\/wp-content\/uploads\/2026\/01\/d8db44c2-ca15-4cc6-8b90-0fc58bd5d2a5.png 855w, http:\/\/plslab.local\/wp-content\/uploads\/2026\/01\/d8db44c2-ca15-4cc6-8b90-0fc58bd5d2a5-300x226.png 300w, http:\/\/plslab.local\/wp-content\/uploads\/2026\/01\/d8db44c2-ca15-4cc6-8b90-0fc58bd5d2a5-768x579.png 768w\" sizes=\"auto, (max-width: 855px) 100vw, 855px\" \/><\/figure>\n\n\n\n<figure class=\"wp-block-image size-full\"><img loading=\"lazy\" decoding=\"async\" width=\"802\" height=\"629\" src=\"http:\/\/plslab.local\/wp-content\/uploads\/2026\/01\/f19de013-d686-4ba2-8884-8612f356951e.png\" alt=\"\" class=\"wp-image-410\" srcset=\"http:\/\/plslab.local\/wp-content\/uploads\/2026\/01\/f19de013-d686-4ba2-8884-8612f356951e.png 802w, http:\/\/plslab.local\/wp-content\/uploads\/2026\/01\/f19de013-d686-4ba2-8884-8612f356951e-300x235.png 300w, http:\/\/plslab.local\/wp-content\/uploads\/2026\/01\/f19de013-d686-4ba2-8884-8612f356951e-768x602.png 768w\" sizes=\"auto, (max-width: 802px) 100vw, 802px\" \/><\/figure>\n<\/div>\n\n\n\n<p><strong>\u5de6\u56fe\uff08RSS\u53d8\u5316\uff09\uff1a<\/strong> \u5728\u65e0\u9632\u5fa1\u60c5\u51b5\u4e0b\uff08\u7ea2\u8272\u865a\u7ebf\uff09\uff0cRSS \u5448\u73b0\u660e\u663e\u7684\u5468\u671f\u6027\uff1b\u800c\u5728\u91c7\u7528 CDPP \u9632\u5fa1\u540e\uff08\u84dd\u8272\u5b9e\u7ebf\uff09\uff0cRSS \u6062\u590d\u4e86\u968f\u673a\u6027\u3002<\/p>\n\n\n\n<p><strong>\u53f3\u56fe\uff08\u653b\u51fb\u6210\u529f\u7387\uff09\uff1a<\/strong> \u968f\u7740 RIS \u4fe1\u9053\u5728\u6574\u4e2a\u4fe1\u9053\u4e2d\u5360\u6bd4\uff08$|h_d+h_r|^2\/|h_d|^2$\uff09\u7684\u589e\u5927\uff0c\u653b\u51fb\u6210\u529f\u7387\u4f1a\u63a5\u8fd1 1\u3002\u7136\u800c\uff0c\u5f53\u566a\u58f0\u65b9\u5dee\u964d\u4f4e\u65f6\uff0cCDPP \u80fd\u6709\u6548\u6270\u4e71 Eve \u7684\u9884\u6d4b\uff0c\u663e\u8457\u964d\u4f4e\u653b\u51fb\u6210\u529f\u7387\u3002<\/p>\n\n\n\n<h3 class=\"wp-block-heading\">\u8bba\u6587\u4fe1\u606f<\/h3>\n\n\n\n<blockquote class=\"wp-block-quote is-layout-flow wp-container-core-quote-is-layout-924b0507 wp-block-quote-is-layout-flow\" style=\"padding-top:0;padding-bottom:0\">\n<p data-wp-context---core-fit-text=\"core\/fit-text::{&quot;fontSize&quot;:&quot;&quot;}\" data-wp-init---core-fit-text=\"core\/fit-text::callbacks.init\" data-wp-interactive data-wp-style--font-size=\"core\/fit-text::context.fontSize\" class=\"has-fit-text\" style=\"line-height:5\"><strong>L. Hu, C. Sun, G. Li, A. Hu, and D.W.K. Ng<\/strong>, \u201cExploiting Malicious RIS for Secret Key Acquisition in Physical-layer Key Generation\u201d, submitted to <strong>IEEE Wireless Commun. Lett.<\/strong>, 2023. (Q1, IF=6.3)<\/p>\n<\/blockquote>\n","protected":false},"excerpt":{"rendered":"<p>\u667a\u80fd\u53cd\u5c04\u9762\uff08RIS\uff09\u901a\u5e38\u88ab\u89c6\u4e3a\u901a\u4fe1\u7684\u8f85\u52a9\u8005\uff0c\u4f46\u5728\u6076\u610f\u64cd\u63a7\u4e0b\u4e5f\u53ef\u80fd\u6210\u4e3a\u5b89\u5168\u9690\u60a3\u3002\u672c\u8bfe\u9898\u7ec4\u6700\u65b0\u7814\u7a76\u63ed\u793a\u4e86\u4e00\u79cd\u57fa\u4e8e\u201c\u6076\u610fRIS\u201d\u7684\u7269\u7406\u5c42\u5bc6\u94a5\u7a83\u53d6\u653b\u51fb\uff1a\u653b\u51fb\u8005\u53ef\u5728\u4e0d\u7834\u574f\u5bc6\u94a5\u4e00\u81f4\u6027\u7684\u524d\u63d0\u4e0b\uff0c\u901a\u8fc7\u5468\u671f\u6027\u8c03\u63a7\u4fe1\u9053\u83b7\u53d6\u5bc6\u94a5\u3002\u9488\u5bf9\u6b64\u5a01\u80c1\uff0c\u6211\u4eec\u8fdb\u4e00\u6b65\u63d0\u51fa\u4e86\u57fa\u4e8e\u52a8\u6001\u79c1\u6709\u5bfc\u9891\uff08CDPP\uff09\u7684\u9632\u5fa1\u65b9\u6848\u3002\u76f8\u5173\u6210\u679c\u5df2\u6295\u7a3f\u81f3 IEEE Wireless Communications Letters\u3002<\/p>\n","protected":false},"author":1,"featured_media":406,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"_uag_custom_page_level_css":"","footnotes":""},"categories":[5],"tags":[],"class_list":["post-405","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-research"],"uagb_featured_image_src":{"full":["http:\/\/plslab.local\/wp-content\/uploads\/2026\/01\/572bf1ac-6203-4e2d-b273-a1f55259ddfa.png",1011,517,false],"thumbnail":["http:\/\/plslab.local\/wp-content\/uploads\/2026\/01\/572bf1ac-6203-4e2d-b273-a1f55259ddfa-150x150.png",150,150,true],"medium":["http:\/\/plslab.local\/wp-content\/uploads\/2026\/01\/572bf1ac-6203-4e2d-b273-a1f55259ddfa-300x153.png",300,153,true],"medium_large":["http:\/\/plslab.local\/wp-content\/uploads\/2026\/01\/572bf1ac-6203-4e2d-b273-a1f55259ddfa-768x393.png",768,393,true],"large":["http:\/\/plslab.local\/wp-content\/uploads\/2026\/01\/572bf1ac-6203-4e2d-b273-a1f55259ddfa.png",1011,517,false],"1536x1536":["http:\/\/plslab.local\/wp-content\/uploads\/2026\/01\/572bf1ac-6203-4e2d-b273-a1f55259ddfa.png",1011,517,false],