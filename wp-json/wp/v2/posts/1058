d-heading uagb-block-46005010 lab-subheading\"><h3 class=\"uagb-heading-text\">\ud83d\udccc \u6458\u8981<\/h3><\/div>\n\n\n\n<figure class=\"wp-block-pullquote has-text-align-left lab-abstract-quote has-small-font-size\" style=\"margin-right:var(--wp--preset--spacing--10);margin-left:var(--wp--preset--spacing--10);padding-top:0;padding-right:0;padding-bottom:0;padding-left:0\"><blockquote><p>\u652f\u4ed8\u901a\u9053\u7f51\u7edc\uff08PCN\uff09\u5df2\u6210\u4e3a\u89e3\u51b3\u6bd4\u7279\u5e01\u53ef\u6269\u5c55\u6027\u95ee\u9898\u7684\u4e3b\u6d41\u65b9\u6848\uff0c\u901a\u8fc7\u9ad8\u6548\u7684\u94fe\u4e0b\u66f4\u65b0\u5927\u5e45\u51cf\u5c11\u94fe\u4e0a\u4ea4\u6613\u8d1f\u62c5\u3002\u7136\u800c\uff0c\u5728\u540c\u65f6\u8ffd\u6c42\u5b89\u5168\u6027\u3001\u9690\u79c1\u6027\u4e0e\u8868\u8fbe\u80fd\u529b\u7684\u8fc7\u7a0b\u4e2d\uff0c\u73b0\u6709\u66f4\u65b0\u534f\u8bae\u5b58\u5728\u660e\u663e\u51b2\u7a81\u3002\u672c\u6587\u63d0\u51fa\u4e00\u79cd\u57fa\u4e8e UTXO \u7684\u65b0\u578b\u94fe\u4e0b\u66f4\u65b0\u534f\u8bae\u2014\u2014\u5b89\u5168\u4e14\u533f\u540d\u7684\u591a\u901a\u9053\u66f4\u65b0\u534f\u8bae\u3002SAMCU \u5728\u5386\u53f2\u4e0a\u9996\u6b21\u540c\u65f6\u5b9e\u73b0\u4e86\u5185\u90e8\u533f\u540d\u6027\uff08\u53d1\u9001\u65b9\/\u63a5\u6536\u65b9\u9690\u79c1\uff09\u3001\u4f59\u989d\u5b89\u5168\u6027\u4e0e\u591a\u901a\u9053\u66f4\u65b0\u4e09\u4e2a\u76ee\u6807\u3002\u4e3a\u5b9e\u73b0\u5185\u90e8\u533f\u540d\u6027\uff0c\u672c\u6587\u5f15\u5165\u66f4\u65b0\u56fe\u5206\u5272\u6280\u672f\uff0c\u5c06\u66f4\u65b0\u56fe\u5212\u5206\u4e3a\u82e5\u5e72\u94fe\u5f0f\u5b50\u56fe\uff0c\u4f7f\u6bcf\u4e2a\u53c2\u4e0e\u65b9\u4ec5\u77e5\u6653\u5176\u6240\u5728\u5b50\u56fe\u5185\u5404\u65b9\u7684\u8eab\u4efd\uff0c\u800c\u975e\u6574\u4e2a\u66f4\u65b0\u56fe\u4e2d\u6240\u6709\u53c2\u4e0e\u65b9\u7684\u5730\u5740\u3002\u4e3a\u89e3\u51b3 UGS \u6734\u7d20\u65b9\u6848\u4e2d\u56e0\u7b49\u4ef7\u5b50\u56fe\u5f15\u53d1\u7684\u4f59\u989d\u5b89\u5168\u95ee\u9898\uff0c\u672c\u6587\u8fdb\u4e00\u6b65\u63d0\u51fa\u542f\u7528\u652f\u4ed8\u4ea4\u6613\u6811\uff0c\u901a\u8fc7\u7cbe\u5fc3\u8bbe\u8ba1\u7684\u65f6\u95f4\u9501\u4e0e\u7b7e\u540d\u9501\u6761\u4ef6\u4fdd\u969c\u6bcf\u4f4d\u8bda\u5b9e\u53c2\u4e0e\u65b9\u7684\u4f59\u989d\u5b89\u5168\u3002\u6b64\u5916\uff0c\u901a\u8fc7\u5206\u5272\u4ea4\u6613\u964d\u4f4e\u4ea4\u6613\u8d39\u7528\uff0c\u5e76\u901a\u8fc7\u5c42\u6b21\u5316\u901a\u4fe1\u7b56\u7565\u51cf\u5c11\u901a\u4fe1\u8fde\u63a5\u6570\u91cf\uff0cSAMCU \u5728\u6027\u80fd\u4e0a\u540c\u6837\u5f97\u5230\u4f18\u5316\u3002\u539f\u578b\u7cfb\u7edf\u5b9e\u9a8c\uff08\u6700\u591a\u6d89\u53ca 100 \u6761\u66f4\u65b0\u652f\u4ed8\u901a\u9053\uff09\u8868\u660e\uff0c\u5f53\u66f4\u65b0\u901a\u9053\u6570\u91cf\u4e3a 100 \u65f6\uff0c\u4e0e\u73b0\u6709\u6700\u4f18\u65b9\u6848\u76f8\u6bd4\uff0cSAMCU \u53ef\u8282\u7701\u7ea6 70% \u7684\u901a\u4fe1\u8fde\u63a5\uff0c\u5e76\u5c06\u94fe\u4e0a\u4ea4\u6613\u8d39\u7528\u964d\u4f4e\u7ea6 66%\u3002<\/p><\/blockquote><\/figure>\n\n\n\n<div class=\"wp-block-uagb-advanced-heading uagb-block-6adec98e lab-subheading\"><h3 class=\"uagb-heading-text\">\ud83d\udca1 \u6838\u5fc3\u8d21\u732e<\/h3><\/div>\n\n\n\n<ul start=\"1\" style=\"border-style:none;border-width:0px\" class=\"wp-block-list lab-feature-list\">\n<li class=\"lab-feature-list\"><strong>\u9996\u6b21\u63d0\u51fa\u540c\u65f6\u5b9e\u73b0 MCU\u3001\u5185\u90e8\u533f\u540d\u6027\u4e0e\u5e38\u6570\u62c5\u4fdd\u7684 UTXO \u534f\u8bae<\/strong>\uff1a\u73b0\u6709 UTXO \u65b9\u6848\uff08\u5982 AMCU\u3001Thora\uff09\u8981\u6c42\u6240\u6709\u53c2\u4e0e\u65b9\u5171\u4eab\u5f7c\u6b64\u7684\u516c\u5f00\u5730\u5740\u4ee5\u534f\u540c\u751f\u6210\u542f\u7528\u652f\u4ed8\u4ea4\u6613\uff0c\u5bfc\u81f4\u4e2d\u95f4\u65b9\u53ef\u8f7b\u6613\u63a8\u65ad\u53d1\u9001\u65b9\u4e0e\u63a5\u6536\u65b9\u8eab\u4efd\uff1bHTLC \u65b9\u6848\u867d\u5177\u533f\u540d\u6027\u4f46\u4ec5\u652f\u6301\u591a\u8df3\u5355\u8def\u652f\u4ed8\uff08MHP\uff09\u4e14\u9762\u4e34\u7ebf\u6027\u62c5\u4fdd\u95ee\u9898\u3002SAMCU \u901a\u8fc7 UGS \u5c06\u66f4\u65b0\u56fe\u5212\u5206\u4e3a\u5b50\u56fe\uff0c\u4f7f\u6bcf\u65b9\u4ec5\u77e5\u6653\u6240\u5728\u5b50\u56fe\u5185\u7684\u8eab\u4efd\u4fe1\u606f\uff0c\u5728\u4e0d\u727a\u7272 MCU \u80fd\u529b\u548c\u5e38\u6570\u62c5\u4fdd\u7684\u524d\u63d0\u4e0b\u5b9e\u73b0\u5185\u90e8\u533f\u540d\u6027\uff0c\u586b\u8865\u4e86\u8be5\u9886\u57df\u7684\u7a7a\u767d\uff08\u5982\u539f\u6587 Table I \u6240\u793a\uff09\u3002<\/li>\n\n\n\n<li class=\"lab-feature-list\"><strong>\u63d0\u51fa EPTT \u89e3\u51b3\u6734\u7d20 UGS \u65b9\u6848\u4e2d\u7684\u4f59\u989d\u5b89\u5168\u95ee\u9898<\/strong>\uff1a\u6734\u7d20 UGS \u65b9\u6848\u4e2d\uff0c\u6076\u610f\u89e6\u53d1\u65b9\u53ef\u901a\u8fc7\u5ef6\u8fdf\u53d1\u5e03 txep1 \u81f3 <math xmlns=\"http:\/\/www.w3.org\/1998\/Math\/MathML\"><semantics><mrow><mi>T<\/mi><mo>\u2212<\/mo><mn>3<\/mn><mi mathvariant=\"normal\">\u0394<\/mi><mo>\u2212<\/mo><msub><mi>t<\/mi><mi>c<\/mi><\/msub><\/mrow><annotation encoding=\"application\/x-tex\">T &#8211; 3\\Delta &#8211; t_c<\/annotation><\/semantics><\/math>\u4e4b\u540e\uff0c\u4f7f\u5176\u4ed6\u5b50\u56fe\u4e2d\u7684\u63a5\u6536\u65b9\u56e0\u65f6\u95f4\u4e0d\u8db3\u800c\u65e0\u6cd5\u5b8c\u6210\u94fe\u4e0a\u5f3a\u5236\u652f\u4ed8\uff0c\u4ece\u800c\u7834\u574f\u539f\u5b50\u6027\u3002EPTT \u4e3a\u6bcf\u4e2a\u901a\u9053\u63a5\u6536\u65b9\u6784\u9020\u4ee5\u5176\u4e3a\u89e6\u53d1\u8005\u7684\u4ea4\u6613\u6811\uff0c\u901a\u8fc7\u5206\u5c42\u65f6\u95f4\u9501\u8bbe\u7f6e\uff08txep1 \u987b\u5728 <math xmlns=\"http:\/\/www.w3.org\/1998\/Math\/MathML\"><semantics><mrow><mi>T<\/mi><mo>\u2212<\/mo><mn>5<\/mn><mi mathvariant=\"normal\">\u0394<\/mi><mo>\u2212<\/mo><msub><mi>t<\/mi><mi>c<\/mi><\/msub><\/mrow><annotation encoding=\"application\/x-tex\">T &#8211; 5\\Delta &#8211; t_c<\/annotation><\/semantics><\/math> \u524d\u53d1\u5e03\uff09\u7ea6\u675f\u7406\u6027\u89e6\u53d1\u65b9\u7684\u884c\u4e3a\uff1b\u540c\u65f6\u901a\u8fc7\u7cbe\u5fc3\u8bbe\u8ba1\u7684\u591a\u91cd\u7b7e\u540d\u6761\u4ef6\u9632\u6b62\u53cc\u91cd\u