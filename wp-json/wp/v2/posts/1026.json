n\" href=\"http:\/\/localhost:10004\/wp-content\/uploads\/2026\/03\/Endogenous_Security_Techniques_for_Safeguarding_Next-Generation_Spectrum_Usage_at_the_Physical_Layer.pdf\">\ud83d\udcc4 PDF<\/a><\/div>\n\n\n\n<div class=\"wp-block-button is-style-fill\"><a class=\"wp-block-button__link wp-element-button\" href=\"https:\/\/doi.org\/10.1109\/MNET.2025.3565201\" target=\"_blank\" rel=\"https:\/\/doi.org\/10.1109\/LWC.2023.3330809 noreferrer noopener\">\ud83d\udd17 DOI \u94fe\u63a5<\/a><\/div>\n<\/div>\n<\/div>\n\n\n\n<hr class=\"wp-block-separator has-text-color has-contrast-3-color has-alpha-channel-opacity has-contrast-3-background-color has-background is-style-wide\" style=\"margin-top:var(--wp--preset--spacing--20);margin-bottom:var(--wp--preset--spacing--20)\"\/>\n\n\n\n<div class=\"wp-block-group is-layout-flow wp-block-group-is-layout-flow\">\n<div class=\"wp-block-uagb-advanced-heading uagb-block-46005010 lab-subheading\"><h3 class=\"uagb-heading-text\">\ud83d\udccc \u6458\u8981<\/h3><\/div>\n\n\n\n<figure class=\"wp-block-pullquote has-text-align-left lab-abstract-quote has-small-font-size\" style=\"margin-right:var(--wp--preset--spacing--10);margin-left:var(--wp--preset--spacing--10);padding-top:0;padding-right:0;padding-bottom:0;padding-left:0\"><blockquote><p>\u4e0b\u4e00\u4ee3\u901a\u4fe1\u7cfb\u7edf\u5bf9\u6570\u636e\u4f20\u8f93\u901f\u7387\u7684\u5feb\u901f\u589e\u957f\u52a0\u5267\u4e86\u5bf9\u9891\u8c31\u8d44\u6e90\u7684\u9700\u6c42\uff0c\u4f7f\u4f20\u7edf\u7ba1\u7406\u6a21\u5f0f\u4e0b\u7684\u6709\u9650\u8d44\u6e90\u627f\u53d7\u5de8\u5927\u538b\u529b\u3002\u8fd9\u4e00\u8d8b\u52bf\u63a8\u52a8\u4e86\u52a8\u6001\u9891\u8c31\u5171\u4eab\u4e0e\u9ad8\u9891\u6bb5\u63a2\u7d22\u7684\u53d1\u5c55\u3002\u5c3d\u7ba1\u9891\u8c31\u5171\u4eab\u4f7f\u5176\u4ed6\u7528\u6237\u80fd\u591f\u8bbf\u95ee\u672a\u5145\u5206\u5229\u7528\u7684\u7a7a\u767d\u9891\u8c31\uff0c\u4f46\u4e5f\u5e26\u6765\u4e86\u989d\u5916\u7684\u5b89\u5168\u9690\u60a3\uff1b\u9ad8\u9891\u8f7d\u6ce2\u4e0b\u7684\u653b\u51fb\u5a01\u80c1\u76ee\u524d\u5c1a\u672a\u5f97\u5230\u5145\u5206\u7814\u7a76\u3002\u4e3a\u5e94\u5bf9\u4e0a\u8ff0\u6311\u6218\uff0c\u672c\u6587\u63a2\u7d22\u5c06\u65e0\u7ebf\u901a\u4fe1\u7cfb\u7edf\u7684\u5185\u751f\u5c5e\u6027\u4f5c\u4e3a\u5b89\u5168\u8bbe\u8ba1\u7684\u65b0\u673a\u9047\u3002\u672c\u6559\u7a0b\u65e8\u5728\u5bf9\u7269\u7406\u5c42\u65e0\u7ebf\u5185\u751f\u5b89\u5168\u6280\u672f\u7684\u7814\u7a76\u73b0\u72b6\u8fdb\u884c\u5168\u9762\u7efc\u8ff0\uff0c\u6db5\u76d6\u5176\u539f\u7406\u3001\u89e3\u51b3\u65b9\u6848\u53ca\u672a\u6765\u7814\u7a76\u8d8b\u52bf\uff0c\u4ee5\u4fdd\u969c\u4e0b\u4e00\u4ee3\u9891\u8c31\u4f7f\u7528\u4e2d\u7684\u65e0\u7ebf\u5b89\u5168\u4e0e\u9690\u79c1\u3002<\/p><\/blockquote><\/figure>\n\n\n\n<div class=\"wp-block-uagb-advanced-heading uagb-block-6adec98e lab-subheading\"><h3 class=\"uagb-heading-text\">\ud83d\udca1 \u6838\u5fc3\u8d21\u732e<\/h3><\/div>\n\n\n\n<ul start=\"1\" style=\"border-style:none;border-width:0px\" class=\"wp-block-list lab-feature-list\">\n<li class=\"lab-feature-list\"><strong>\u5168\u9762\u8bc4\u4f30\u4e0b\u4e00\u4ee3\u9891\u8c31\u4f7f\u7528\u4e2d\u7684\u5b89\u5168\u8106\u5f31\u6027\u3002\u200b<\/strong> \u672c\u6587\u7cfb\u7edf\u68b3\u7406\u4e86\u73b0\u6709\u4f4e\u9891\u9891\u8c31\u8d44\u6e90\uff08\u52a8\u6001\u9891\u8c31\u63a5\u5165\/\u5171\u4eab\u3001NOMA\u7b49\uff09\u4e0e\u65b0\u5174\u9ad8\u9891\u9891\u6bb5\uff08\u6beb\u7c73\u6ce2\u3001\u592a\u8d6b\u5179\u3001\u5149\u65e0\u7ebf\u901a\u4fe1\uff09\u6240\u9762\u4e34\u7684\u5b89\u5168\u5a01\u80c1\uff0c\u5c06\u5176\u5f52\u7eb3\u4e3a\u9891\u8c31\u6570\u636e\u6cc4\u9732\u3001\u9891\u8c31\u975e\u6cd5\u5360\u7528\u4ee5\u53ca\u9891\u8c31\u5e72\u6270\u4e0e\u5e72\u6270\u653b\u51fb\u4e09\u5927\u7c7b\uff0c\u4e3a\u540e\u7eed\u5185\u751f\u5b89\u5168\u6846\u67b6\u7684\u6784\u5efa\u63d0\u4f9b\u4e86\u5a01\u80c1\u5efa\u6a21\u57fa\u7840\u3002<\/li>\n\n\n\n<li class=\"lab-feature-list\"><strong>\u63d0\u51fa\u7cfb\u7edf\u6027\u7269\u7406\u5c42\u5185\u751f\u5b89\u5168\u5c5e\u6027\u5206\u7c7b\u6846\u67b6\u3002\u200b<\/strong> \u672c\u6587\u9996\u6b21\u5c06\u65e0\u7ebf\u901a\u4fe1\u7cfb\u7edf\u7684\u5185\u751f\u5b89\u5168\u5c5e\u6027\u6309\u7cfb\u7edf\u7ec4\u4ef6\u5212\u5206\u4e3a\u56db\u4e2a\u7ef4\u5ea6\u2014\u2014\u6536\u53d1\u673a\uff08\u552f\u4e00\u6027\u3001\u9c81\u68d2\u6027\u3001\u4e0d\u53ef\u590d\u5236\u6027\uff09\u3001\u4f20\u8f93\u65b9\u5f0f\uff08\u4e0d\u53ef\u89c2\u6d4b\u6027\u3001\u91cf\u5b50\u975e\u514b\u9686\u6027\uff09\u3001\u4fe1\u9053\uff08\u4e92\u6613\u6027\u3001\u7a7a\u95f4\u53bb\u76f8\u5173\u6027\u3001\u65f6\u53d8\u6027\uff09\u4ee5\u53ca\u566a\u58f0\u4e0e\u5e72\u6270\uff08\u53ef\u6291\u5236\u6027\u3001\u53ef\u4eba\u5de5\u589e\u5f3a\u6027\u3001\u53ef\u6a21\u62df\u6027\uff09\uff0c\u6784\u5efa\u4e86\u5185\u751f\u5b89\u5168\u5c5e\u6027\u5168\u666f\u56fe\u3002<\/li>\n\n\n\n<li class=\"lab-feature-list\"><strong>\u57fa\u4e8e\u5185\u751f\u5b89\u5168\u5c5e\u6027\u8bbe\u8ba1\u9488\u5bf9\u6027\u9632\u62a4\u89e3\u51b3\u65b9\u6848\u3002\u200b<\/strong> \u9488\u5bf9\u4e09\u7c7b\u9891\u8c31\u5b89\u5168\u5a01\u80c1\uff0c\u672c\u6587\u5c06\u5185\u751f\u5c5e\u6027\u6620\u5c04\u81f3\u5177\u4f53\u9632\u62a4\u6280\u672f\uff1a\u5229\u7528\u4fe1\u9053\u4e92\u6613\u6027\u4e0e\u91cf\u5b50\u6001\u4e0d\u53ef\u89c2\u6d4b\u6027\u5b9e\u73b0\u5bc6\u94a5\u751f\u6210\uff1b\u5229\u7528\u6536\u53d1\u673a\u7269\u7406\u4e0d\u53ef\u590d\u5236\u6027\u5b9e\u73b0\u5c04\u9891\u6307\u7eb9\uff08RFF\uff09\u4e0e\u7269\u7406\u4e0d\u53ef\u514b\u9686\u51fd\u6570\u7684\u8eab\u4efd\u8ba4\u8bc1\uff1b\u5229\u7528\u566a\u58f0\u5e26\u5bbd\u53d7\u9650\u7279\u6027\u8bbe\u8ba1\u6307\u6570\u8c03\u5236\u8df3\u9891\u6269\u9891\u4e3b\u52a8\u6297\u5e72\u6270\u65b9\u6848\uff1b\u5e76\u7efc\u5408\u4fe1\u9053\u7a7a\u95f4\u53bb\u76f8\u5173\u6027\u4e0e\u6ce2\u675f\u8d4b\u5f62\u5b9e\u73b0\u88ab\u52a8\u5e72\u6270\u9632\u5fa1\uff0c\u5f62\u6210\u5b8c\u6574\u7269\u7406\u5c42\u9891\u8c31\u5b89\u5168\u4fdd\u969c\u6846\u67b6\u3002<\/li>\n<\/ul>\n\n\n\n<div class=\"wp-block-uagb-advanced-heading uagb-block-2f9d57f4 lab-subheading\"><h3 class=\"uagb-heading-text\">\ud83d\udd27 \u65b9\u6cd5\u6982\u89c8<\/h3><\/div>\n\n\n\n<div class=\"wp-block-group is-vertical is-layout-flex wp-container-core-group-is-layout-831b2db5 wp-block-group-is-layout-flex\">\n<div class=\"wp-block-uagb-image uagb-block-b46d2053 wp-block-uagb-image--layout-default wp-block-uagb-image--effect-static wp-block-uagb-image--align-none wp-container-content-b04ba3db\"><figure class=\"wp-block-uagb-image__figure\"><img decoding=\"async\" srcset=\"http:\/\/localhost:10004\/wp-content\/uploads\/2026\/03\/PixPin_2026-03-18_21-41-16-1024x349.png ,http:\/\/localhost:10004\/wp-content\/uploads\/2026\/03\/PixPin_2026-03-18_21-41-16.png 780w, http:\/\/localhost:10004\/wp-content\/uploads\/2026\/03\/PixPin_2026-03-18_21-41-16.png 360w\" sizes=\"auto, (max-width: 480px) 150px\" src=\"http:\/\/localhost:10004\/wp-content\/uploads\/2026\/03\/PixPin_2026-03-18_21-41-16-1024x349.png\" alt=\"\" class=\"uag-image-1028\" width=\"1000\" height=\"400\" title=\"PixPin_2026-03-18_21-41-16\" loading=\"lazy\" role=\"img\"\/><\/figure><\/div>\n\n\n\n<p class=\"lab-experiment-caption has-medium-font-size wp-block-paragraph\">\u672c\u6587\u4ee5\u591a\u7528\u6237\u65e0\u7ebf\u901a\u4fe1\u573a\u666f\u4e3a\u80cc\u666f\uff0c\u6784\u5efa\u4e86\u4e00\u5957\u9762\u5411\u7269\u7406\u5c42\u7684\u5185\u751f\u5b89\u5168\u4fdd\u969c\u6846\u67b6\u3002\u7cfb\u7edf\u7ec4\u6210\u6db5\u76d6\u6536\u53d1\u673a\u786c\u4ef6\u3001\u4f20\u8f93\u4ecb\u8d28\uff08\u7535\u78c1\u6ce2\/\u91cf\u5b50\u4fe1\u9053\uff09\u3001\u65e0\u7ebf\u4fe1\u9053\u53ca\u566a\u58f0\/\u5e72\u6270\u56db\u4e2a\u5c42\u9762\u3002\u5728<strong>\u9891\u8c31\u6570\u636e\u6cc4\u9732\u9632\u62a4<\/strong>\u65b9\u9762\uff0c\u6846\u67b6\u5206\u522b\u4ece\u5bc6\u94a5\u751f\u6210\u4e0e\u4fe1\u53f7\u8d28\u91cf\u9632\u5fa1\u4e24\u4e2a\u8def\u5f84\u5207\u5165\u3002\u57fa\u4e8e\u4fe1\u9053\u4e92\u6613\u6027\u7684\u5bc6\u94a5\u751f\u6210\u5229\u7528\u4fe1\u9053\u7684\u65f6\u53d8\u6027\u548c\u7a7a\u95f4\u53bb\u76f8\u5173\u6027\u52a8\u6001\u66f4\u65b0\u5bc6\u94a5\uff0c\u65e0\u9700\u4f9d\u8d56\u590d\u6742\u7684\u5bc6\u7801\u534f\u8bae\u6216\u53ef\u4fe1\u7b2c\u4e09\u65b9\uff1b\u91cf\u5b50\u5bc6\u94a5\u5206\u53d1\u5219\u501f\u52a9\u91cf\u5b50\u6001\u4e0d\u53ef\u89c2\u6d4b\u6027\u63d0\u4f9b\u4fe1\u606f\u8bba\u610f\u4e49\u4e0a\u7684\u5b89\u5168\u4fdd\u8bc1\uff1b\u6b64\u5916\uff0c\u6beb\u7c73\u6ce2\/\u592a\u8d6b\u5179\u7684\u9ad8\u65b9\u5411\u6027\u4e0e\u5feb\u901f\u8870\u843d\u7279\u6027\u5929\u7136\u589e\u5f3a\u4e86\u4f20\u8f93\u7684\u4e0d\u53ef\u89c2\u6d4b\u6027\uff0c\u800c\u8fd1\u573a\u6ce2\u675f\u805a\u7126\u6280\u672f\u53ef\u8fdb\u4e00\u6b65\u5728\u7a7a\u95f4\u4e0a\u9694\u79bb\u5e72\u6270\uff0c\u538b\u5236\u7a83\u542c\u4fe1\u9053\u8d28\u91cf\u3002\u9690\u853d\u901a\u4fe1\u5219\u901a\u8fc7\u4eba\u5de5\u566a\u58f0\u6ce8\u5165\u6216RIS\u8f85\u52a9\u6280\u672f\u5c06\u901a\u4fe1\u884c\u4e3a\u672c\u8eab\u9690\u85cf\u4e8e\u566a\u58f0\u4e4b\u4e2d\uff0c\u63d0\u4f9b\u66f4\u9ad8\u5c42\u7ea7\u7684\u4fdd\u62a4\u3002\u5728<strong>\u9891\u8c31\u975e\u6cd5\u5360\u7528\u9632\u62a4<\/strong>\u65b9\u9762\uff0c\u6846\u67b6\u7efc\u5408\u8fd0\u7528\u786c\u4ef6\u7279\u5f81\u4e0e\u4fe1\u9053\u7279\u5f81\u4e24\u7c7b\u65b9\u6cd5\u3002RFF\u5229\u7528\u6536\u53d1\u673a\u5236\u9020\u504f\u5dee\u5f62\u6210\u552f\u4e00\u7269\u7406\u5c42\u8eab\u4efd\u6807\u8bc6\uff0cPUF\u901a\u8fc7\u6311\u6218-\u54cd\u5e94\u534f\u8bae\u5b9e\u73b0\u82af\u7247\u7ea7\u8eab\u4efd\u9a8c\u8bc1\uff0c\u4e8c\u8005\u8054\u5408\u53ef\u5b9e\u73b0\u5206\u5c42\u8eab\u4efd\u6838\u9a8c\uff1b\u4fe1\u9053\u6307\u7eb9\u6280\u672f\u5219\u5229\u7528\u4fe1\u9053CSI\u7684\u4f4d\u7f6e\u4f9d\u8d56\u6027\u533a\u5206\u5408\u6cd5\u7528\u6237\u4e0e\u5192\u5145\u653b\u51fb\u8005\uff0c\u88ab\u52a8\u65b9\u6848\u901a\u8fc7CSI\u8bc4\u4f30\u5730\u7406\u4f4d\u7f6e\u4e0e\u4fe1\u9053\u7279\u6027\uff0c\u4e3b\u52a8\u65b9\u6848\u5219\u5728\u4fe1\u53f7\u4e2d\u5d4c\u5165\u57fa\u4e8e\u5171\u4eab\u5bc6\u94a5\u7684\u8ba4\u8bc1\u6807\u7b7e\u3002\u5728<strong>\u9891\u8c31\u5e72\u6270\u4e0e\u5e72\u6270\u653b\u51fb\u9632\u62a4<\/strong>\u65b9\u9762\uff0c\u4e3b\u52a8\u9632\u5fa1\u91c7\u7528IM-FHSS\u6280\u672f\uff0c\u901a\u8fc7\u52a8\u6001\u6539\u53d8\u4fe1\u53f7\u6fc0\u6d3b\u72b6\u6001\u63a9\u76d6\u7a7a\u95f2\u9891\u7387\uff0c\u5bf9\u53cd\u5e94\u5f0f\u3001\u6052\u5b9a\u5f0f\u548c\u968f\u673a\u5f0f\u4e09\u7c7b\u5e72\u6270\u5747\u5177\u6709\u4f18\u8d8a\u7684\u9c81\u68d2\u6027\uff1b\u88ab\u52a8\u9632\u5fa1\u5219\u878d\u5408\u4fe1\u9053\u6307\u7eb9\u5b9a\u4f4d\u4e0e\u5b9a\u5411\u6ce2\u675f\u8d4b\u5f62\uff0c\u5148\u5229\u7528CSI\u7a7a\u95f4\u53bb\u76f8\u5173\u6027\u786e\u5b9a\u653b\u51fb\u8005\u4f4d\u7f6e\uff0c\u518d\u901a\u8fc7\u7cbe\u51c6\u6ce2\u675f\u8d4b\u5f62\u5b9e\u65bd\u5e72\u6270\u6291\u5236\u3002<\/p>\n<\/div>\n\n\n\n<div class=\"wp-block-uagb-advanced-heading uagb-block-dda34f26 lab-subheading\"><h3 class=\"uagb-heading-text\">\ud83d\udcca \u5b9e\u9a8c\u7ed3\u679c<\/h3><\/div>\n\n\n\n<div class=\"wp-block-group lab-paper-results is-nowrap is-layout-flex wp-container-core-group-is-layout-3a88641f wp-block-group-is-layout-flex\">\n<div class=\"wp-block-uagb-image uagb-block-080de2b0 wp-block-uagb-image--layout-default wp-block-uagb-image--effect-static wp-block-uagb-image--align-none wp-container-content-9cfa9a5a\"><figure class=\"wp-block-uagb-image__figure\"><img decoding=\"async\" srcset=\"http:\/\/localhost:10004\/wp-content\/uploads\/2026\/03\/PixPin_2026-03-18_21-43-46-1024x515.png ,http:\/\/localhost:10004\/wp-content\/uploads\/2026\/03\/PixPin_2026-03-18_21-43-46.png 780w, http:\/\/localhost:10004\/wp-content\/uploads\/2026\/03\/PixPin_2026-03-18_21-43-46.png 360w\" sizes=\"auto, (max-width: 480px) 150px\" src=\"http:\/\/localhost:10004\/wp-content\/uploads\/2026\/03\/PixPin_2026-03-18_21-43-46-1024x515.png\" alt=\"\" class=\"uag-image-1029\" width=\"802\" height=\"656\" title=\"PixPin_2026-03-18_21-43-46\" loading=\"lazy\" role=\"img\"\/><\/figure><\/div>\n\n\n\n<div class=\"wp-block-group is-vertical is-layout-flex wp-container-core-group-is-layout-831b2db5 wp-block-group-is-layout-flex\">\n<p class=\"lab-experiment-caption has-medium-font-size wp-block-paragraph\">\u5728\u771f\u5b9eADS-B\u4fe1\u53f7\u73af\u5883\u4e0b\u7684\u5c04\u9891\u6307\u7eb9\u8bc6\u522b\u5b9e\u9a8c\u4e2d\uff0c\u91c7\u7528\u5c0f\u6837\u672c\u5b66\u4e60\u6280\u672f\u7684RFF\u6a21\u578b\u5728\u6bcf\u7c7b\u8bbe\u5907\u4ec5\u6709 <strong>30\u4e2a\u6807\u6ce8\u6837\u672c<\/strong>\u7684\u6761\u4ef6\u4e0b\uff0c\u5206\u7c7b\u51c6\u786e\u7387\u5373\u53ef\u8d85\u8fc7 <strong>90%\u200b<\/strong>\uff0c\u5c55\u793a\u4e86RFF\u65b9\u6cd5\u5728\u6807\u6ce8\u6570\u636e\u6781\u5ea6\u53d7\u9650\u573a\u666f\u4e0b\u5bf9\u6297\u975e\u6cd5\u9891\u8c31\u5360\u7528\u7684\u9ad8\u6548\u6027\u4e0e\u9c81\u68d2\u6027\u3002<\/p>\n<\/div>\n<\/div>\n\n\n\n<div class=\"wp-block-uagb-advanced-heading uagb-block-e3c2d50d lab-subheading\"><h3 class=\"uagb-heading-text\">\ud83d\udcdd \u5f15\u7528<\/h3><\/div>\n\n\n\n<pre class=\"wp-block-code lab-bibtex-code has-small-font-size\"><code>@article{li2025endogenous,\n  author    = {Li, Guyue and Zhou, Yajie and Sun, Yingjie and Wen, Shiping\n               and Wang, Shuai and Hu, Aiqun and Wen, Guanghui},\n  title     = {Endogenous Security Techniques for Safeguarding Next-Generation\n               Spectrum Usage at the Physical Layer},\n  journal   = {IEEE Network},\n  volume    = {39},\n  number    = {6},\n  pages     = {128--138},\n  year      = {2025},\n  doi       = {10.1109\/MNET.2025.3565201},\n}\n<\/code><\/pre>\n<\/div>\n\n\n\n<hr class=\"wp-block-separator has-alpha-channel-opacity is-style-wide\" style=\"margin-top:var(--wp--preset--spacing--20);margin-bottom:var(--wp--preset--spacing--20)\"\/>\n\n\n\n<div class=\"wp-block-group is-layout-flow wp-block-group-is-layout-flow\">\n<div style=\"height:100px\" aria-hidden=\"true\" class=\"wp-block-spacer\"><\/div>\n\n\n\n<div class=\"wp-block-group is-content-justification-space-between is-nowrap is-layout-f