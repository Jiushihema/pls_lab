-layout-flow\">\n<div class=\"wp-block-uagb-advanced-heading uagb-block-46005010 lab-subheading\"><h3 class=\"uagb-heading-text\">\ud83d\udccc \u6458\u8981<\/h3><\/div>\n\n\n\n<figure class=\"wp-block-pullquote has-text-align-left lab-abstract-quote has-small-font-size\" style=\"margin-right:var(--wp--preset--spacing--10);margin-left:var(--wp--preset--spacing--10);padding-top:0;padding-right:0;padding-bottom:0;padding-left:0\"><blockquote><p>\u7269\u7406\u5c42\u5bc6\u94a5\u751f\u6210\uff08PKG\uff09\u5229\u7528\u65e0\u7ebf\u4fe1\u9053\u7684\u4e92\u6613\u6027\u4e0e\u968f\u673a\u6027\uff0c\u5728\u4e24\u4e2a\u5408\u6cd5\u901a\u4fe1\u7aef\u4e4b\u95f4\u751f\u6210\u5bf9\u79f0\u5bc6\u94a5\u3002\u7136\u800c\uff0c\u5728\u591a\u5c0f\u533a\u7cfb\u7edf\u4e2d\uff0cPKG \u56e0\u4e0d\u540c\u5c0f\u533a\u590d\u7528\u76f8\u540c\u5bfc\u9891\u800c\u906d\u53d7\u4e25\u91cd\u7684\u5bfc\u9891\u6c61\u67d3\u95ee\u9898\u3002\u4e3a\u6b64\uff0c\u672c\u6587\u5f15\u5165\u591a\u4e2a\u53ef\u91cd\u6784\u667a\u80fd\u8868\u9762\u5bf9\u4f20\u64ad\u73af\u5883\u8fdb\u884c\u81ea\u9002\u5e94\u6574\u5f62\uff0c\u4ee5\u63d0\u5347 PKG \u6027\u80fd\u3002\u5177\u4f53\u800c\u8a00\uff0c\u672c\u6587\u6784\u5efa\u4e86\u4e00\u4e2a\u4f18\u5316\u95ee\u9898\uff0c\u901a\u8fc7\u8054\u5408\u4f18\u5316\u57fa\u7ad9\u5904\u7684\u9884\u7f16\u7801\u77e9\u9635\u4e0e RIS \u5904\u7684\u76f8\u79fb\uff0c\u4ee5\u6700\u5927\u5316\u52a0\u6743\u548c\u5bc6\u94a5\u901f\u7387\u3002\u9488\u5bf9\u8be5\u95ee\u9898\u7684\u975e\u51f8\u6027\uff0c\u672c\u6587\u91c7\u7528\u57fa\u4e8e\u4ea4\u66ff\u4f18\u5316\u7684\u7b97\u6cd5\uff0c\u5c06\u8054\u5408\u4f18\u5316\u95ee\u9898\u5206\u89e3\u4e3a\u4e24\u4e2a\u5b50\u95ee\u9898\uff1a\u5bf9\u4e8e\u9884\u7f16\u7801\u77e9\u9635\u5b50\u95ee\u9898\uff0c\u91c7\u7528\u57fa\u4e8e Karush-Kuhn-Tucker\u6761\u4ef6\u7684\u62c9\u683c\u6717\u65e5\u5bf9\u5076\u65b9\u6cd5\uff1b\u5bf9\u4e8e\u76f8\u79fb\u5b50\u95ee\u9898\uff0c\u91c7\u7528\u6295\u5f71\u68af\u5ea6\u4e0a\u5347\u7b97\u6cd5\u3002\u4eff\u771f\u7ed3\u679c\u9a8c\u8bc1\u4e86\u6240\u63d0\u65b9\u6848\u7684\u6709\u6548\u6027\uff0c\u5c55\u793a\u4e86 WSKR \u7684\u663e\u8457\u63d0\u5347\u3002\u6b64\u5916\uff0c\u4e0e\u5355 RIS \u65b9\u6848\u76f8\u6bd4\uff0c\u90e8\u7f72\u591a\u4e2a RIS \u80fd\u63d0\u4f9b\u7a7a\u95f4\u5206\u96c6\uff0c\u4ece\u800c\u8fdb\u4e00\u6b65\u6539\u5584\u591a\u5c0f\u533a PKG \u6027\u80fd\u3002<\/p><\/blockquote><\/figure>\n\n\n\n<div class=\"wp-block-uagb-advanced-heading uagb-block-6adec98e lab-subheading\"><h3 class=\"uagb-heading-text\">\ud83d\udca1 \u6838\u5fc3\u8d21\u732e<\/h3><\/div>\n\n\n\n<ul start=\"1\" style=\"border-style:none;border-width:0px\" class=\"wp-block-list lab-feature-list\">\n<li class=\"lab-feature-list\"><strong>\u63d0\u51fa\u4e86\u65b0\u578b RIS \u8f85\u52a9\u591a\u5c0f\u533a PKG \u6846\u67b6<\/strong>\uff1a\u57fa\u4e8e BS \u5904\u7684\u9884\u7f16\u7801\u77e9\u9635\u4e0e RIS \u5904\u7684\u76f8\u79fb\uff0c\u6784\u5efa\u4e86\u5b8c\u6574\u7684\u591a\u5c0f\u533a\u7269\u7406\u5c42\u5bc6\u94a5\u751f\u6210\u6846\u67b6\uff0c\u63a8\u5bfc\u4e86\u5bc6\u94a5\u751f\u6210\u901f\u7387\u7684\u95ed\u5408\u8868\u8fbe\u5f0f\uff0c\u5e76\u5c06\u95ee\u9898\u5efa\u6a21\u4e3a\u5168\u7f51 WSKR \u6700\u5927\u5316\u4f18\u5316\u95ee\u9898\u3002\u6b64\u5916\uff0c\u7406\u8bba\u8bc1\u660e\u4e86\u5728\u65e0 RIS \u90e8\u7f72\u65f6\uff0c\u5c0f\u533a\u95f4\u5e72\u6270\u4f1a\u5bfc\u81f4 KGR \u6781\u4f4e\u4e43\u81f3\u8d8b\u8fd1\u4e8e\u96f6\u3002<\/li>\n\n\n\n<li class=\"lab-feature-list\"><strong>\u8bbe\u8ba1\u4e86\u9ad8\u6548\u7684 AO \u53cc\u5b50\u95ee\u9898\u6c42\u89e3\u7b97\u6cd5<\/strong>\uff1a\u9488\u5bf9\u539f\u59cb\u975e\u51f8\u4f18\u5316\u95ee\u9898\uff0c\u5c06\u8054\u5408\u4f18\u5316\u5206\u89e3\u4e3a\u4e24\u4e2a\u4ea4\u66ff\u6c42\u89e3\u7684\u5b50\u95ee\u9898\u3002\u5bf9\u4e8e\u9884\u7f16\u7801\u77e9\u9635\u5b50\u95ee\u9898\uff0c\u57fa\u4e8e KKT \u6761\u4ef6\u63a8\u5bfc\u5176\u6700\u4f18\u7ed3\u6784\uff0c\u5e76\u7ed3\u5408\u4e8c\u5206\u641c\u7d22\u6c42\u89e3\u62c9\u683c\u6717\u65e5\u4e58\u5b50\uff1b\u5bf9\u4e8e\u76f8\u79fb\u5411\u91cf\u5b50\u95ee\u9898\uff0c\u63a8\u5bfc\u4e86\u76ee\u6807\u51fd\u6570\u5173\u4e8e\u76f8\u79fb\u7684\u95ed\u5408\u68af\u5ea6\u8868\u8fbe\u5f0f\uff0c\u91c7\u7528 PGA \u7b97\u6cd5\u8fed\u4ee3\u66f4\u65b0\u5e76\u901a\u8fc7\u56de\u6eaf\u7ebf\u641c\u7d22\u786e\u5b9a\u6b65\u957f\uff0c\u4fdd\u8bc1\u4e86\u7b97\u6cd5\u76ee\u6807\u503c\u7684\u5355\u8c03\u4e0d\u51cf\u6536\u655b\u6027\u3002<\/li>\n\n\n\n<li class=\"lab-feature-list\"><strong>\u63ed\u793a\u4e86\u5206\u5e03\u5f0f\u591a RIS \u7684\u7a7a\u95f4\u5206\u96c6\u589e\u76ca<\/strong>\uff1a\u901a\u8fc7\u4e03\u5c0f\u533a\u573a\u666f\u7684\u7cfb\u7edf\u4eff\u771f\uff0c\u7814\u7a76\u4e86 RIS \u90e8\u7f72\u4f4d\u7f6e\u4e0e\u6570\u91cf\u5bf9 PKG \u6027\u80fd\u7684\u5f71\u54cd\u3002\u4eff\u771f\u7ed3\u679c\u8868\u660e\uff0c\u5c06 RIS \u90e8\u7f72\u5728\u5c0f\u533a\u8fb9\u754c\u5904\u80fd\u591f\u6700\u6709\u6548\u5730\u6291\u5236\u5c0f\u533a\u95f4\u5bfc\u9891\u6c61\u67d3\uff1b\u4e0e\u5355 RIS \u65b9\u6848\u76f8\u6bd4\uff0c\u5c06\u591a\u4e2a RIS \u5206\u5e03\u5f0f\u90e8\u7f72\u4e8e\u5404\u5c0f\u533a\u8fb9\u754c\u80fd\u63d0\u4f9b\u66f4\u4e30\u5bcc\u7684\u7a7a\u95f4\u5206\u96c6\uff0c\u5728\u63d0\u5347\u5168\u7f51 WSKR \u7684\u540c\u65f6\u6539\u5584\u5404\u5c0f\u533a\u95f4\u7684 KGR \u516c\u5e73\u6027\u3002<\/li>\n<\/ul>\n\n\n\n<div class=\"wp-block-uagb-advanced-heading uagb-block-2f9d57f4 lab-subheading\"><h3 class=\"uagb-heading-text\">\ud83d\udd27 \u65b9\u6cd5\u6982\u89c8<\/h3><\/div>\n\n\n\n<div class=\"wp-block-group lab-paper-results is-nowrap is-layout-flex wp-container-core-group-is-layout-3a88641f wp-block-group-is-layout-flex\">\n<div class=\"wp-block-uagb-image uagb-block-b46d2053 wp-block-uagb-image--layout-default wp-block-uagb-image--effect-static wp-block-uagb-image--align-none wp-container-content-9cfa9a5a\"><figure class=\"wp-block-uagb-image__figure\"><img decoding=\"async\" srcset=\"https:\/\/jiushihema.github.io\/pls_lab\/wp-content\/uploads\/2026\/03\/PixPin_2026-03-08_15-17-22.png ,https:\/\/jiushihema.github.io\/pls_lab\/wp-content\/uploads\/2026\/03\/PixPin_2026-03-08_15-17-22.png 780w, https:\/\/jiushihema.github.io\/pls_lab\/wp-content\/uploads\/2026\/03\/PixPin_2026-03-08_15-17-22.png 360w\" sizes=\"auto, (max-width: 480px) 150px\" src=\"https:\/\/jiushihema.github.io\/pls_lab\/wp-content\/uploads\/2026\/03\/PixPin_2026-03-08_15-17-22.png\" alt=\"\" class=\"uag-image-985\" width=\"802\" height=\"656\" title=\"PixPin_2026-03-08_15-17-22\" loading=\"lazy\" role=\"img\"\/><\/figure><\/div>\n\n\n\n<div class=\"wp-block-group is-vertical is-layout-flex wp-container-core-group-is-layout-831b2db5 wp-block-group-is-layout-flex\">\n<p class=\"lab-experiment-caption has-medium-font-size wp-block-paragraph\">\u672c\u6587\u6240\u63d0\u6846\u67b6\u7531\u4e09\u4e2a\u9636\u6bb5\u4e32\u8054\u6784\u6210\u3002<strong>\u53c2\u6570\u8bbe\u8ba1\u9636\u6bb5<\/strong>\uff0c\u5404 BS \u6839\u636e\u7edf\u8ba1\u4fe1\u9053\u72b6\u6001\u4fe1\u606f\uff08\u7edf\u8ba1 CSI\uff09\u8054\u5408\u8bbe\u8ba1\u9884\u7f16\u7801\u77e9\u9635 <math xmlns=\"http:\/\/www.w3.org\/1998\/Math\/MathML\"><semantics><mrow><msub><mi mathvariant=\"bold\">P<\/mi><mi>k<\/mi><\/msub><\/mrow><annotation encoding=\"application\/x-tex\">\\mathbf{P}_k<\/annotation><\/semantics><\/math> \u4e0e RIS \u76f8\u79fb\u5411\u91cf <math xmlns=\"http:\/\/www.w3.org\/1998\/Math\/MathML\"><semantics><mrow><mi mathvariant=\"bold\">v<\/mi><\/mrow><annotation encoding=\"application\/x-tex\">\\mathbf{v}<\/annotation><\/semantics><\/math>\uff0c\u5e76\u901a\u8fc7\u667a\u80fd\u63a7\u5236\u5668\u5c06\u76f8\u79fb\u914d\u7f6e\u4e0b\u53d1\u81f3\u5404 RIS\u3002<strong>\u4fe1\u9053\u63a2\u6d4b\u9636\u6bb5<\/strong>\uff0cBS \u4e0e UT \u5728 TDD \u534f\u8bae\u4e0b\u4ea4\u66ff\u53d1\u9001\u5bfc\u9891\uff0cRIS \u901a\u8fc7\u4f18\u5316\u540e\u7684\u76f8\u79fb\u5bf9\u53cd\u5c04\u4fe1\u53f7\u8fdb\u884c\u8c03\u63a7\uff0c\u4f7f\u6765\u81ea\u5176\u4ed6\u5c0f\u533a\u7684\u5c0f\u533a\u95f4\u5bfc\u9891\u5e72\u6270\u5728\u76ee\u6807\u901a\u4fe1\u8282