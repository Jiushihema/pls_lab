pls_lab\/wp-content\/uploads\/2026\/03\/Securing_Wireless_Communications_via_Channel_Reciprocity_and_Dynamic_Constellation_Obfuscation.pdf\">\ud83d\udcc4 PDF<\/a><\/div>\n\n\n\n<div class=\"wp-block-button is-style-fill\"><a class=\"wp-block-button__link wp-element-button\" href=\"https:\/\/doi.org\/10.1109\/JIOT.2025.3581791\" target=\"_blank\" rel=\"https:\/\/doi.org\/10.1109\/LWC.2023.3330809 noreferrer noopener\">\ud83d\udd17 DOI \u94fe\u63a5<\/a><\/div>\n<\/div>\n<\/div>\n\n\n\n<hr class=\"wp-block-separator has-text-color has-contrast-3-color has-alpha-channel-opacity has-contrast-3-background-color has-background is-style-wide\" style=\"margin-top:var(--wp--preset--spacing--20);margin-bottom:var(--wp--preset--spacing--20)\"\/>\n\n\n\n<div class=\"wp-block-group is-layout-flow wp-block-group-is-layout-flow\">\n<div class=\"wp-block-uagb-advanced-heading uagb-block-46005010 lab-subheading\"><h3 class=\"uagb-heading-text\">\ud83d\udccc \u6458\u8981<\/h3><\/div>\n\n\n\n<figure class=\"wp-block-pullquote has-text-align-left lab-abstract-quote has-small-font-size\" style=\"margin-right:var(--wp--preset--spacing--10);margin-left:var(--wp--preset--spacing--10);padding-top:0;padding-right:0;padding-bottom:0;padding-left:0\"><blockquote><p>\u57fa\u4e8e\u65e0\u7ebf\u4fe1\u9053\u4e92\u6613\u6027\u7684\u4e00\u6b21\u4e00\u5bc6\u5b89\u5168\u4f20\u8f93\uff08CR-OTP\uff09\u56e0\u5176\u80fd\u540c\u65f6\u4fdd\u62a4\u6570\u636e\u4e0e\u8c03\u5236\u4fe1\u606f\u7684\u5b8c\u7f8e\u4fdd\u5bc6\u6027\u800c\u53d7\u5230\u5e7f\u6cdb\u5173\u6ce8\u3002\u7136\u800c\uff0c\u73b0\u6709 CR-OTP \u65b9\u6848\u5728\u5b9e\u9645\u5e94\u7528\u4e2d\u9762\u4e34\u53ef\u9760\u6027\u4e0e\u5b89\u5168\u6027\u53cc\u91cd\u6311\u6218\u2014\u2014\u4fe1\u9053\u4e92\u6613\u6027\u4e0e\u968f\u673a\u6027\u5047\u8bbe\u5e76\u4e0d\u603b\u80fd\u5f97\u5230\u6ee1\u8db3\u3002\u4e3a\u89e3\u51b3\u4e0a\u8ff0\u95ee\u9898\uff0c\u672c\u6587\u63d0\u51fa\u4e00\u79cd\u52a8\u6001\u661f\u5ea7\u6df7\u6dc6\u65b9\u6cd5\uff0c\u901a\u8fc7\u52a8\u6001\u65cb\u8f6c\u661f\u5ea7\u56fe\u6765\u6df7\u6dc6\u660e\u6587\u3002\u8be5\u6a21\u62df\u52a0\u5bc6\u65b9\u6cd5\u88ab\u8bc1\u660e\u6bd4\u73b0\u6709\u6570\u5b57\u5f02\u6216\u52a0\u5bc6\u65b9\u6cd5\u66f4\u9c81\u68d2\uff0c\u901a\u8fc7\u5c06\u53cc\u91cd\u91cf\u5316\u635f\u5931\u964d\u4f4e\u4e3a\u5355\u6b21\uff0c\u5b9e\u73b0\u66f4\u4f4e\u7684\u7b26\u53f7\u9519\u8bef\u7387\u3002\u65cb\u8f6c\u6a21\u5f0f\u7531\u4fe1\u9053\u72b6\u6001\u4fe1\u606f\u4e0e\u524d\u4e00\u5e27\u6d88\u606f\u8054\u5408\u51b3\u5b9a\uff0c\u4ece\u800c\u4fdd\u8bc1\u65cb\u8f6c\u6a21\u5f0f\u5728\u4fe1\u9053\u7f13\u53d8\u73af\u5883\u4e0b\u7684\u968f\u673a\u6027\u3002\u53ea\u6709\u80fd\u6b63\u786e\u6062\u590d\u524d\u4e00\u5e27\u6d88\u606f\u4e14\u89c2\u6d4b\u5230\u76f8\u4f3c CSI \u7684\u5408\u6cd5\u63a5\u6536\u65b9\u624d\u80fd\u89e3\u7801\u5f53\u524d\u4f20\u8f93\u7684\u6d88\u606f\u3002\u7406\u8bba\u8bc1\u660e\uff0cDCO \u65b9\u6cd5\u7684\u4fdd\u5bc6\u5bb9\u91cf\u9ad8\u4e8e\u73b0\u6709\u6700\u4f18\u65b9\u6848\u3002\u4eff\u771f\u7ed3\u679c\u8868\u660e\uff0c\u6240\u63d0\u65b9\u6cd5\u5728\u4fdd\u5bc6\u5bb9\u91cf\u4e0e SER \u65b9\u9762\u5747\u8868\u73b0\u4f18\u8d8a\uff1a\u5728 SER \u4e3a 0.1 \u65f6\u83b7\u5f97 4.5 dB \u7684 SNR \u589e\u76ca\uff1b\u5f53\u4fdd\u5bc6\u5bb9\u91cf\u4e3a 0.1 \u65f6\uff0c\u5728\u7a83\u542c\u4fe1\u9053 SNR \u4e3a 20 dB \u7684\u6761\u4ef6\u4e0b\uff0c\u4e3b\u4fe1\u9053 SNR \u589e\u76ca\u8fbe 6.5 dB\u3002<\/p><\/blockquote><\/figure>\n\n\n\n<div class=\"wp-block-uagb-advanced-heading uagb-block-6adec98e lab-subheading\"><h3 class=\"uagb-heading-text\">\ud83d\udca1 \u6838\u5fc3\u8d21\u732e<\/h3><\/div>\n\n\n\n<ul start=\"1\" style=\"border-style:none;border-width:0px\" class=\"wp-block-list lab-feature-list\">\n<li class=\"lab-feature-list\"><strong>\u63d0\u51fa DCO \u6a21\u62df\u52a0\u5bc6\u65b9\u6848\uff0c\u5c06\u53cc\u91cd\u91cf\u5316\u635f\u5931\u964d\u4e3a\u5355\u6b21\uff0c\u63d0\u5347\u4f20\u8f93\u53ef\u9760\u6027<\/strong>\uff1a\u4e0e\u4f20\u7edf\u6570\u5b57 XOR \u52a0\u5bc6\u9700\u5bf9 CSI \u91cf\u5316\u4e0d\u540c\uff0cDCO \u76f4\u63a5\u4ee5\u6a21\u62df CSI \u503c\u9a71\u52a8\u661f\u5ea7\u65cb\u8f6c\uff0c\u907f\u514d\u4e86\u91cf\u5316\u8bef\u5dee\u7684\u4e8c\u6b21\u53e0\u52a0\uff1b\u7406\u8bba\u63a8\u5bfc\u8bc1\u660e <math xmlns=\"http:\/\/www.w3.org\/1998\/Math\/MathML\"><semantics><mrow><msub><mrow><mi>Pr<\/mi><mo>\u2061<\/mo><\/mrow><mrow><mi>D<\/mi><mi>C<\/mi><mi>O<\/mi><\/mrow><\/msub><mo>&lt;<\/mo><msub><mrow><mi>Pr<\/mi><mo>\u2061<\/mo><\/mrow><mrow><mi>X<\/mi><mi>O<\/mi><mi>R<\/mi><\/mrow><\/msub><\/mrow><annotation encoding=\"application\/x-tex\">\\Pr_{DCO} &lt; \\Pr_{XOR}<\/annotation><\/semantics><\/math>\uff0c\u5373 DCO \u7684 SER \u4e25\u683c\u4f4e\u4e8e XOR \u65b9\u6848\uff0c\u5728 QPSK \u8c03\u5236\u4e0b SER = 0.1 \u65f6\u83b7\u5f97 4.5 dB SNR \u589e\u76ca\u3002<\/li>\n\n\n\n<li class=\"lab-feature-list\"><strong>\u8bbe\u8ba1\u8054\u5408\u5229\u7528\u4fe1\u9053\u968f\u673a\u6027\u4e0e\u6d88\u606f\u968f\u673a\u6027\u7684\u65f6\u53d8\u65cb\u8f6c\u6a21\u5f0f\u751f\u6210\u65b9\u6cd5\uff0c\u589e\u5f3a\u7f13\u53d8\u73af\u5883\u4e0b\u7684\u5b89\u5168\u6027<\/strong>\uff1a\u65cb\u8f6c\u89d2\u7531\u5f53\u524d CSI \u4e0e\u524d\u4e00\u5e27\u5df2\u4f20\u6d88\u606f\u5171\u540c\u51b3\u5b9a\uff0c\u5f15\u5165\u6df7\u6c8c\u5e8f\u5217\u4fdd\u8bc1\u65cb\u8f6c\u6a21\u5f0f\u7684\u4e0d\u53ef\u9884\u6d4b\u6027\uff1b\u7406\u8bba\u8bc1\u660e DCO \u7684\u5e73\u5747\u4fdd\u5bc6\u5bb9\u91cf\u9ad8\u4e8e XOR \u65b9\u6848\uff08<math xmlns=\"http:\/\/www.w3.org\/1998\/Math\/MathML\"><semantics><mrow><msubsup><mi>C<\/mi><mi>s<\/mi><mrow><mi>D<\/mi><mi>C<\/mi><mi>O<\/mi><\/mrow><\/msubsup><mo>&gt;<\/mo><msubsup><mi>C<\/mi><mi>s<\/mi><mrow><mi>X<\/mi><mi>O<\/mi><mi>R<\/mi><\/mrow><\/msubsup><\/mrow><annotation encoding=\"application\/x-tex\">C_s^{DCO} &gt; C_s^{XOR}<\/annotation><\/semantics><\/math>\u200b\uff09\uff0c\u4e14\u5728 <math xmlns=\"http:\/\/www.w3.org\/1998\/Math\/MathML\"><semantics><mrow><msub><mover accent=\"true\"><mi>\u03b3<\/mi><mo>\u02c9<\/mo><\/mover><mi>m<\/mi><\/msub><mo>=<\/mo><mn>10<\/mn><\/mrow><annotation encoding=\"application\/x-tex\">\\bar{\\gamma}_m = 10<\/annotation><\/semantics><\/math>\u03b3 \u65f6\u4fdd\u5bc6\u5bb9\u91cf\u589e\u76ca\u8fbe 0.1 bps\uff0c\u80fd\u6709\u6548\u62b5\u5fa1\u5dee\u5206\u653b\u51fb\u3001\u6ce8\u5165\u653b\u51fb\u3001\u4fe1\u9053\u91cd\u653e\u653b\u51fb\u7b49\u4e94\u7c7b\u5178\u578b\u5a01\u80c1\u3002<\/li>\n\n\n\n<li class=\"lab-feature-list\"><strong>\u901a\u8fc7\u7406\u8bba\u5206\u6790\u4e0e\u4eff\u771f\u5b9e\u9a8c\u5168\u9762\u9a8c\u8bc1 DCO \u65b9\u6848\u7684\u5b89\u5168\u6027\u4e0e\u53ef\u9760\u6027<\/strong>\uff1a\u5728\u4fdd\u5bc6\u5bb9\u91cf\u3001\u4e2d\u65ad\u6982\u7387\u3001SER\u3001\u76f8\u4f4d\u8bef\u5dee\u9c81\u68d2\u6027\u7b49\u591a\u4e2a\u7ef4\u5ea6\u4e0e XOR \u65b9\u6848\u5bf9\u6bd4\uff0c\u7ed3\u679c\u4e00\u81f4\u9a8c\u8bc1 DCO \u7684\u4f18\u8d8a\u6027\uff1b\u540c\u65f6\u5206\u6790\u4e86\u8ba1\u7b97\u590d\u6742\u5ea6\uff0c\u8bc1\u660e DCO \u5bf9\u786c\u4ef6\u53d7\u9650\u7684\u7269\u7406\u5c42\u5b89\u5168\u5b9e\u73b0\u5177\u5907\u53ef\u884c\u6027\u3002<\/li>\n<\/ul>\n\n\n\n<div class=\"wp-block-uagb-advanced-heading uagb-block-2f9d57f4 lab-subheading\"><h3 class=\"uagb-heading-text\">\ud83d\udd27 \u65b9\u6cd5\u6982\u89c8<\/h3><\/div>\n\n\n\n<div class=\"wp-block-group lab-paper-results is-nowrap is-layout-flex wp-container-core-group-is-layout-3a88641f wp-block-group-is-layout-flex\">\n<div class=\"wp-block-uagb-image uagb-block-b46d2053 wp-block-uagb-image--layout-default wp-block-uagb-image--effect-static wp-block-uagb-image--align-none wp-container-content-9cfa9a5a\"><figure class=\"wp-block-uagb-image__figure\"><img decoding=\"async\" srcset=\"http:\/\/jiushihema.github.io/pls_lab\/wp-content\/uploads\/2026\/03\/PixPin_2026-03-23_12-27-05.png ,http:\/\/jiushihema.github.io/pls_lab\/wp-content\/uploads\/2026\/03\/PixPin_2026-03-23_12-27-05.png 780w, http:\/\/jiushihema.github.io/pls_lab\/wp-content\/uploads\/2026\/03\/PixPin_2026-03-23_12-27-05.png 360w\" sizes=\"auto, (max-width: 480px) 150px\" src=\"http:\/\/jiushihema.github.io/pls_lab\/wp-content\/uploads\/2026\/03\/PixPin_2026-03-23_12-27-05.png\" alt=\"\" class=\"uag-image-1038\" width=\"802\" height=\"656\" title=\"PixPin_2026-03-23_12-27-05\" loading=\"lazy\" role=\"img\"\/><\/figure><\/div>\n\n\n\n<div class=\"wp-block-group is-vertical is-layout-flex wp-container-core-group-is-layout-831b2db5 wp-block-group-is-layout-flex\">\n<p class=\"lab-experiment-caption has-medium-font-size wp-block-paragraph\">\u7cfb\u7edf\u91c7\u7528\u7ecf\u5178\u4e09\u65b9 TDD-OFDM \u6a21\u578b\uff08Alice\u3001Bob\u3001Eve\uff09\uff0cAlice \u4e0e Bob \u901a\u8fc7\u4ea4\u66ff\u53d1\u9001\u5bfc\u9891\u5b8c\u6210\u4fe1\u9053\u91c7\u6837\uff0c\u83b7\u53d6\u9ad8\u5ea6\u76f8\u5173\u7684\u4fe1\u9053\u4f30\u8ba1 <math xmlns=\"http:\/\/www.w3.org\/1998\/Math\/MathML\"><semantics><mrow><msub><mover accent=\"true\"><mi>h<\/mi><mo>^<\/mo><\/mover><mi>A<\/mi><\/msub><mo stretchy=\"false\">(<\/mo><mi>k<\/mi><mo stretchy=\"false\">)<\/mo><\/mrow><annotation encoding=\"application\/x-tex\">\\hat{h}_A(k)<\/annotation><\/semantics><\/math> \u4e0e <math xmlns=\"http:\/\/www.w3.org\/1998\/Math\/MathML\"><semantics><mrow><msub><mover accent=\"true\"><mi>h<\/mi><mo>^<\/mo><\/mover><mi>B<\/mi><\/msub><mo stretchy=\"false\">(<\/mo><mi>k<\/mi><mo stretchy=\"false\">)<\/mo><\/mrow><annotation encoding=\"application\/x-tex\">\\hat{h}_B(k)<\/annotation><\/semantics><\/math>\u3002<strong>DCO \u52a0\u5bc6\u6d41\u7a0b<\/strong>\u5206\u4e3a\u4e24\u4e2a\u6838\u5fc3\u6a21\u5757\uff1a<strong>\u661f\u5ea7\u65cb\u8f6c\u6a21\u5f0f\u751f\u6210\u6a21\u5757<\/strong>\u5c06\u5f53\u524d CSI \u7684\u76f8\u4f4d\u5206\u91cf\u4e0e\u524d\u4e00\u5e27\u6d88\u606f\u7ecf\u6df7\u6c8c\u6620\u5c04\uff08Logistic \u6620\u5c04\uff09\u8054\u5408\u5904\u7406\uff0c\u751f\u6210\u65f6\u53d8\u65cb\u8f6c\u89d2\u5e8f\u5217 <math xmlns=\"http:\/\/www.w3.org\/1998\/Math\/MathML\"><semantics><mrow><mi>\u03b8<\/mi><mo stretchy=\"false\">(<\/mo><mi>k<\/mi><mo stretchy=\"false\">)<\/mo><\/mrow><annotation encoding=\"application\/x-tex\">\\theta(k)<\/annotation><\/semantics><\/math>\uff0c\u5176\u968f\u673a\u6027\u540c\u65f6\u6765\u6e90\u4e8e\u4fe1\u9053\u968f\u673a\u6027\u4e0e\u6d88\u606f\u968f\u673a\u6027\uff1b<strong>\u661f\u5ea7\u6df7\u6dc6\u4e0e\u6f84\u6e05\u6a21\u5757<\/strong>\u4e2d\uff0cAlice \u5bf9\u8c03\u5236\u7b26\u53f7 <math xmlns=\"http:\/\/www.w3.org\/1998\/Math\/MathML\"><semantics><mrow><mi>x<\/mi><mo stretchy=\"false\">(<\/mo><mi>k<\/mi><mo stretchy=\"false\">)<\/mo><\/mrow><annotation encoding=\"application\/x-tex\">x(k)<\/annotation><\/semantics><\/math> \u65bd\u52a0\u65cb\u8f6c\u52a0\u5bc6 <math xmlns=\"http:\/\/www.w3.org\/1998\/Math\/MathML\"><semantics><mrow><msub><mi>x<\/mi><mi>c<\/mi><\/msub><mo stretchy=\"false\">(<\/mo><mi>k<\/mi><mo stretchy=\"false\">)<\/mo><mo>=<\/mo><mi>x<\/mi><mo stretchy=\"false\">(<\/mo><mi>k<\/mi><mo stretchy=\"false\">)<\/mo><mo>\u22c5<\/mo><msup><mi>e<\/mi><mrow><mi>j<\/mi><mi>\u03b8<\/mi><mo stretchy=\"false\">(<\/mo><mi>k<\/mi><mo stretchy=\"false\">)<\/mo><\/mrow><\/msup><\/mrow><annotation encoding=\"application\/x-tex\">x_c(k) = x(k) \\cdot e^{j\\theta(k)}<\/annotation><\/semantics><\/math>\u540e\u53d1\u9001\uff0cBob \u5229\u7528\u81ea\u8eab CSI \u91cd\u5efa\u65cb\u8f6c\u89d2\u5e76\u6267\u884c\u9006\u65cb\u8f6c <math xmlns=\"http:\/\/www.w3.org\/1998\/Math\/MathML\"><semantics><mrow><mover accent=\"true\"><mi>x<\/mi><mo>^<\/mo><\/mover><mo stretchy=\"false\">(<\/mo><mi>k<\/mi><mo stretchy=\"false\">)<\/mo><mo>=<\/mo><msub><mi>x<\/mi><mi>c<\/mi><\/msub><mo stretchy=\"false\">(<\/mo><mi>k<\/mi><mo stretchy=\"false\">)<\/mo><mo>\u22c5<\/mo><msup><mi>e<\/mi><mrow><mo>\u2212<\/mo><mi>j<\/mi><mover accent=\"true\"><mi>\u03b8<\/mi><mo>^<\/mo><\/mover><mo stretchy=\"false\">(<\/mo><mi>k<\/mi><mo stretchy=\"false\">)<\/mo><\/mrow><\/msup><\/mrow><annotation encoding=\"application\/x-tex\">\\hat{x}(k) = x_c(k) \\cdot e^{-j\\hat{\\theta}(k)}<\/annotation><\/semantics><\/math> \u89e3\u5bc6\u3002\u7531\u4e8e Eve \u65e0\u6cd5\u83b7\u53d6\u4e0e Bob \u76f8\u5173\u7684 CSI \u4e14\u4e0d\u77e5\u6653\u524d\u4e00\u5e27\u6d88\u606f\uff0c\u5176\u63a5\u6536\u5230\u7684\u661f\u5ea7\u70b9\u5747\u5300\u5206\u5e03\u4e8e\u6574\u4e2a\u661f\u5ea7\u7a7a\u95f4\uff0c\u65e0\u6cd5\u6062\u590d\u6709\u6548\u4fe1\u606f\u3002<\/p>\n<\/div>\n<\/div>\n\n\n\n<div class=\"wp-block-uagb-advanced-heading uagb-block-dda34f26 lab-subheading\"><h3 class=\"uagb-heading-text\">\ud83d\udcca \u5b9e\u9a8c\u7ed3\u679c<\/h3><\/div>\n\n\n\n<div class=\"wp-block-group lab-paper-results is-nowrap is-layout-flex wp-container-core-group-is-layout-3a88641f wp-block-group-is-layout-flex\">\n<div class=\"wp-block-group is-vertical is-layout-flex wp-container-core-group-is-layout-831b2db5 wp-block-group-is-layout-flex\">\n<div class=\"wp-block-uagb-image uagb-block-080de2b0 wp-block-uagb-image--layout-default wp-block-uagb-image--effect-static wp-block-uagb-image--align-none wp-container-content-9cfa9a5a\"><figure class=\"wp-block-uagb-image__figure\"><img decoding=\"async\" srcset=\"http:\/\/jiushihema.github.io/pls_lab\/wp-content\/uploads\/2026\/03\/PixPin_2026-03-23_12-29-07.png ,http:\/\/jiushihema.github.io/pls_lab\/wp-content\/uploads\/2026\/03\/PixPin_2026-03-23_12-29-07.png 780w, http:\/\/jiushihema.github.io/pls_lab\/wp-content\/uploads\/2026\/03\/PixPin_2026-03-23_12-29-07.png 360w\" sizes=\"auto, (max-width: 480px) 150px\" src=\"http:\/\/jiushihema.github.io/pls_lab\/wp-content\/uploads\/2026\/03\/PixPin_2026-03-23_12-29-07.png\" alt=\"\" class=\"uag-image-1040\" width=\"802\" height=\"656\" title=\"PixPin_2026-03-23_12-29-07\" loading=\"lazy\" role=\"img\"\/><figcaption class=\"uagb-image-caption\">Fig.12<\/figcaption><\/figure><\/div>\n\n\n\n<div class=\"wp-block-uagb-image uagb-block-080de2b0 wp-block-uagb-image--layout-default wp-block-uagb-image--effect-static wp-block-uagb-image--align-none wp-container-content-9cfa9a5a\"><figure class=\"wp-block-uagb-image__figure\"><img decoding=\"async\" srcset=\"http:\/\/jiushihema.github.io/pls_lab\/wp-content\/uploads\/2026\/03\/PixPin_2026-03-23_12-28-00.png ,http:\/\/jiushihema.github.io/pls_lab\/wp-content\/uploads\/2026\/03\/PixPin_2026-03-23_12-28-00.png 780w, http:\/\/jiushihema.github.io/pls_lab\/wp-content\/uploads\/2026\/03\/PixPin_2026-03-23_12-28-00.png 360w\" sizes=\"auto, (max-width: 480px) 150px\" src=\"http:\/\/jiushihema.github.io/pls_lab\/wp-content\/uploads\/2026\/03\/PixPin_2026-03-23_12-28-00.png\" alt=\"\" class=\"uag-image-1039\" width=\"802\" height=\"656\" title=\"PixPin_2026-03-23_12-28-00\" loading=\"lazy\" role=\"img\"\/><figcaption class=\"uagb-image-caption\">Fig.14<\/figcaption><\/figure><\/div>\n<\/div>\n\n\n\n<div class=\"wp-block-group is-vertical is-layout-flex wp-container-core-group-is-layout-831b2db5 wp-block-group-is-layout-flex\">\n<p class=\"lab-experiment-caption has-medium-font-size wp-block-paragraph\"><strong>DCO \u65b9\u6848\u5728 SER = 0.1 \u65f6\u76f8\u6bd4 XOR \u65b9\u6848\u83b7\u5f97 4.5 dB SNR \u589e\u76ca\uff0c\u5728\u4fdd\u5bc6\u5bb9\u91cf\u4e2d\u65ad\u6982\u7387\u4e3a 0.1\uff08<math xmlns=\"http:\/\/www.w3.org\/1998\/Math\/MathML\"><semantics><mrow><msub><mover accent=\"true\"><mi>\u03b3<\/mi><mo>\u02c9<\/mo><\/mover><mi>w<\/mi><\/msub><mo>=<\/mo><mn>20<\/mn><\/mrow><annotation encoding=\"application\/x-tex\">\\bar{\\gamma}_w = 20<\/annotation><\/semantics><\/math>\uff09\u65f6\u4e3b\u4fe1\u9053 SNR \u589e\u76ca\u8fbe 6.5 dB<\/strong>\uff1a\u5982\u539f\u6587 <strong>Fig. 14<\/strong> \u6240\u793a\uff0c\u968f SNR \u589e\u5927\u5404\u65b9\u6848 SER \u5747\u4e0b\u964d\uff0c\u4f46 DCO \u65b9\u6848\u59cb\u7ec8\u4f18\u4e8e XOR \u65b9\u6848\uff0c\u5728 QPSK \u8c03\u5236\u4e0b SER = 0.1 \u5904\u9886\u5148 4.5 dB\uff0c\u9a8c\u8bc1\u4e86\u6a21\u62df\u52a0\u5bc6\u907f\u514d\u53cc\u91cd\u91cf\u5316\u635f\u5931\u7684\u53ef\u9760\u6027\u4f18\u52bf\u3002<strong>Fig. 12<\/strong> \u7684\u4e2d\u65ad\u6982\u7387\u66f2\u7ebf\u5219\u8868\u660e\uff0c\u5728\u76ee\u6807\u4fdd\u5bc6\u7387 <math xmlns=\"http:\/\/www.w3.org\/1998\/Math\/MathML\"><semantics><mrow><msub><mi>R<\/mi><mi>s<\/mi><\/msub><mo>=<\/mo><mn>0.1<\/mn><\/mrow><annotation encoding=\"application\/x-tex\">R_s = 0.1<\/annotation><\/semantics><\/math>\u3001<math xmlns=\"http:\/\/www.w3.org\/1998\/Math\/MathML\"><semantics><mrow><msub><mover accent=\"true\"><mi>\u03b3<\/mi><mo>\u02c9<\/mo><\/mover><mi>w<\/mi><\/msub><mo>=<\/mo><mn>20<\/mn><\/mrow><annotation encoding=\"application\/x-tex\">\\bar{\\gamma}_w = 20<\/annotation><\/semantics><\/math> dB \u6761\u4ef6\u4e0b\uff0cDCO \u65b9\u6848\u7684\u4e2d\u65ad\u6982\u7387\u66f2\u7ebf\u76f8\u5bf9 XOR \u65b9\u6848\u53f3\u79fb\u7ea6 6.5 dB\uff0c\u8bc1\u660e\u5176\u66f4\u5f3a\u7684\u4fdd\u5bc6\u5bb9\u91cf\u3002\u6b64\u5916\uff0c<strong>Fig. 13<\/strong> \u663e\u793a\u5408\u6cd5\u63a5\u6536\u65b9 SER \u63a5\u8fd1 0\uff0c\u800c\u521d\u59cb\u503c\u4ec5\u76f8\u5dee <math xmlns=\"http:\/\/www.w3.org\/1998\/Math\/MathML\"><semantics><mrow><msup><mn>10<\/mn><mrow><mo>\u2212<\/mo><mn>15<\/mn><\/mrow><\/msup><\/mrow><annotation encoding=\"application\/x-tex\">10^{-15}<\/annotation><\/semantics><\/math>10\u221215 \u7684\u975e\u6cd5\u63a5\u6536\u65b9 SER \u9ad8\u8fbe 0.7\uff0c\u76f4\u89c2\u9a8c\u8bc1\u4e86\u6df7\u6c8c\u5bc6\u94a5\u5bf9\u521d\u59cb\u503c\u7684\u9ad8\u5ea6\u654f\u611f\u6027\u3002<\/p>\n\n\n\n<div class=\"wp-block-uagb-image uagb-block-080de2b0 wp-block-uagb-image--layout-default wp-block-uagb-image--effect-static wp-block-uagb-image--align-none wp-container-content-9cfa9a5a\"><figure class=\"wp-block-uagb-image__figure\"><img decoding=\"async\" srcset=\"http:\/\/jiushihema.github.io/pls_lab\/wp-content\/uploads\/2026\/03\/PixPin_2026-03-23_12-29-16.png ,http:\/\/jiushihema.github.io/pls_lab\/wp-content\/uploads\/2026\/03\/PixPin_2026-03-23_12-29-16.png 780w, http:\/\/jiushihema.github.io/pls_lab\/wp-content\/uploads\/2026\/03\/PixPin_2026-03-23_12-29-16.png 360w\" sizes=\"auto, (max-width: 480px) 150px