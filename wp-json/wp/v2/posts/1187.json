{"id":1187,"date":"2026-07-01T12:55:52","date_gmt":"2026-07-01T12:55:52","guid":{"rendered":"http:\/\/jiushihema.github.io/pls_lab\/?p=1187"},"modified":"2026-07-17T08:18:13","modified_gmt":"2026-07-17T08:18:13","slug":"%e9%9d%a2%e5%90%91-simo-%e5%9c%ba%e6%99%af%e4%bd%8e%e6%97%b6%e5%bb%b6-5g-%e8%ae%be%e5%a4%87%e8%af%86%e5%88%ab%e7%9a%84%e4%bf%a1%e9%81%93%e9%b2%81%e6%a3%92%e5%b0%84%e9%a2%91%e6%8c%87%e7%ba%b9","status":"publish","type":"post","link":"http:\/\/jiushihema.github.io/pls_lab\/%e9%9d%a2%e5%90%91-simo-%e5%9c%ba%e6%99%af%e4%bd%8e%e6%97%b6%e5%bb%b6-5g-%e8%ae%be%e5%a4%87%e8%af%86%e5%88%ab%e7%9a%84%e4%bf%a1%e9%81%93%e9%b2%81%e6%a3%92%e5%b0%84%e9%a2%91%e6%8c%87%e7%ba%b9\/","title":{"rendered":"\u9762\u5411 SIMO \u573a\u666f\u4f4e\u65f6\u5ef6 5G \u8bbe\u5907\u8bc6\u522b\u7684\u4fe1\u9053\u9c81\u68d2\u5c04\u9891\u6307\u7eb9\u63d0\u53d6\u65b9\u6cd5"},"content":{"rendered":"\n<div class=\"wp-block-group has-global-padding is-layout-constrained wp-container-core-group-is-layout-3749991f wp-block-group-is-layout-constrained\" style=\"min-height:1000px\">\n<div class=\"wp-block-group is-vertical is-content-justification-center is-layout-flex wp-container-core-group-is-layout-458a08b5 wp-block-group-is-layout-flex\"><h2 class=\"lab-paper-title wp-block-post-title\">\u9762\u5411 SIMO \u573a\u666f\u4f4e\u65f6\u5ef6 5G \u8bbe\u5907\u8bc6\u522b\u7684\u4fe1\u9053\u9c81\u68d2\u5c04\u9891\u6307\u7eb9\u63d0\u53d6\u65b9\u6cd5<\/h2>\n\n\n<p class=\"lab-paper-meta has-small-font-size wp-block-paragraph\">Yingjie Sun and Guyue Li and Hongfu Chou and Aiqun Hu<\/p>\n\n\n\n<p class=\"lab-paper-meta has-small-font-size wp-block-paragraph\"><em>2026 IEEE Wireless Communications and Networking Conference (WCNC)<\/em><\/p>\n<\/div>\n\n\n\n<hr class=\"wp-block-separator has-text-color has-contrast-3-color has-alpha-channel-opacity has-contrast-3-background-color has-background is-style-wide\" style=\"margin-top:var(--wp--preset--spacing--20);margin-bottom:var(--wp--preset--spacing--20)\"\/>\n\n\n\n<div class=\"wp-block-group is-layout-flow wp-block-group-is-layout-flow\">\n<div class=\"wp-block-uagb-advanced-heading uagb-block-46005010 lab-subheading\"><h3 class=\"uagb-heading-text\">\ud83d\udccc Abstract (\u6458\u8981)<\/h3><\/div>\n\n\n\n<figure class=\"wp-block-pullquote has-text-align-left lab-abstract-quote has-small-font-size\" style=\"margin-right:var(--wp--preset--spacing--10);margin-left:var(--wp--preset--spacing--10);padding-top:0;padding-right:0;padding-bottom:0;padding-left:0\"><blockquote><p>\u8d85\u4f4e\u65f6\u5ef6\u662f\u7b2c\u4e94\u4ee3\u79fb\u52a8\u901a\u4fe1\uff085G\uff09\u7684\u6807\u5fd7\u6027\u7279\u5f81\uff0c\u5b83\u5bf9\u8bbe\u5907\u8bc6\u522b\u7684\u65f6\u95f4\u8981\u6c42\u4e5f\u6781\u4e3a\u4e25\u82db\u3002\u5f53\u524d\u57fa\u4e8e\u5bc6\u7801\u5b66\u7684\u65b9\u6848\u4f1a\u5f15\u5165\u989d\u5916\u8ba1\u7b97\u5f00\u9500\uff0c\u4ece\u800c\u52a0\u5267\u8bc6\u522b\u65f6\u5ef6\u3002\u5c04\u9891\u6307\u7eb9\uff08RFF\uff09\u5728\u7269\u7406\u5c42\u8bc6\u522b\u8bbe\u5907\uff0c\u53ef\u963b\u6b62\u5047\u5192\u653b\u51fb\u5e76\u663e\u8457\u964d\u4f4e\u65f6\u5ef6\u3002\u7136\u800c\uff0c\u591a\u5f84\u4fe1\u9053\u4f1a\u635f\u5bb3 RFF \u7684\u51c6\u786e\u6027\uff0c\u800c\u73b0\u6709\u7684\u4fe1\u9053\u9c81\u68d2\u65b9\u6cd5\u9700\u8981\u53cd\u9988\u6216\u8de8\u591a\u4e2a\u65f6\u95f4\u70b9\u7684\u5904\u7406\uff0c\u5e26\u6765\u4e86\u989d\u5916\u7684\u4fe1\u4ee4\u65f6\u5ef6\u3002\u4e3a\u89e3\u51b3\u8be5\u95ee\u9898\uff0c\u672c\u6587\u63d0\u51fa\u4e00\u79cd\u65b0\u7684 RFF \u63d0\u53d6\u6280\u672f\uff0c\u5229\u7528\u6765\u81ea\u591a\u6839\u63a5\u6536\u5929\u7ebf\u7684\u4fe1\u53f7\u6765\u5e94\u5bf9\u591a\u5f84\u95ee\u9898\uff0c\u4e14\u4e0d\u589e\u52a0\u65f6\u5ef6\u3002\u4e0e\u5355\u57df\u65b9\u6cd5\u4e0d\u540c\uff0c\u672c\u6587\u5229\u7528\u6765\u81ea\u591a\u5929\u7ebf\u7684\u540c\u65f6\u523b\u4fe1\u9053\u9891\u7387\u54cd\u5e94\uff08CFR\uff09\u7684\u5bf9\u6570\u7ebf\u6027\u5dee\u5206\u6bd4\uff08Log-Linear Delta Ratio, LLDR\uff09\u6765\u4fdd\u7559\u5177\u533a\u5206\u6027\u7684 RFF \u7279\u5f81\uff0c\u4ece\u800c\u6d88\u9664\u591a\u65f6\u523b\u91c7\u6837\u5e76\u7f29\u77ed\u91c7\u96c6\u65f6\u95f4\u3002\u4e3a\u514b\u670d\u5bf9\u4fe1\u9053\u53d8\u5316\u6781\u5c0f\u8fd9\u4e00\u4f9d\u8d56\u7684\u6311\u6218\uff0c\u5c06\u9891\u5e26\u5212\u5206\u4e3a\u5b50\u5e26\uff0c\u5e76\u5728\u6bcf\u4e2a\u5b50\u5e26\u5185\u5355\u72ec\u8ba1\u7b97 LLDR\u3002\u4eff\u771f\u7ed3\u679c\u8868\u660e\uff0c\u5728 20 dB \u4fe1\u566a\u6bd4\uff08SNR\uff09\u4e0b\u7684 20 \u5f84\u4fe1\u9053\u4e2d\uff0c\u6240\u63d0\u65b9\u6848\u5bf9 30 \u53f0\u7528\u6237\u8bbe\u5907\uff08UE\uff09\u8fbe\u5230 96.13% \u7684\u8bc6\u522b\u51c6\u786e\u7387\u3002\u6b64\u5916\uff0c\u57fa\u4e8e Roofline \u6a21\u578b\u8bc4\u4f30\u7684\u7406\u8bba\u65f6\u5ef6\uff0c\u5f97\u5230 0.491 ms \u7684\u7a7a\u53e3\u65f6\u5ef6\uff0c\u6ee1\u8db3\u8d85\u53ef\u9760\u4f4e\u65f6\u5ef6\u901a\u4fe1\uff08URLLC\uff09\u7684\u65f6\u5ef6\u8981\u6c42\u3002<\/p><\/blockquote><\/figure>\n\n\n\n<div class=\"wp-block-uagb-advanced-heading uagb-block-6adec98e lab-subheading\"><h3 class=\"uagb-heading-text\">\ud83d\udca1 Key Contributions (\u6838\u5fc3\u8d21\u732e)<\/h3><\/div>\n\n\n\n<ul start=\"1\" style=\"border-style:none;border-width:0px\" class=\"wp-block-list lab-feature-list\">\n<li class=\"lab-feature-list\"><strong>\u63d0\u51fa\u5229\u7528\u591a\u5929\u7ebf\u63a5\u6536\u4fe1\u53f7\u7684\u65b0\u578b RFF \u65b9\u6848<\/strong>\uff1a\u4ec5\u9700\u5355\u6b21\u4e0a\u884c\u4f20\u8f93\u5373\u53ef\u51cf\u8f7b\u591a\u5f84\u4fe1\u9053\u5f71\u54cd\uff0c\u4ece\u800c\u964d\u4f4e\u8bc6\u522b\u65f6\u5ef6\uff0c\u5e76\u53ef\u4ece\u7406\u8bba\u4e0a\u8bc1\u660e\u8be5\u65b9\u6cd5\u5bf9\u591a\u5f84\u4fe1\u9053\u5177\u6709\u9c81\u68d2\u6027\u3002<\/li>\n\n\n\n<li class=\"lab-feature-list\"><strong>\u8ba1\u7b97 CFR \u95f4\u7684\u5bf9\u6570\u7ebf\u6027\u5dee\u5206\u6bd4\uff08LLDR\uff09\u200b<\/strong>\uff1a\u533a\u522b\u4e8e\u4f20\u7edf\u5355\u57df\u4fe1\u53f7\u5904\u7406\uff1b\u4e3a\u5e94\u5bf9 CFR \u6ce2\u52a8\uff0c\u5c06\u9891\u5e26\u5206\u5272\u5e76\u5728\u6bcf\u4e2a\u5e73\u6ed1\u5b50\u5e26\u5185\u63d0\u53d6 RFF \u7279\u5f81\u3002<\/li>\n\n\n\n<li class=\"lab-feature-list\"><strong>\u57fa\u4e8e MATLAB 5G NR Toolbox \u7684\u4eff\u771f\u9a8c\u8bc1<\/strong>\uff1a\u5bf9 30 \u53f0\u865a\u62df UE \u4e0e\u4e0d\u540c SNR \u8fdb\u884c\u4eff\u771f\uff0c\u7ed3\u679c\u8868\u660e\u5728 TDL 20 \u5f84\u4fe1\u9053\u3001SNR \u4e3a 20 dB \u65f6\u8fbe\u5230 96.13% \u51c6\u786e\u7387\u3001\u7a7a\u53e3\u65f6\u5ef6 0.491 ms\uff0c\u6ee1\u8db3 URLLC \u65f6\u5ef6\u8981\u6c42\u3002<\/li>\n<\/ul>\n\n\n\n<div class=\"wp-block-uagb-advanced-heading uagb-block-2f9d57f4 lab-subheading\"><h3 class=\"uagb-heading-text\">\ud83d\udd27 Method Overview\uff08\u65b9\u6cd5\u6982\u89c8\uff09<\/h3><\/div>\n\n\n\n<div class=\"wp-block-group lab-paper-results is-nowrap is-layout-flex wp-container-core-group-is-layout-83d1bd77 wp-block-group-is-layout-flex\" style=\"margin-top:0;margin-bottom:0;padding-right:0;padding-left:0\">\n<div class=\"wp-block-group is-vertical is-layout-flex wp-container-core-group-is-layout-8da03e20 wp-block-group-is-layout-flex\" style=\"margin-top:0;margin-bottom:0;padding-top:0;padding-right:0;padding-bottom:0;padding-left:0\">\n<div class=\"wp-block-uagb-image uagb-block-db58d614 wp-block-uagb-image--layout-default wp-block-uagb-image--effect-static wp-block-uagb-image--align-none wp-container-content-9cfa9a5a\"><figure class=\"wp-block-uagb-image__figure\"><img decoding=\"async\" srcset=\"http:\/\/jiushihema.github.io/pls_lab\/wp-content\/uploads\/2026\/07\/77080c0d-bf4d-452d-8783-db1e8d8486ad.png ,http:\/\/jiushihema.github.io/pls_lab\/wp-content\/uploads\/2026\/07\/77080c0d-bf4d-452d-8783-db1e8d8486ad.png 780w, http:\/\/jiushihema.github.io/pls_lab\/wp-content\/uploads\/2026\/07\/77080c0d-bf4d-452d-8783-db1e8d8486ad.png 360w\" sizes=\"auto, (max-width: 480px) 150px\" src=\"http:\/\/jiushihema.github.io/pls_lab\/wp-content\/uploads\/2026\/07\/77080c0d-bf4d-452d-8783-db1e8d8486ad.png\" alt=\"\" class=\"uag-image-1189\" width=\"295\" height=\"230\" title=\"77080c0d-bf4d-452d-8783-db1e8d8486ad\" loading=\"lazy\" role=\"img\"\/><\/figure><\/div>\n<\/div>\n\n\n\n<div class=\"wp-block-group is-vertical is-layout-flex wp-container-core-group-is-layout-831b2db5 wp-block-group-is-layout-flex\">\n<p class=\"lab-experiment-caption has-medium-font-size wp-block-paragraph\"><strong>\u7cfb\u7edf\u4e0e\u4fe1\u53f7\u6a21\u578b\uff1a<\/strong>\u5728 SIMO \u7cfb\u7edf\u4e2d\uff0c\u53cc\u63a5\u6536\u5929\u7ebf\u4e0a\u7684\u9891\u57df\u63a5\u6536\u4fe1\u53f7\u4e3a $Y_1(k)=R_1(k)H_1(k)T(k)X(k)+N_1(k)$\u3001$Y_2(k)=R_2(k)H_2(k)T(k)X(k)+N_2(k)$\uff0c\u5176\u4e2d $T(k)$ \u4e3a\u53d1\u5c04\u7f3a\u9677\uff0c$R_1(k),R_2(k)$ \u4e3a\u63a5\u6536\u7f3a\u9677\uff0c$H_1(k),H_2(k)$ \u4e3a CFR\u3002\u4fe1\u9053\u4f30\u8ba1\u7ed3\u679c $Z_1(k)\\approx R_1(k)H_1(k)T(k)$\u3001$Z_2(k)\\approx R_2(k)H_2(k)T(k)$\u4e2d\u53e0\u52a0\u7684\u4fe1\u9053\u9879\u963b\u788d\u4e86\u7a33\u5b9a RFF \u7684\u76f4\u63a5\u83b7\u53d6\u3002<\/p>\n\n\n\n<p class=\"lab-experiment-caption has-small-font-size wp-block-paragraph\"><strong>LLDR \u63d0\u53d6\u4e0e\u5b50\u5e26\u5904\u7406\uff1a<\/strong>\u5c06\u9891\u5e26\u5212\u5206\u4e3a\u5b50\u5e26\u4ee5\u4fdd\u8bc1 CFR \u5e73\u6ed1\uff0c\u5728\u5b50\u5e26\u5185\u4ee5\u5747\u503c $\\hat{a}_1,\\hat{a}_2$ \u5f52\u4e00\u5316\u3002\u5b9a\u4e49\u5929\u7ebf\u95f4\u76f8\u5bf9\u635f\u4f24 $r=\\frac{R_2(k)}{R_1(k)}$\uff0c\u6784\u9020\u7ebf\u6027\u5dee\u5206 $D_{12}(k)=Z_{1,norm}(k)-\\frac{1}{r}Z_{2,norm}(k)$\u4e0e\u5bf9\u6570\u5dee\u5206 $L_{12}(k)=\\ln r+\\ln\\frac{Z_{1,norm}(k)}{Z_{2,norm}(k)}$\u3002\u57fa\u4e8e\u4e00\u9636\u6cf0\u52d2\u8fd1\u4f3c $\\ln x\\approx\\Delta x$\uff0c\u53d6\u4e8c\u8005\u4e4b\u6bd4\u5f97\u5230 RFF \u4f30\u8ba1 $\\hat{T}_0(k)=\\frac{D_{12}(k)}{L_{12}(k)}\\approx T_0(k)$\uff0c\u5176\u7ed3\u679c\u72ec\u7acb\u4e8e $H_1(k),H_2(k)$\uff0c\u5b9e\u73b0\u591a\u5f84\u6291\u5236\uff1b\u9010\u5b50\u5e26\u91cd\u590d\u5e76\u62fc\u63a5\u5373\u5f97\u4fe1\u9053\u9c81\u68d2 RFF\uff0c\u518d\u9001\u5165 CNN \u8fdb\u884c\u8bc6\u522b\u3002<\/p>\n<\/div>\n<\/div>\n\n\n\n<div class=\"wp-block-uagb-advanced-heading uagb-block-46951038 lab-subheading\"><h3 class=\"uagb-heading-text\">\ud83d\udcca Experimental Results (\u5b9e\u9a8c\u7ed3\u679c)<\/h3><\/div>\n\n\n\n<div class=\"wp-block-group lab-paper-results is-nowrap is-layout-flex wp-container-core-group-is-layout-3a88641f wp-block-group-is-layout-flex\">\n<div class=\"wp-block-group is-vertical is-layout-flex wp-container-core-group-is-layout-831b2db5 wp-block-group-is-layout-flex\">\n<div class=\"wp-block-group is-vertical is-layout-flex wp-container-core-group-is-layout-831b2db5 wp-block-group-is-layout-flex\">\n<div class=\"wp-block-uagb-image uagb-block-a3591eb7 wp-block-uagb-image--layout-default wp-block-uagb-image--effect-static wp-block-uagb-image--align-none\"><figure class=\"wp-block-uagb-image__figure\"><img decoding=\"async\" srcset=\"http:\/\/jiushihema.github.io/pls_lab\/wp-content\/uploads\/2026\/07\/746a3f74-370f-49f7-a1f3-45b4ee534733-1.png ,http:\/\/jiushihema.github.io/pls_lab\/wp-content\/uploads\/2026\/07\/746a3f74-370f-49f7-a1f3-45b4ee534733-1.png 780w, http:\/\/jiushihema.github.io/pls_lab\/wp-content\/uploads\/2026\/07\/746a3f74-370f-49f7-a1f3-45b4ee534733-1.png 360w\" sizes=\"auto, (max-width: 480px) 150px\" src=\"http:\/\/jiushihema.github.io/pls_lab\/wp-content\/uploads\/2026\/07\/746a3f74-370f-49f7-a1f3-45b4ee534733-1.png\" alt=\"\" class=\"uag-image-1204\" width=\"760\" height=\"588\" title=\"746a3f74-370f-49f7-a1f3-45b4ee534733\" loading=\"lazy\" role=\"img\"\/><\/figure><\/div>\n\n\n\n<div class=\"wp-block-uagb-image uagb-block-14bb0b9c wp-block-uagb-image--layout-default wp-block-uagb-image--effect-static wp-block-uagb-image--align-none wp-container-content-9cfa9a5a\"><figure class=\"wp-block-uagb-image__figure\"><img decoding=\"async\" srcset=\"http:\/\/jiushihema.github.io/pls_lab\/wp-content\/uploads\/2026\/07\/158aa649-6565-4efa-a707-3d26f4ee076f.png ,http:\/\/jiushihema.github.io/pls_lab\/wp-content\/uploads\/2026\/07\/158aa649-6565-4efa-a707-3d26f4ee076f.png 780w, http:\/\/jiushihema.github.io/pls_lab\/wp-content\/uploads\/2026\/07\/158aa649-6565-4efa-a707-3d26f4ee076f.png 360w\" sizes=\"auto, (max-width: 480px) 150px\" src=\"http:\/\/jiushihema.github.io/pls_lab\/wp-content\/uploads\/2026\/07\/158aa649-6565-4efa-a707-3d26f4ee076f.png\" alt=\"\" class=\"uag-image-1190\" width=\"802\" height=\"656\" title=\"158aa649-6565-4efa-a707-3d26f4ee076f\" loading=\"lazy\" role=\"img\"\/><\/figure><\/div>\n<\/div>\n<\/div>\n\n\n\n<div class=\"wp-block-group is-vertical is-layout-flex wp-container-core-group-is-layout-831b2db5 wp-block-group-is-layout-flex\">\n<div class=\"wp-block-uagb-image uagb-block-f74d106b wp-block-uagb-image--layout-default wp-block-uagb-image--effect-static wp-block-uagb-image--align-none\"><figure class=\"wp-block-uagb-image__figure\"><img decoding=\"async\" srcset=\"http:\/\/jiushihema.github.io/pls_lab\/wp-content\/uploads\/2026\/07\/9e6c75e7-ce1b-41f6-8930-f5f766302353.png ,http:\/\/jiushihema.github.io/pls_lab\/wp-content\/uploads\/2026\/07\/9e6c75e7-ce1b-41f6-8930-f5f766302353.png 780w, http:\/\/jiushihema.github.io/pls_lab\/wp-content\/uploads\/2026\/07\/9e6c75e7-ce1b-41f6-8930-f5f766302353.png 360w\" sizes=\"auto, (max-width: 480px) 150px\" src=\"http:\/\/jiushihema.github.io/pls_lab\/wp-content\/uploads\/2026\/07\/9e6c75e7-ce1b-41f6-8930-f5f766302353.png\" alt=\"\" class=\"uag-image-1205\" width=\"775\" height=\"652\" title=\"9e6c75e7-ce1b-41f6-8930-f5f766302353\" loading=\"lazy\" role=\"img\"\/><\/figure><\/div>\n\n\n\n<p class=\"lab-experiment-caption has-medium-font-size wp-block-paragraph\"><strong>\u6240\u63d0\u65b9\u6848\u5728\u591a\u5f84\u4fe1\u9053\u4e0b\u663e\u8457\u4f18\u4e8e\u5404\u57fa\u7ebf\u65b9\u6cd5\uff0c\u540c\u65f6\u6ee1\u8db3 URLLC \u65f6\u5ef6\u8981\u6c42<\/strong>\uff1a\u5982 Fig. 7 \u6240\u793a\uff0c\u5728 25 dB SNR \u4e0b\uff0c\u6240\u63d0\u65b9\u6cd5\u4ee5 96.2% \u51c6\u786e\u7387\u4f18\u4e8e\u6240\u6709\u57fa\u7ebf\uff0cBenchmark1 \u4e3a 61.83%\u3001Benchmark2 \u4e3a 62.4%\u3001DoLoS \u4e3a 83.67%\u3002\u6b64\u5916\uff0cFig. 5 \u663e\u793a\u5728 4 \u4e2a\u5b50\u8f7d\u6ce2\u3001SNR \u8d85 20 dB \u65f6\u8fbe 96.43%\uff1bFig. 6 \u663e\u793a UE \u6570\u4e3a 30\u3001SNR \u5927\u4e8e 10 dB \u65f6\u51c6\u786e\u7387\u53ef\u8fbe 95.4% \u4ee5\u4e0a\uff0cUE \u6570\u5c11\u4e8e 20 \u65f6\u53ef\u8fbe 98.2%\u3002\u65f6\u5ef6\u65b9\u9762\uff0c\u4f30\u8ba1 $T_{UE}=34.64\\,\\mu s$\u3001$T_{RFFI}=81.04\\,\\mu s$\uff0c\u7ed3\u5408 $T_{TTI}=0.25\\,ms$\u3001$T_f=0.125\\,ms$\uff0c\u6574\u4f53\u7406\u8bba\u65f6\u5ef6 $T_{air}\\approx 0.491\\,ms&lt;1\\,ms$\uff0c\u6ee1\u8db3 ITU-R IMT-2020 \u7684 URLLC \u8981\u6c42\u3002<\/p>\n<\/div>\n<\/div>\n\n\n\n<div class=\"wp-block-uagb-advanced-heading uagb-block-e3c2d50d lab-subheading\"><h3 class=\"uagb-heading-text\">\ud83d\udcdd Cite This Paper (\u5f15\u7528\u683c\u5f0f)<\/h3><\/div>\n\n\n\n<pre class=\"wp-block-code lab-bibtex-code has-small-font-size\"><code>@inproceedings{sun2026channelrobust,\n  author    = {Yingjie Sun and Guyue Li and Hongfu Chou and Aiqun Hu},\n  title     = {Channel-Robust RFF for Low-Latency 5G Device Identification in SIMO Scenarios},\n  booktitle = {2026 IEEE Wireless Communications and Networking Conference (WCNC)},\n  year      = {2026}\n}\n<\/code><\/pre>\n<\/div>\n\n\n\n<hr class=\"wp-block-separator has-alpha-channel-opacity is-style-wide\" style=\"margin-top:var(--wp--preset--spacing--20);margin-bottom:var(--wp--preset--spacing--20)\"\/>\n\n\n\n<div class=\"wp-block-group is-layout-flow wp-block-group-is-layout-flow\">\n<div style=\"height:100px\" aria-hidden=\"true\" class=\"wp-block-spacer\"><\/div>\n\n\n\n<div class=\"wp-block-group is-content-justification-space-between is-nowrap is-layout-flex wp-container-core-group-is-layout-788841da wp-block-group-is-layout-flex\">\n\n<\/div>\n<\/div>\n<\/div>\n","protected":false},"excerpt":{"rendered":"<p>\u8d85\u4f4e\u65f6\u5ef6\u662f\u7b2c\u4e94\u4ee3\u79fb\u52a8\u901a\u4fe1\uff085G\uff09\u7684\u6807\u5fd7\u6027\u7279\u5f81\uff0c\u5b83\u5bf9\u8bbe\u5907\u8bc6\u522b\u7684\u65f6\u95f4\u8981\u6c42\u4e5f\u6781\u4e3a\u4e25\u82db\u3002\u5f53\u524d\u57fa\u4e8e\u5bc6\u7801\u5b66\u7684\u65b9\u6848\u4f1a\u5f15\u5165\u989d\u5916\u8ba1\u7b97\u5f00\u9500\uff0c\u4ece\u800c\u52a0\u5267\u8bc6\u522b\u65f6\u5ef6\u3002\u5c04\u9891\u6307\u7eb9\uff08RFF\uff09\u5728\u7269\u7406\u5c42\u8bc6\u522b\u8bbe\u5907\uff0c\u53ef\u963b\u6b62\u5047\u5192\u653b\u51fb\u5e76\u663e\u8457\u964d\u4f4e\u65f6\u5ef6\u3002\u7136\u800c\uff0c\u591a\u5f84\u4fe1\u9053\u4f1a\u635f\u5bb3 RFF \u7684\u51c6\u786e\u6027\uff0c\u800c\u73b0\u6709\u7684\u4fe1\u9053\u9c81\u68d2\u65b9\u6cd5\u9700\u8981\u53cd\u9988\u6216\u8de8\u591a\u4e2a\u65f6\u95f4\u70b9\u7684\u5904\u7406\uff0c\u5e26\u6765\u4e86\u989d\u5916\u7684\u4fe1\u4ee4\u65f6\u5ef6\u3002\u4e3a\u89e3\u51b3\u8be5\u95ee\u9898\uff0c\u672c\u6587\u63d0\u51fa\u4e00\u79cd\u65b0\u7684 RFF \u63d0\u53d6\u6280\u672f\uff0c\u5229\u7528\u6765\u81ea\u591a\u6839\u63a5\u6536\u5929\u7ebf\u7684\u4fe1\u53f7\u6765\u5e94\u5bf9\u591a\u5f84\u95ee\u9898\uff0c\u4e14\u4e0d\u589e\u52a0\u65f6\u5ef6\u3002\u4e0e\u5355\u57df\u65b9\u6cd5\u4e0d\u540c\uff0c\u672c\u6587\u5229\u7528\u6765\u81ea\u591a\u5929\u7ebf\u7684\u540c\u65f6\u523b\u4fe1\u9053\u9891\u7387\u54cd\u5e94\uff08CFR\uff09\u7684\u5bf9\u6570\u7ebf\u6027\u5dee\u5206\u6bd4\uff08Log-Linear Delta Ratio, LLDR\uff09\u6765\u4fdd\u7559\u5177\u533a\u5206\u6027\u7684 RFF \u7279\u5f81\uff0c\u4ece\u800c\u6d88\u9664\u591a\u65f6\u523b\u91c7\u6837\u5e76\u7f29\u77ed\u91c7\u96c6\u65f6\u95f4\u3002\u4e3a\u514b\u670d\u5bf9\u4fe1\u9053\u53d8\u5316\u6781\u5c0f\u8fd9\u4e00\u4f9d\u8d56\u7684\u6311\u6218\uff0c\u5c06\u9891\u5e26\u5212\u5206\u4e3a\u5b50\u5e26\uff0c\u5e76\u5728\u6bcf\u4e2a\u5b50\u5e26\u5185\u5355\u72ec\u8ba1\u7b97 LLDR\u3002\u4eff\u771f\u7ed3\u679c\u8868\u660e\uff0c\u5728 20 dB \u4fe1\u566a\u6bd4\uff08SNR\uff09\u4e0b\u7684 20 \u5f84\u4fe1\u9053\u4e2d\uff0c\u6240\u