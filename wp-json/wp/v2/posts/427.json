{"id":427,"date":"2026-01-29T10:48:19","date_gmt":"2026-01-29T10:48:19","guid":{"rendered":"http:\/\/localhost:10005\/?p=427"},"modified":"2026-01-29T10:48:20","modified_gmt":"2026-01-29T10:48:20","slug":"aircraft-recognition-rff-few-shot-ads-b-siamese-network","status":"publish","type":"post","link":"http:\/\/jiushihema.github.io/pls_lab\/aircraft-recognition-rff-few-shot-ads-b-siamese-network\/","title":{"rendered":"\u57fa\u4e8e\u771f\u5b9eADS-B\u4fe1\u53f7\u7684\u98de\u673a\u5c04\u9891\u6307\u7eb9\u8bc6\u522b"},"content":{"rendered":"\n<h3 class=\"wp-block-heading\">\u7814\u7a76\u80cc\u666f<\/h3>\n\n\n\n<p>\u5e7f\u64ad\u5f0f\u81ea\u52a8\u76f8\u5173\u76d1\u89c6\uff08ADS-B\uff09\u662f\u73b0\u4ee3\u822a\u7a7a\u76d1\u89c6\u7684\u6838\u5fc3\u6280\u672f\u3002\u5229\u7528 ADS-B \u4fe1\u53f7\u7684\u5c04\u9891\u6307\u7eb9\uff08RFF\uff09\u53ef\u4ee5\u6709\u6548\u8bc6\u522b\u975e\u6cd5\u4f2a\u9020\u4fe1\u53f7\uff0c\u4fdd\u969c\u7a7a\u57df\u5b89\u5168\u3002\u7136\u800c\uff0c\u5728\u5b9e\u9645\u90e8\u7f72\u4e2d\uff0c\u6211\u4eec\u9762\u4e34\u4e09\u5927\u6311\u6218\uff1a<\/p>\n\n\n\n<ol start=\"1\" class=\"wp-block-list\">\n<li><strong>\u73af\u5883\u566a\u58f0\u5927\uff1a<\/strong> \u5b9e\u9645\u63a5\u6536\u5230\u7684 ADS-B \u4fe1\u53f7\u4fe1\u566a\u6bd4\u4f4e\uff0c\u6307\u7eb9\u7279\u5f81\u63d0\u53d6\u56f0\u96be\u3002<\/li>\n\n\n\n<li><strong>\u6570\u636e\u83b7\u53d6\u96be\uff1a<\/strong> \u83b7\u53d6\u5927\u91cf\u5e26\u6709\u660e\u786e\u8eab\u4efd\u6807\u7b7e\u7684\u771f\u5b9e\u98de\u673a\u4fe1\u53f7\u8017\u65f6\u8017\u529b\u3002<\/li>\n\n\n\n<li><strong>\u8fc7\u62df\u5408\u98ce\u9669\uff1a<\/strong> \u4f20\u7edf\u6df1\u5ea6\u5b66\u4e60\u6a21\u578b\u5728\u4ec5\u5229\u7528\u5c11\u91cf\u6837\u672c\u8bad\u7ec3\u65f6\uff0c\u6781\u6613\u51fa\u73b0\u8fc7\u62df\u5408\u73b0\u8c61\u3002<\/li>\n<\/ol>\n\n\n\n<h3 class=\"wp-block-heading\">ZP\u9884\u5904\u7406\u4e0e\u5b6a\u751f\u7f51\u7edc<\/h3>\n\n\n\n<div class=\"wp-block-group is-nowrap is-layout-flex wp-container-core-group-is-layout-6c531013 wp-block-group-is-layout-flex\">\n<figure class=\"wp-block-image size-full\"><img decoding=\"async\" width=\"601\" height=\"407\" src=\"http:\/\/localhost:10005\/wp-content\/uploads\/2026\/01\/32490bcc-5062-4a72-8b91-b086115163e0.png\" alt=\"\" class=\"wp-image-429\" srcset=\"http:\/\/jiushihema.github.io/pls_lab\/wp-content\/uploads\/2026\/01\/32490bcc-5062-4a72-8b91-b086115163e0.png 601w, http:\/\/jiushihema.github.io/pls_lab\/wp-content\/uploads\/2026\/01\/32490bcc-5062-4a72-8b91-b086115163e0-300x203.png 300w\" sizes=\"(max-width: 601px) 100vw, 601px\" \/><\/figure>\n\n\n\n<figure class=\"wp-block-image size-full\"><img decoding=\"async\" width=\"623\" height=\"690\" src=\"http:\/\/localhost:10005\/wp-content\/uploads\/2026\/01\/1ec186fc-42a0-45ee-9cf3-36ff7cbe3fb8.png\" alt=\"\" class=\"wp-image-430\" srcset=\"http:\/\/jiushihema.github.io/pls_lab\/wp-content\/uploads\/2026\/01\/1ec186fc-42a0-45ee-9cf3-36ff7cbe3fb8.png 623w, http:\/\/jiushihema.github.io/pls_lab\/wp-content\/uploads\/2026\/01\/1ec186fc-42a0-45ee-9cf3-36ff7cbe3fb8-271x300.png 271w\" sizes=\"(max-width: 623px) 100vw, 623px\" \/><\/figure>\n<\/div>\n\n\n\n<p>\u9488\u5bf9\u4e0a\u8ff0\u95ee\u9898\uff0c\u6211\u4eec\u8bbe\u8ba1\u4e86\u4e00\u5957\u5b8c\u6574\u7684\u8bc6\u522b\u6846\u67b6\uff1a<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li><strong>\u6570\u636e\u9884\u5904\u7406\uff1a<\/strong> \u5f15\u5165 <strong>\u8865\u96f6\uff08Zero Padding, ZP\uff09<\/strong> \u9884\u5904\u7406\u6280\u672f\uff08\u5982\u56fe1\u5de6\u4fa7\u6240\u793a\uff09\uff0c\u5c06\u4e0d\u540c\u957f\u5ea6\u7684\u4fe1\u53f7\u7edf\u4e00\u5316\uff0c\u4fdd\u7559\u539f\u59cb\u4fe1\u53f7\u7684\u65f6\u5e8f\u7279\u5f81\u3002<\/li>\n\n\n\n<li><strong>\u5b6a\u751f\u7f51\u7edc\u67b6\u6784\uff1a<\/strong> \u91c7\u7528 <strong>\u5b6a\u751f\u7f51\u7edc\uff08Siamese Network\uff09<\/strong> \u7ed3\u6784\u3002\u5982\u56fe1\u53f3\u4fa7\u6240\u793a\uff0c\u8be5\u7f51\u7edc\u5305\u542b\u4e24\u4e2a\u6743\u503c\u5171\u4eab\u7684\u7279\u5f81\u63d0\u53d6\u5668\u3002\u5b83\u4e0d\u662f\u76f4\u63a5\u5bf9\u5355\u4e2a\u6837\u672c\u8fdb\u884c\u5206\u7c7b\uff0c\u800c\u662f\u901a\u8fc7\u8ba1\u7b97\u4e24\u4e2a\u6837\u672c\u4e4b\u95f4\u7684\u6b27\u6c0f\u8ddd\u79bb\u6765\u5224\u65ad\u5b83\u4eec\u662f\u5426\u5c5e\u4e8e\u540c\u4e00\u67b6\u98de\u673a\u3002\u8fd9\u79cd\u673a\u5236\u4f7f\u5176\u975e\u5e38\u9002\u5408\u5c0f\u6837\u672c\u5b66\u4e60\u573a\u666f\u3002<\/li>\n<\/ul>\n\n\n\n<h3 class=\"wp-block-heading\">\u4e24\u9636\u6bb5\u8bad\u7ec3\u7b56\u7565<\/h3>\n\n\n\n<figure class=\"wp-block-image size-full\"><img decoding=\"async\" width=\"947\" height=\"668\" src=\"http:\/\/localhost:10005\/wp-content\/uploads\/2026\/01\/8ee4ceaf-a5d5-4001-a35c-4dd5a7a5a83a.png\" alt=\"\" class=\"wp-image-428\" srcset=\"http:\/\/jiushihema.github.io/pls_lab\/wp-content\/uploads\/2026\/01\/8ee4ceaf-a5d5-4001-a35c-4dd5a7a5a83a.png 947w, http:\/\/jiushihema.github.io/pls_lab\/wp-content\/uploads\/2026\/01\/8ee4ceaf-a5d5-4001-a35c-4dd5a7a5a83a-300x212.png 300w, http:\/\/jiushihema.github.io/pls_lab\/wp-content\/uploads\/2026\/01\/8ee4ceaf-a5d5-4001-a35c-4dd5a7a5a83a-768x542.png 768w\" sizes=\"(max-width: 947px) 100vw, 947px\" \/><\/figure>\n\n\n\n<p>\u4e3a\u4e86\u8fdb\u4e00\u6b65\u63d0\u5347\u6a21\u578b\u7684\u6cdb\u5316\u80fd\u529b\uff0c\u6211\u4eec\u91c7\u7528\u4e86\u5206\u9636\u6bb5\u7684\u8bad\u7ec3\u7b56\u7565\uff08\u5982\u56fe2\uff09\uff1a<\/p>\n\n\n\n<ol start=\"1\" class=\"wp-block-list\">\n<li><strong>\u8bad\u7ec3\u9636\u6bb5 1\uff08\u9884\u8bad\u7ec3\uff09\uff1a<\/strong> \u5c06\u6210\u5bf9\u7684 ADS-B \u4fe1\u53f7\u8f93\u5165\u5b6a\u751f\u7f51\u7edc\uff0c\u5229\u7528\u5bf9\u6bd4\u635f\u5931\u51fd\u6570\u8fdb\u884c\u8bad\u7ec3\uff0c\u4f7f\u7f51\u7edc\u5b66\u4f1a\u533a\u5206\u201c\u76f8\u540c\u201d\u4e0e\u201c\u4e0d\u540c\u201d\u7684\u98de\u673a\u7279\u5f81\u3002<\/li>\n\n\n\n<li><strong>\u8bad\u7ec3\u9636\u6bb5 2\uff08\u5fae\u8c03\uff09\uff1a<\/strong> \u56fa\u5b9a\u7279\u5f81\u63d0\u53d6\u5668\u53c2\u6570\uff0c\u63a5\u5165\u5168\u8fde\u63a5\u5c42\uff08MLP\uff09\uff0c\u4f7f\u7528\u5c11\u91cf\u6709\u6807\u7b7e\u6570\u636e\u5bf9\u5206\u7c7b\u5668\u8fdb\u884c\u5fae\u8c03\uff0c\u6784\u5efa RFF \u6570\u636e\u5e93\u3002<\/li>\n\n\n\n<li><strong>\u6d4b\u8bd5\u9636\u6bb5\uff1a<\/strong> \u5bf9\u4e8e\u65b0\u8f93\u5165\u7684\u98de\u673a\u4fe1\u53f7\uff0c\u76f4\u63a5\u901a\u8fc7\u8bad\u7ec3\u597d\u7684\u6a21\u578b\u4e0e\u6570\u636e\u5e93\u6bd4\u5bf9\uff0c\u8f93\u51fa\u9884\u6d4b\u7ed3\u679c\u3002<\/li>\n<\/ol>\n\n\n\n<p><strong>(Block: \u6bb5\u843d)<\/strong> \u5b9e\u9a8c\u8bc1\u660e\uff0c\u8be5\u65b9\u6cd5\u5728\u4ec5\u6709\u5c11\u91cf\u6807\u7b7e\u6837\u672c\u7684\u60c5\u51b5\u4e0b\uff0c\u4f9d\u7136\u80fd\u591f\u4fdd\u6301\u8f83\u9ad8\u7684\u8bc6\u522b\u51c6\u786e\u7387\uff0c\u663e\u8457\u4f18\u4e8e\u4f20\u7edf\u7684\u5377\u79ef\u795e\u7ecf\u7f51\u7edc\u65b9\u6cd5\u3002<\/p>\n\n\n\n<h3 class=\"wp-block-heading\">\u8bba\u6587\u4fe1\u606f<\/h3>\n\n\n\n<blockquote class=\"wp-block-quote is-layout-flow wp-block-quote-is-layout-flow\" style=\"padding-top:0;padding-bottom:0\">\n<p data-wp-context---core-fit-text=\"core\/fit-text::{&quot;fontSize&quot;:&quot;&quot;}\" data-wp-init---core-fit-text=\"core\/fit-text::callbacks.init\" data-wp-interactive data-wp-style--font-size=\"core\/fit-text::context.fontSize\" class=\"has-fit-text\" style=\"line-height:5\">Z. Zhang, G. Li, J. Shi, H. Li and A.<strong> Hu<\/strong>, \u201cReal-World aircraft recognition based on RF Fingerprinting with Few Labeled ADS-B Signals\u201d, submitted to <strong>IEEE Trans. on Vehicular Technology<\/strong>, 2023. (Major revision) (Q1, IF=6.8)<\/p>\n<\/blockquote>\n","protected":false},"excerpt":{"rendered":"<p>\u5728\u771f\u5b9e\u822a\u7a7a\u73af\u5883\u4e2d\uff0c\u83b7\u53d6\u5927\u91cf\u6709\u6807\u7b7e\u7684\u98de\u673a ADS-B \u4fe1\u53f7\u6781\u5176\u56f0\u96be\uff0c\u4e14\u4fe1\u53f7\u5e38\u53d7\u5f3a\u566a\u58f0\u5e72\u6270\u3002\u9488\u5bf9\u8fd9\u4e00\u201c\u5c0f\u6837\u672c\u201d\u96be\u9898\uff0c\u672c\u8bfe\u9898\u7ec4\u63d0\u51fa\u4e86\u4e00\u79cd\u7ed3\u5408\u8865\u96f6\uff08ZP\uff09\u9884\u5904\u7406\u4e0e\u5b6a\u751f\u7f51\u7edc\uff08Siamese Network\uff09\u7684\u5c04\u9891\u6307\u7eb9\u8bc6\u522b\u65b0\u6846\u67b6\u3002\u8be5\u65b9\u6cd5\u901a\u8fc7\u6743\u503c\u5171\u4eab\u548c\u4e24\u9636\u6bb5\u8bad\u7ec3\u7b56\u7565\uff0c\u6709\u6548\u89e3\u51b3\u4e86\u8fc7\u62df\u5408\u95ee\u9898\uff0c\u5728\u5c11\u91cf\u6807\u7b7e\u6570\u636e\u4e0b\u5b9e\u73b0\u4e86\u9ad8\u7cbe\u5ea6\u7684\u98de\u673a\u8eab\u4efd\u8ba4\u8bc1\u3002<\/p>\n","protected":false},"author":1,"featured_media":428,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"_uag_custom_page_level_css":"","footnotes":""},"categories":[5],"tags":[],"class_list":["post-427","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-research"],"uagb_featured_image_src":{"full":["http:\/\/jiushihema.github.io/pls_lab\/wp-content\/uploads\/2026\/01\/8ee4ceaf-a5d5-4001-a35c-4dd5a7a5a83a.png",947,668,false],"thumbnail":["http:\/\/jiushihema.github.io/pls_lab\/wp-content\/uploads\/2026\/01\/8ee4ceaf-a5d5-4001-a35c-4dd5a7a5a83a-150x150.png",150,150,true],"medium":["http:\/\/jiushihema.github.io/pls_lab\/wp-content\/uploads\/2026\/01\/8ee4ceaf-a5d5-4001-a35c-4dd5a7a5a83a-300x212.png",300,212,true],"medium_large":["http:\/\/jiushihema.github.io/pls_lab\/wp-content\/uploads\/2026\/01\/8ee4ceaf-a5d5-4001-a35c-4dd5a7a5a83a-768x542.png",768,542,true],"large":["http:\/\/jiushihema.github.io/pls_lab\/wp-content\/uploads\/2026\/01\/8ee4ceaf-a5d5-4001-a35c-4dd5a7a5a83a.png",947,668,false],"1536x1536":["http:\/\/jiushihema.github.io/pls_lab\/wp-content\/uploads\/2026\/01\/8ee4ceaf-a5d5-4001-a35c-4dd5a7a5a83a.png",947,668,false],"2048x2048":["http:\/\/jiushihema.github.io/pls_lab\/wp-content\/uploads\/2026\/01\/8ee4ceaf-a5d5-4001-a35c-4dd5a7a5a83a.png",947,668,false]},"uagb_author_info":{"display_name":"jiushihema","author_link":"http:\/\/jiushihema.githu