{"id":1499,"date":"2026-08-25T12:22:15","date_gmt":"2026-08-25T12:22:15","guid":{"rendered":"http:\/\/jiushihema.github.io/pls_lab\/?page_id=1499"},"modified":"2026-08-26T17:29:36","modified_gmt":"2026-08-26T17:29:36","slug":"teacher","status":"publish","type":"page","link":"http:\/\/jiushihema.github.io/pls_lab\/teacher\/","title":{"rendered":""},"content":{"rendered":"\n<p class=\"wp-block-paragraph\"><style>\n\/* ===== \u9875\u9762\u5bb9\u5668 ===== *\/\n.pls-teacher-page,\n.pls-teacher-page * {\n  box-sizing: border-box;\n}\n\n.pls-teacher-page {\n  --pls-blue: #0b3768;\n  --pls-blue-dark: #082b52;\n  --pls-heading: #172333;\n  --pls-text: #4f5965;\n  --pls-muted: #7b8590;\n  --pls-line: #e5e8ec;\n  width: 1000px !important;\n  max-width: 1500px !important;\n  margin: 46px auto !important;\n  padding: 0 24px;\n  transform: none !important;\n  color: var(--pls-text);\n  font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", \"PingFang SC\",\n    \"Microsoft YaHei\", Arial, sans-serif;\n  font-size: 13px;\n  line-height: 1.8;\n}\n\n.pls-teacher-page a {\n  color: #236b9e;\n  text-decoration: none;\n}\n\n.pls-teacher-page a:hover {\n  color: var(--pls-blue);\n  text-decoration: underline;\n}\n\n\/* ===== \u5b8c\u6574\u53cc\u680f\u5e03\u5c40 ===== *\/\n.pls-teacher-layout {\n  display: grid;\n  grid-template-columns: minmax(210px, 230px) minmax(0, 1fr);\n  gap: 24px;\n  align-items: start;\n}\n\n\/* ===== \u5de6\u680f\uff1a\u59cb\u7ec8\u53ea\u653e\u4e2a\u4eba\u4fe1\u606f ===== *\/\n.pls-teacher-sidebar {\n  position: sticky;\n  top: 110px;\n  z-index: 2;\n  align-self: start;\n  padding: 12px 34px 28px 0;\n  border-right: 1px solid var(--pls-line);\n  background: #fff;\n}\n\n.pls-teacher-photo {\n  width: 150px;\n  height: 205px;\n  margin: 0 0 16px;\n  border-radius: 50% \/ 45%;\n  object-fit: cover;\n  object-position: center 16%;\n  box-shadow: 0 0 0 1px #dfe3e7, 0 8px 22px rgba(0, 0, 0, 0.08);\n}\n\n.pls-teacher-name {\n  margin: 0;\n  color: var(--pls-heading);\n  font-size: 1.65rem;\n  line-height: 1.3;\n}\n\n.pls-teacher-name-en {\n  margin: 4px 0 18px;\n  color: var(--pls-muted);\n  font-size: 0.96rem;\n}\n\n.pls-teacher-contact {\n  padding-top: 17px;\n  border-top: 1px solid var(--pls-line);\n  font-size: 0.89rem;\n  overflow-wrap: anywhere;\n}\n\n.pls-teacher-contact a {\n  display: block;\n  margin-bottom: 8px;\n}\n\n.pls-teacher-meta {\n  margin: 18px 0 0;\n  padding: 17px 0 0;\n  border-top: 1px solid var(--pls-line);\n  color: var(--pls-muted);\n  font-size: 0.88rem;\n  line-height: 1.7;\n}\n\n\/* ===== \u53f3\u680f\uff1a\u5168\u90e8\u8be6\u7ec6\u5185\u5bb9 ===== *\/\n.pls-teacher-content {\n  min-width: 0;\n  padding-right: 8px;\n  background: #fff;\n}\n\n.pls-teacher-title {\n  margin: 0;\n  color: var(--pls-heading);\n  font-size: 2.45rem;\n  line-height: 1.3;\n}\n\n.pls-teacher-title span {\n  color: #9aa2ab;\n  font-weight: 400;\n}\n\n.pls-teacher-subtitle {\n  margin: 8px 0 32px;\n  color: var(--pls-muted);\n  font-size: 1rem;\n}\n\n.pls-teacher-section {\n  margin-top: 44px;\n}\n\n.pls-teacher-section:first-of-type {\n  margin-top: 0;\n}\n\n.pls-teacher-section h2 {\n  margin: 0 0 18px;\n  padding-bottom: 9px;\n  border-bottom: 1px solid var(--pls-line);\n  color: var(--pls-heading);\n  font-size: 1.35rem;\n  line-height: 1.4;\n}\n\n.pls-teacher-section h2::before {\n  content: \"\";\n  display: inline-block;\n  width: 4px;\n  height: 1em;\n  margin-right: 10px;\n  vertical-align: -0.1em;\n  border-radius: 2px;\n  background: var(--pls-blue);\n}\n\n.pls-teacher-section p {\n  margin: 0 0 15px;\n}\n\n.pls-teacher-section strong {\n  color: var(--pls-heading);\n}\n\n.pls-intro-lead strong {\n  color: var(--pls-blue);\n}\n\n\/* ===== \u7814\u7a76\u9886\u57df\u4e0e\u666e\u901a\u5217\u8868 ===== *\/\n.pls-research-list,\n.pls-bullet-list {\n  margin: 0;\n  padding-left: 1.25em;\n}\n\n.pls-research-list li,\n.pls-bullet-list li {\n  margin-bottom: 10px;\n  padding-left: 4px;\n}\n\n.pls-research-list strong,\n.pls-research-list span {\n  display: block;\n}\n\n.pls-research-list span {\n  color: var(--pls-muted);\n  font-size: 0.92rem;\n}\n\n\/* ===== \u6559\u80b2\u80cc\u666f\u4e0e\u5b66\u672f\u517c\u804c ===== *\/\n.pls-academic-grid {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 42px;\n}\n\n.pls-academic-grid h3 {\n  margin: 0 0 10px;\n  color: var(--pls-heading);\n  font-size: 1rem;\n}\n\n.pls-timeline {\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.pls-timeline li {\n  display: grid;\n  grid-template-columns: 98px minmax(0, 1fr);\n  gap: 15px;\n  padding: 10px 0;\n  border-bottom: 1px solid var(--pls-line);\n}\n\n.pls-timeline time {\n  color: var(--pls-blue);\n  font-size: 0.86rem;\n  font-weight: 700;\n}\n\n.pls-timeline strong,\n.pls-timeline span {\n  display: block;\n}\n\n.pls-timeline span {\n  color: var(--pls-muted);\n  font-size: 0.9rem;\n}\n\n.pls-academic-grid ul {\n  margin: 0;\n  padding-left: 1.2em;\n}\n\n.pls-academic-grid li {\n  margin-bottom: 8px;\n  font-size: 0.92rem;\n}\n\n\/* ===== \u6210\u679c\u6309\u94ae ===== *\/\n.pls-result-button {\n  display: inline-block;\n  padding: 7px 14px;\n  border-radius: 3px;\n  background: var(--pls-blue);\n  color: #fff !important;\n  font-size: 0.84rem;\n  font-weight: 600;\n  text-decoration: none !important;\n}\n\n.pls-result-button:hover {\n  background: var(--pls-blue-dark);\n}\n\n\/* ===== \u7a84\u5c4f\uff1a\u6539\u4e3a\u4e0a\u4e0b\u6392\u5217 ===== *\/\n@media (max-width: 900px) {\n  .pls-teacher-page {\n    width: calc(100% - 32px) !important;\n    margin: 32px auto !important;\n    padding: 0;\n    transform: none !important;\n  }\n\n  .pls-teacher-layout {\n    grid-template-columns: 1fr;\n    gap: 38px;\n  }\n\n  .pls-teacher-sidebar {\n  position: sticky;\n  top: 110px;\n  z-index: 2;\n  align-self: start;\n  padding: 12px 34px 28px 0;\n  border-right: 1px solid var(--pls-line);\n  background: #fff;\n}\n\n  .pls-teacher-photo {\n    width: 170px;\n    height: 170px;\n    margin-right: auto;\n    margin-left: auto;\n  }\n\n  .pls-teacher-contact,\n  .pls-teacher-meta {\n    max-width: 340px;\n    margin-right: auto;\n    margin-left: auto;\n  }\n\n  .pls-teacher-title {\n    font-size: 1.95rem;\n  }\n\n  .pls-academic-grid {\n    grid-template-columns: 1fr;\n    gap: 28px;\n  }\n}\n`r`n\n\/* \u4ec5\u7edf\u4e00\u80cc\u666f\u8272\uff0c\u4e0d\u6539\u53d8\u5c3a\u5bf8\u548c\u914d\u8272 *\/\nbody:has(.pls-teacher-page),\nbody:has(.pls-teacher-page) .wp-site-blocks,\nbody:has(.pls-teacher-page) .wp-block-post-content,\n.pls-teacher-page,\n.pls-teacher-sidebar,\n.pls-teacher-content,\n.pls-research-card {\n  background: #fff !important;\n}\n\n\/* WordPress \u4e2d\u5305\u4f4f\u77ed\u4ee3\u7801\u7684\u533a\u5757\u80cc\u666f *\/\n.wp-block-post-content p:has(.pls-teacher-page),\n.wp-block-post-content .wp-block-paragraph:has(.pls-teacher-page),\n.wp-block-post-content:has(.pls-teacher-page) {\n  background-color: #fff !important;\n}\n<\/style>\n\n<div class=\"pls-teacher-page\">\n  <div class=\"pls-teacher-layout\">\n    <!-- \u5de6\u680f\uff1a\u53ea\u653e\u7167\u7247\u548c\u7b80\u8981\u4fe1\u606f -->\n    <aside class=\"pls-teacher-sidebar\">\n      <!-- \u5c06 lgy.jpg \u66ff\u6362\u6210 WordPress \u5a92\u4f53\u5e93\u4e2d\u7684\u5b8c\u6574\u56fe\u7247\u5730\u5740 -->\n      <img decoding=\"async\" class=\"pls-teacher-photo\" src=\"\/wp-content\/uploads\/2026\/01\/e0843d8e-e948-4f08-a0e2-defef9699ae6.png\" alt=\"\u674e\u53e4\u6708\u8001\u5e08\">\n\n      <h2 class=\"pls-teacher-name\">\u674e\u53e4\u6708<\/h2>\n      <p class=\"pls-teacher-name-en\">Guyue Li<\/p>\n\n      <div class=\"pls-teacher-contact\">\n        <a href=\"mailto:guyuelee@seu.edu.cn\">guyuelee@seu.edu.cn<\/a>\n        <a href=\"https:\/\/scholar.google.com\/citations?user=dsi9hPEAAAAJ&amp;hl=zh-CN\" target=\"_blank\" rel=\"noopener\">\n          Google Scholar \u2197\n        <\/a>\n      <\/div>\n\n      <p class=\"pls-teacher-meta\">\n        \u4e1c\u5357\u5927\u5b66\u7f51\u7edc\u7a7a\u95f4\u5b89\u5168\u5b66\u9662<br>\n        \u526f\u6559\u6388\u3001\u535a\u58eb\u751f\u5bfc\u5e08<br>\n        \u5357\u4eac\uff0c\u4e2d\u56fd\n      <\/p>\n    <\/aside>\n\n    <!-- \u53f3\u680f\uff1a\u5168\u90e8\u8be6\u7ec6\u4fe1\u606f\uff0c\u968f\u9875\u9762\u6eda\u52a8 -->\n    <main class=\"pls-teacher-content\">\n      <h1 class=\"pls-teacher-title\">\u674e\u53e4\u6708 <span>\/ Guyue Li<\/span><\/h1>\n      <p class=\"pls-teacher-subtitle\">Physical Layer Security Laboratory, Southeast University<\/p>\n\n      <!-- \u4e2a\u4eba\u7b80\u4ecb -->\n      <section class=\"pls-teacher-section\">\n        <h2>\u4e2a\u4eba\u7b80\u4ecb<\/h2>\n        <p class=\"pls-intro-lead\"><strong>\u674e\u53e4\u6708<\/strong>\uff0c\u4e1c\u5357\u5927\u5b66\u7f51\u7edc\u7a7a\u95f4\u5b89\u5168\u5b66\u9662\u526f\u6559\u6388\uff0c\u535a\u5bfc\uff0c2017\u5e74\u4e8e\u4e1c\u5357\u5927\u5b66\u83b7\u5f97\u535a\u58eb\u5b66\u4f4d\uff0c\u5bfc\u5e08\u4e3a\u80e1\u7231\u7fa4\u6559\u6388\u30022014\u5e74\u53d7\u6b27\u7f8eFP7\u9879\u76ee\u8d44\u52a9\u8bbf\u5b66\u5766\u4f69\u96f7\u7406\u5de5\u5927\u5b66\uff0c2019\u5e74\u53d7\u4e2d\u6cd5\u8521\u5143\u57f9\u9879\u76ee\u8d44\u52a9\u5728ESIEE PARIS\u5927\u5b66\u4f5c\u77ed\u671f\u8bbf\u95ee\uff0c2024\u5e74\u30012025\u5e74\u8fde\u7eed\u4e24\u5e74\u88ab\u8bc4\u9009\u4e3a\u201c<strong>\u65af\u5766\u798f\u5168\u7403\u524d2%\u79d1\u5b66\u5bb6<\/strong>\u201d\u3002\u76ee\u524d\u4e3b\u8981\u7814\u7a76\u65b9\u5411\u4e3a\u7269\u7406\u5c42\u5b89\u5168\u3001\u65e0\u7ebf\u901a\u4fe1\u5b89\u5168\u53ca\u7269\u8054\u7f51\u5b89\u5168\u7b49\u3002IEEE\u4f1a\u5458\u3001\u4e2d\u56fd\u8ba1\u7b97\u673a\u5b66\u4f1a\u4f1a\u5458\u3001\u4e2d\u56fd\u901a\u4fe1\u5b66\u4f1a\u9ad8\u7ea7\u4f1a\u5458\u3001\u6c5f\u82cf\u7701\u7f51\u7edc\u7a7a\u95f4\u5b89\u5168\u5b66\u4f1a\u4f1a\u5458\u3002\u62c5\u4efb\u56fd\u9645SCI\u671f\u520aEURASIP Journal on Wireless Communications and Networking\u526f\u4e3b\u7f16\u3001IEEE Communications Letters\u7f16\u8f91\uff0c\u4ee5\u53caIEEE VTC\u7269\u7406\u5c42\u5b89\u5168\u7814\u8ba8\u4f1a\u8054\u5408\u4e3b\u5e2d\u3002\u4ee5\u7b2c\u4e00\u4f5c\u8005\u6216\u901a\u8baf\u4f5c\u8005\u5728IEEE Transactions on Information Forensics and Security\u3001IEEE Transactions on Communications\u3001IEEE Wireless Communications\u3001IEEE INFOCOM\u7b49\u56fd\u9645\u4e00\u6d41\u671f\u520a\u548c\u4f1a\u8bae\u4e0a\u53d1\u8868\u8bba\u658730\u4f59\u7bc7\u3002<\/p>\n      <\/section>\n\n      <!-- \u7814\u7a76\u9886\u57df -->\n  <section class=\"pls-teacher-section\">\n    <h2>\u7814\u7a76\u9886\u57df<\/h2>\n    <ul class=\"pls-research-list\">\n      <li><strong>\u7269\u7406\u5c42\u5bc6\u94a5\u751f\u6210<\/strong><span>\u7814\u7a76 TDD\u3001FDD\u3001IBFD \u7b49\u7cfb\u7edf\u4e0b\u57fa\u4e8e\u65e0\u7ebf\u4fe1\u9053\u4e92\u6613\u6027\u7684\u5bc6\u94a5\u751f\u6210\u65b9\u6cd5\u4e0e\u5b89\u5168\u6027\u3002<\/span><\/li>\n      <li><strong>\u5c04\u9891\u6307\u7eb9\u8bc6\u522b<\/strong><span>\u5229\u7528\u8bbe\u5907\u786c\u4ef6\u5dee\u5f02\u5b9e\u73b0\u65e0\u7ebf\u76ee\u6807\u8bc6\u522b\u3001\u8ba4\u8bc1\u548c\u590d\u6742\u4fe1\u9053\u4e0b\u7684\u53ef\u4fe1\u63a5\u5165\u3002<\/span><\/li>\n      <li><strong>\u65e0\u7ebf\u5185\u751f\u5b89\u5168<\/strong><span>\u9762\u5411 5G-A\/6G \u7814\u7a76\u8f7b\u91cf\u7ea7\u7a7a\u53e3\u5b89\u5168\u4f20\u8f93\u3001\u6ce2\u675f\u8d4b\u5f62\u3001\u4eba\u5de5\u566a\u58f0\u53ca MIMO-OFDM \u6280\u672f\u3002<\/span><\/li>\n      <li><strong>\u7269\u8054\u7f51\u5b89\u5168<\/strong><span>\u7814\u7a76\u6d77\u91cf\u7ec8\u7aef\u63a5\u5165\u3001\u94fe\u8def\u6307\u7eb9\u3001\u96f6\u4fe1\u4efb\u65e0\u7ebf\u7f51\u7edc\u548c\u91cf\u5b50\u5bc6\u94a5\u878d\u5408\u5b89\u5168\u6280\u672f\u3002<\/span><\/li>\n    <\/ul>\n  <\/section>\n\n  <!-- \u6559\u80b2\u80cc\u666f\u4e0e\u5b66\u672f\u517c\u804c -->\n  <section class=\"pls-teacher-section\">\n    <h2>\u6559\u80b2\u80cc\u666f\u4e0e\u5b66\u672f\u517c\u804c<\/h2>\n    <div class=\"pls-academic-grid\">\n      <div>\n        <h3>\u6559\u80b2\u53ca\u8bbf\u95ee\u7ecf\u5386<\/h3>\n        <ol class=\"pls-timeline\">\n          <li><time>2019\u20132020<\/time><div><strong>\u4ea4\u6d41\u8bbf\u95ee<\/strong><span>ESIEE Paris\uff0c\u6cd5\u56fd<\/span><\/div><\/li>\n          <li><time>2017<\/time><div><strong>\u5de5\u5b66\u535a\u58eb<\/strong><span>\u4fe1\u606f\u4e0e\u901a\u4fe1\u5de5\u7a0b\uff0c\u4e1c\u5357\u5927\u5b66<\/span><\/div><\/li>\n          <li><time>2014<\/time><div><strong>\u4ea4\u6d41\u8bbf\u5b66<\/strong><span>\u5766\u4f69\u96f7\u7406\u5de5\u5927\u5b66\uff0c\u82ac\u5170<\/span><\/div><\/li>\n          <li><time>2011<\/time><div><strong>\u5de5\u5b66\u5b66\u58eb<\/strong><span>\u4fe1\u606f\u79d1\u5b66\u4e0e\u5de5\u7a0b\uff0c\u4e1c\u5357\u5927\u5b66<\/span><\/div><\/li>\n        <\/ol>\n      <\/div>\n\n      <div>\n        <h3>\u5b66\u672f\u517c\u804c<\/h3>\n        <ul>\n          <li>IEEE Communications Letters \u7f16\u8f91<\/li>\n          <li>EURASIP JWCN \u526f\u4e3b\u7f16<\/li>\n          <li>IEEE VTC \u7269\u7406\u5c42\u5b89\u5168\u7814\u8ba8\u4f1a\u8054\u5408\u4e3b\u5e2d<\/li>\n          <li>IEEE \u4f1a\u5458\u3001\u4e2d\u56fd\u901a\u4fe1\u5b66\u4f1a\u9ad8\u7ea7\u4f1a\u5458<\/li>\n          <li>IEEE TIFS\u3001JSAC\u3001TWC\u3001TCOM \u7b49\u671f\u520a\u5ba1\u7a3f\u4eba<\/li>\n          <li>IEEE ICC\u3001GLOBECOM \u7b49\u4f1a\u8bae\u7a0b\u5e8f\u59d4\u5458\u4f1a\u59d4\u5458<\/li>\n        <\/ul>\n      <\/div>\n    <\/div>\n  <\/section>\n\n  <!-- \u7814\u7a76\u8bfe\u9898\uff1a\u53ef\u76f4\u63a5\u589e\u5220 li -->\n  <section class=\"pls-teacher-section\">\n    <h2>\u7814\u7a76\u8bfe\u9898<\/h2>\n    <ul class=\"pls-bullet-list\">\n      <li>\u56fd\u5bb6\u81ea\u7136\u79d1\u5b66\u57fa\u91d1\u9762\u4e0a\u9879\u76ee\uff0c62571117\uff0c\u65e0\u7ebf\u7269\u7406\u5c42\u5bc6\u94a5\u751f\u6210\u65b9\u6cd5\u7684\u5b89\u5168\u6027\u7814\u7a76\uff0c2026\/01\u20132029\/12\uff0c51\u4e07\u5143\uff0c\u4e3b\u6301\u3002<\/li>\n      <li>\u6280\u88c5\u9879\u76ee\uff0cXXX\uff0c2025\/01\/01\u20132028\/12\/12\uff0c300\u4e07\u5143\uff0c\u53c