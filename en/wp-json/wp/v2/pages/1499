n  color: #fff !important;\n  font-size: 0.84rem;\n  font-weight: 600;\n  text-decoration: none !important;\n}\n\n.pls-result-button:hover {\n  background: var(--pls-blue-dark);\n}\n\n\/* ===== \u7a84\u5c4f\uff1a\u6539\u4e3a\u4e0a\u4e0b\u6392\u5217 ===== *\/\n@media (max-width: 900px) {\n  .pls-teacher-page {\n    width: calc(100% - 32px) !important;\n    margin: 32px auto !important;\n    padding: 0;\n    transform: none !important;\n  }\n\n  .pls-teacher-layout {\n    grid-template-columns: 1fr;\n    gap: 38px;\n  }\n\n  .pls-teacher-sidebar {\n  position: sticky;\n  top: 110px;\n  z-index: 2;\n  align-self: start;\n  padding: 12px 34px 28px 0;\n  border-right: 1px solid var(--pls-line);\n  background: #fff;\n}\n\n  .pls-teacher-photo {\n    width: 170px;\n    height: 170px;\n    margin-right: auto;\n    margin-left: auto;\n  }\n\n  .pls-teacher-contact,\n  .pls-teacher-meta {\n    max-width: 340px;\n    margin-right: auto;\n    margin-left: auto;\n  }\n\n  .pls-teacher-title {\n    font-size: 1.95rem;\n  }\n\n  .pls-academic-grid {\n    grid-template-columns: 1fr;\n    gap: 28px;\n  }\n}\n\n\n\/* \u4ec5\u7edf\u4e00\u80cc\u666f\u8272\uff0c\u4e0d\u6539\u53d8\u5c3a\u5bf8\u548c\u914d\u8272 *\/\nbody:has(.pls-teacher-page),\nbody:has(.pls-teacher-page) .wp-site-blocks,\nbody:has(.pls-teacher-page) .wp-block-post-content,\n.pls-teacher-page,\n.pls-teacher-sidebar,\n.pls-teacher-content,\n.pls-research-card {\n  background: #fff !important;\n}\n\n\/* WordPress \u4e2d\u5305\u4f4f\u77ed\u4ee3\u7801\u7684\u533a\u5757\u80cc\u666f *\/\n.wp-block-post-content p:has(.pls-teacher-page),\n.wp-block-post-content .wp-block-paragraph:has(.pls-teacher-page),\n.wp-block-post-content:has(.pls-teacher-page) {\n  background-color: #fff !important;\n}\n<\/style>\n\n<div class=\"pls-teacher-page\">\n  <div class=\"pls-teacher-layout\">\n    <!-- \u5de6\u680f\uff1a\u53ea\u653e\u7167\u7247\u548c\u7b80\u8981\u4fe1\u606f -->\n    <aside class=\"pls-teacher-sidebar\">\n      <!-- \u5c06 lgy.jpg \u66ff\u6362\u6210 WordPress \u5a92\u4f53\u5e93\u4e2d\u7684\u5b8c\u6574\u56fe\u7247\u5730\u5740 -->\n      <img decoding=\"async\" class=\"pls-teacher-photo\" src=\"\/wp-content\/uploads\/2026\/01\/e0843d8e-e948-4f08-a0e2-defef9699ae6.png\" alt=\"\u674e\u53e4\u6708\u8001\u5e08\">\n\n      <h2 class=\"pls-teacher-name\">Li Guyue<\/h2>\n      <p class=\"pls-teacher-name-en\">Guyue Li<\/p>\n\n      <div class=\"pls-teacher-contact\">\n        <a href=\"mailto:guyuelee@seu.edu.cn\">guyuelee@seu.edu.cn<\/a>\n        <a href=\"https:\/\/scholar.google.com\/citations?user=dsi9hPEAAAAJ&amp;hl=zh-CN\" target=\"_blank\" rel=\"noopener\">\n          Google Scholar \u2197\n        <\/a>\n      <\/div>\n\n      <p class=\"pls-teacher-meta\">\n        School of Cyber Science and Engineering, Southeast University<br>\n        Associate Professor, Doctoral Supervisor<br>\n        Nanjing, China\n      <\/p>\n    <\/aside>\n\n    <!-- \u53f3\u680f\uff1a\u5168\u90e8\u8be6\u7ec6\u4fe1\u606f\uff0c\u968f\u9875\u9762\u6eda\u52a8 -->\n    <main class=\"pls-teacher-content\">\n      <h1 class=\"pls-teacher-title\">Li Guyue <span>\/ Guyue Li<\/span><\/h1>\n      <p class=\"pls-teacher-subtitle\">Physical Layer Security Laboratory, Southeast University<\/p>\n\n      <section class=\"pls-teacher-section\">\n        <h2>Biography<\/h2>\n        <p class=\"pls-intro-lead\"><strong>Associate Professor and doctoral supervisor at the School of Cyber Science and Engineering, Southeast University.<\/strong>He received his Ph.D. degree from Southeast University in 2017, under the supervision of Professor Hu Aiqun. In 2014, he was funded by the EU FP7 project to visit Tampere University of Technology in Finland; in 2019, he was funded by the Sino-French Cai Yuanpei Project to conduct short-term visiting research at ESIEE PARIS in France; from March to May 2024, he visited The Hong Kong Polytechnic University as a visiting scholar for collaborative exchange. He was consecutively named to the Stanford Top 2% Scientists list in 2024 and 2025. His main research interests include Physical Layer Security, wireless communication security, and IoT security. He has published over 40 papers as first author or corresponding author in top international journals and conferences such as IEEE Transactions on Information Forensics and Security, IEEE Transactions on Communications, IEEE Wireless Communications, and IEEE INFOCOM. He is currently a member of IEEE, a member of the China Computer Federation, a senior member of the China Institute of Communications, and a member of the Jiangsu Province Cyberspace Security Association.\n\t\t<p>His research style favors \u201csmall but exquisite\u201d work, with passion as the core driving force of scientific research. He looks forward to recruiting like-minded students to jointly explore frontier problems and conduct meaningful research. He is currently recruiting Ph.D. students, as well as master's students in both Nanjing and Wuxi. Welcome to join.<\/p>\n\t\t<\/p>\n      <\/section>\n\n      <section class=\"pls-teacher-section\">\n    <h2>Research Areas<\/h2>\n    <div class=\"pls-research-grid\">\n      <div class=\"pls-research-card\"><strong>Physical Layer Secret Key Generation<\/strong><span>Research on secret key generation, distribution, and security driven by wireless channel reciprocity.<\/span><\/div>\n      <div class=\"pls-research-card\"><strong>RF Fingerprinting<\/strong><span>Leveraging device hardware differences to achieve wireless device identification, authentication, and trusted access.<\/span><\/div>\n      <div class=\"pls-research-card\"><strong>Wireless Intrinsic Security<\/strong><span>Research on air interface secure transmission and wireless communication attack-defense technologies for 5G-A and 6G.<\/span><\/div>\n      <div class=\"pls-research-card\"><strong>IoT Security<\/strong><span>Research on massive terminal access, device fingerprinting, link fingerprinting, and zero-trust security.<\/span><\/div>\n      <div class=\"pls-research-card\"><strong>Wi-Fi sensing and privacy protection<\/strong><span>Research on privacy leakage risks, protection mechanisms, and secure sensing methods in Wi-Fi sensing.<\/span><\/div>\n      <div class=\"pls-research-card\"><strong>Wireless attack and defense<\/strong><span>Research on attack detection, adversarial defense, and security assessment for wireless communication and IoT scenarios.<\/span><\/div>\n    <\/div>\n  <\/section>\n\n  <!-- \u6559\u80b2\u80cc\u666f\u4e0e\u5b66\u672f\u517c\u804c -->\n  <section class=\"pls-teacher-section\">\n    <h2>Education and Academic Service<\/h2>\n    <div class=\"pls-academic-grid\">\n      <div>\n        <h3>Education and Visiting Experience<\/h3>\n        <ol class=\"pls-timeline\">\n          <li><time>2019\u20132020<\/time><div><strong>Exchange Visit<\/strong><span>ESIEE Paris, France<\/span><\/div><\/li>\n          <li><time>2017<\/time><div><strong>Doctor of Engineering<\/strong><span>Information and Communication Engineering, Southeast University<\/span><\/div><\/li>\n          <li><time>2014<\/time><div><strong>Visiting Scholar<\/strong><span>Tampere University of Technology, Finland<\/span><\/div><\/li>\n          <li><time>2011<\/time><div><strong>Bachelor of Engineering<\/strong><span>Information Science and Engineering, Southeast University<\/span><\/div><\/li>\n        <\/ol>\n      <\/div>\n\n      <div>\n        <h3>Academic Service<\/h3>\n        <ul>\n          <li>Editor of IEEE Communications Letters<\/li>\n          <li>Associate Editor of IEEE TIFS<\/li>\n          <li>Associate Editor, EURASIP JWCN<\/li>\n          <li>Co-Chair, IEEE VTC Physical Layer Security Workshop<\/li>\n          <li>IEEE member, CCF member, senior member of China Institute of Communications, member of Jiangsu Cyberspace Security Association<\/li>\n          <li>Reviewer for IEEE TCOM, IEEE JSAC, IEEE TWC<\/li>\n          <li>Program Committee Member for IEEE ICC, IEEE GLOBECOM<\/li>\n        <\/ul>\n      <\/div>\n    <\/div>\n  <\/section>\n\n  <!-- \u7814\u7a76\u8bfe\u9898\uff1a\u53ef\u76f4\u63a5\u589e\u5220 li -->\n  <section class=\"pls-teacher-section\">\n    <h2>Research Projects<\/h2>\n    <ul class=\"pls-bullet-list\">\n      <li>National Natural Science Foundation of China General Program, 62571117, Research on Security of Wireless Physical Layer Secret Key Generation Methods, 2026\/01\u20132029\/12, 510,000 CNY, PI.<\/li>\n      <li>Equipment Development Project, XXX, 2025\/01\/01\u20132028\/12\/12, 3,000,000 CNY, Participant.<\/li>\n      <li>Jiangsu Frontier Technology R&amp;D Program, BF2025067, Quantum Key Security Technology Development for 5G-A Intelligent IoT, 2025\/09\/01, 5,000,000 CNY, Participant.<\/li>\n      <li>Jiangsu Frontier Technology R&amp;D Program Project, BF2024065, Intrinsic Security Technology Development for Industrial Wireless Networks Based on Multimodal Large Models, 2024\/09\/01\u2013Present, 750,000 CNY, PI.<\/li>\n      <li>National Key R&amp;D Program Sub-project, 2022YFB2902202, 6G Intrinsic Security Integrating New Air-Interface Enabling Technologies, 2022\/11\/01\u20132025\/10\/31, 585,000 CNY, PI.<\/li>\n      <li>Open Project of Key Laboratory of Ministry of Education, KLCS20240107, Research on Privacy Situation Awareness Technology in the Context of Wi-Fi Integrated Sensing and Communication, 2024\/07\/01\u20132025\/06\/30, 75,000 CNY, PI.<\/li>\n      <li>Jiangsu Basic Research Program Project, BK20222001, Fundamental Research on 6G Blockchain Wireless Networks in Zero-Trust Environments, 2022\/09\/01\u20132027\/08\/31, Participant.<\/li>\n      <li>National Natural Science Foundation of China Joint Fund Sub-project, U22A2001, Research on Intrinsic Security Theory and Implementation Methods of One-Time Pad in Wireless Communications and RIS-Based Physical Layer Secret Key Generation, 2023\/01\u20132026\/12, 480,000 CNY, PI.<\/li>\n      <li>Corporate Technology Development Project, Validation of Terminal Access Authentication Model Effectiveness, 2022\/11\/01\u20132023\/10\/30, 192,000 CNY, PI.<\/li>\n      <li>General Program of National Natural Science Foundation of China, 62171121, Research on Lightweight Air Interface Secure Transmission Theory and Methods for Massive Users, 2022\/01\u20132025\/12, 570,000 CNY, Principal Investigator.<\/li>\n      <li>General Program of Jiangsu Provincial Natural Science Foundation, BK20211160, Research on Air Interface Endogenous Secure Transmission Theory and Methods for 5G Massive IoT, 2021\/07\u20132024\/06, 100,000 CNY, Principal Investigator.<\/li>\n      <li>Key Special Project of International Scientific and Technological Innovation Cooperation under the National Key R&amp;D Program, 2020YFE0200600, Joint R&amp;D on IoT Security Architecture and Key Technologies Based on Quantum Keys, 2020\/06\u20132023\/05, 8.35 million CNY, Participant.<\/li>\n      <li>Industrial Prospect and Key Core Technology Project of Jiangsu Provincial Key R&amp;D Program, BE2019109, Research and Application of Edge Access Security Technology for Power IoT, 2019\/06\u20132022\/06, 2.5 million CNY, Participant.<\/li>\n      <li>Basic Scientific Research Support Project, Research on Key Technologies for IoT Edge Secure Access, 2019\/03\u20132021\/03, 40,000 CNY, Principal Investigator.<\/li>\n      <li>Young Scientists Fund of the National Natural Science Foundation of China, 61801115, Research on Secret Key Generation Methods for FDD Channels in Mobile Communications, 2019\/01\u20132021\/12, 225,000 CNY, Principal Investigator.<\/li>\n      <li>Science and Technology Service Project, 8509010002, Outsourced R&amp;D Service Procurement for Wireless Access Security Management Platform Based on Device Fingerprint Technology, 2018\/09\u20132019\/12, 1.161 million CNY, Principal Investigator.<\/li>\n      <li>Startup Fund for New Faculty, 3209008202, Research on Physical Layer Security Technologies Based on FDD Channel Characteristics, 2018\/03\u20132019\/12, 100,000 CNY, Principal Investigator.<\/li>\n      <li>Young Scientists Fund of the National Natural Science Foundation of China, 61602113, Research on Wireless Target Identification and Localization Technologies Based on RF Fingerprinting, 2017\/01\u20132019\/12, 210,000 CNY, Participant.<\/li>\n      <li>Young Scientists Fund of the National Natural Science Foundation of China, 61601114, Research on Identification and Authentication Security Technologies Based on Physical Layer Fingerprints in Optical Communication Systems, 2017\/01\u20132019\/12, 220,000 CNY, Participant.<\/li>\n      <li>Young Scientists Project of Jiangsu Provincial Natural Science Foundation, BK20160692, Wireless Communication Security Technologies Based on Physical Layer Characteristics, 2016\/07\u20132019\/06, 200,000 CNY, Participant.<\/li>\n      <li>General Program of National Natural Science Foundation of China, 61571110, Research on Physical Layer Security Technologies for Future Mobile Communications, 2016\/01\u20132019\/12, 570,000 CNY, Participant.<\/li>\n    <\/ul>\n  <\/section>\n\n  <!-- \u8363\u8a89\u5956\u9879\uff1a\u53ef\u76f4\u63a5\u589e\u5220 li -->\n  <section class=\"pls-teacher-section\">\n    <h2>Awards and Honors<\/h2>\n    <ul class=\"pls-bullet-list\">\n      <li>2025 Teaching Award of the Chinese Association for Cryptologic Research<\/li>\n      <li>2025 Stanford Top 2% Scientists Worldwide<\/li>\n      <li>2024 Stanford Top 2% Scientists Worldwide<\/li>\n      <li>\u201cR&amp;D and Industrialization of IoT Security Technologies Based on Quantum Keys\u201d selected as one of the Top Ten Scientific and Technological Advances in Jiangsu Province's Industry Sector for 2024<\/li>\n      <li>2023 Second \u201cOutstanding Teaching Award\u201d of Southeast University\u201d<\/li>\n      <li>2022 Third Prize of Jiangsu Provincial Science and Technology Award<\/li>\n      <li>Third Prize of Southeast University Teaching Competition<\/li>\n      <li>2022 Young Scientist Award of the International Union of Radio Science (URSI)<\/li>\n      <li>2022 Young Scientist Award of Jiangsu Cyberspace Security Association<\/li>\n      <li>2022 Zhishan Young Scholar Level A Honor of Southeast University<\/li>\n      <li>2022 Young Scientist Award of the 35th General Assembly and Scientific Symposium of the International Union of Radio Science (URSI GASS)<\/li>\n      <li>Best Review Paper of the Journal of Cryptologic Research in 2020<\/li>\n      <li>2019 Zhishan Young Scholar Level B Honor of Southeast University<\/li>\n    <\/ul>\n  <\/section>\n\n  <!-- \u7814\u7a76\u6210\u679c\u5165\u53e3 -->\n  <section class=\"pls-teacher-section\">\n    <h2>Research Achievements<\/h2>\n    <a class=\"pls-result-button\" href=\"https:\/\/jiushihema.github.io\/pls_lab\/results\/\">View All Achievements \u2192<\/a>\n  <\/section>\n    <\/main>\n  <\/div>\n<\/div><\/p>","protected":false},"excerpt":{"rendered":"","protected":false},"author":1,"featured_media":0,"parent":0,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"","meta":{"_uag_custom_page_level_css":"","footnotes":""},"class_list":["post-1499","page","type-page","status-publish","hentry"],"uagb_featured_image_src":{"full":false,"thumbnail":false,"medium":false,"medium_large":false,"large":false,"1536x1536":false,"2048x2048":false,"trp-custom-language-flag":false},"uagb_author_info":{"display_name":"jiushihema","author_link":"https:\/\/jiushihema.github.io\/pls_lab\/en\/author\/jiushihema\/"},"uagb_comment_info":0,"uagb_excerpt":null,"_links":{"self":[{"href":"https:\/\/jiushihema.github.io\/pls_lab\/en\/wp-json\/wp\/v2\/pages\/1499","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/jiushihema.github.io\/pls_lab\/en\/wp-json\/wp\/v2\/pages"}],"about":[{"href":"https:\/\/jiushihema.github.io\/pls_lab\/en\/wp-json\/wp\/v2\/types\/page"}],"author":[{"embeddable":true,"href":"https:\/\/jiushihema.github.io\/pls_lab\/en\/wp-json\/wp\/v2\/users\/1"}],"replie