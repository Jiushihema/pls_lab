tp:\/\/www.w3.org\/1998\/Math\/MathML\"><semantics><mrow><mi>n<\/mi><mo>=<\/mo><mn>25<\/mn><\/mrow><annotation encoding=\"application\/x-tex\">n=25<\/annotation><\/semantics><\/math> \u65f6\u5404\u51fd\u6570\u7684\u5177\u4f53\u8fd0\u884c\u65f6\u95f4\uff08\u6beb\u79d2\u7ea7\uff09\uff0c\u9a8c\u8bc1\u4e86\u65b9\u6848\u7684\u5b9e\u7528\u6027\u3002\u6b64\u5916\uff0c<strong>Fig. 9<\/strong> \u7684\u901a\u4fe1\u5f00\u9500\u5bf9\u6bd4\u8868\u660e\uff0cPPCA \u7684\u51ed\u8bc1\u5c3a\u5bf8\u5c0f\u4e8e [15] \u548c [43] \u4e2d\u7684\u65b9\u6848\uff0c\u5728\u9891\u7e41\u8ba4\u8bc1\u573a\u666f\u4e0b\u5177\u6709\u66f4\u4f18\u7684\u901a\u4fe1\u6548\u7387\u3002<strong>Table I<\/strong> \u7684\u529f\u80fd\u5bf9\u6bd4\u4ea6\u8868\u660e\uff0cPPCA \u662f\u552f\u4e00\u540c\u65f6\u6ee1\u8db3\u53ef\u9760\u6027\u3001\u533f\u540d\u6027\u3001\u53ef\u5173\u8054\u6027\u4e0e\u9690\u79c1\u4fdd\u62a4\u56db\u9879\u8981\u6c42\u7684\u65b9\u6848\u3002<\/p>\n<\/div>\n<\/div>\n\n\n\n<div class=\"wp-block-uagb-advanced-heading uagb-block-e3c2d50d lab-subheading\"><h3 class=\"uagb-heading-text\">\ud83d\udcdd \u5f15\u7528<\/h3><\/div>\n\n\n\n<pre class=\"wp-block-code lab-bibtex-code has-small-font-size\"><code>@article{wu2025ppca,\r\n  author    = {Tianqi Wu and Guyue Li and Jiaheng Wang and Bin Xiao and Yubo Song},\r\n  title     = {{PPCA}: Privacy-Preserving Continuous Authentication Scheme With Consistency Proof for Zero-Trust Architecture Networks},\r\n  journal   = {IEEE Internet of Things Journal},\r\n  volume    = {12},\r\n  number    = {11},\r\n  pages     = {17596--17610},\r\n  month     = jun,\r\n  year      = {2025},\r\n  doi       = {10.1109\/JIOT.2025.3537980}\r\n}\r\n<\/code><\/pre>\n<\/div>\n\n\n\n<hr class=\"wp-block-separator has-alpha-channel-opacity is-style-wide\" style=\"margin-top:var(--wp--preset--spacing--20);margin-bottom:var(--wp--preset--spacing--20)\"\/>\n\n\n\n<div class=\"wp-block-group is-layout-flow wp-block-group-is-layout-flow\">\n<div style=\"height:100px\" aria-hidden=\"