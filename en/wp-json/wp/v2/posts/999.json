t\/uploads\/2026\/03\/Channel-Robust_RF_Fingerprint_Identification_for_Multi-Antenna_5G_User_Equipments.pdf\">\ud83d\udcc4 PDF<\/a><\/div>\n\n\n\n<div class=\"wp-block-button is-style-fill\"><a class=\"wp-block-button__link wp-element-button\" href=\"https:\/\/doi.org\/10.1109\/TIFS.2025.3611154\" target=\"_blank\" rel=\"https:\/\/doi.org\/10.1109\/LWC.2023.3330809 noreferrer noopener\">\ud83d\udd17 DOI \u94fe\u63a5<\/a><\/div>\n<\/div>\n<\/div>\n\n\n\n<hr class=\"wp-block-separator has-text-color has-contrast-3-color has-alpha-channel-opacity has-contrast-3-background-color has-background is-style-wide\" style=\"margin-top:var(--wp--preset--spacing--20);margin-bottom:var(--wp--preset--spacing--20)\"\/>\n\n\n\n<div class=\"wp-block-group is-layout-flow wp-block-group-is-layout-flow\">\n<div class=\"wp-block-uagb-advanced-heading uagb-block-46005010 lab-subheading\"><h3 class=\"uagb-heading-text\">\ud83d\udccc \u6458\u8981<\/h3><\/div>\n\n\n\n<figure class=\"wp-block-pullquote has-text-align-left lab-abstract-quote has-small-font-size\" style=\"margin-right:var(--wp--preset--spacing--10);margin-left:var(--wp--preset--spacing--10);padding-top:0;padding-right:0;padding-bottom:0;padding-left:0\"><blockquote><p>\u5c04\u9891\u6307\u7eb9\uff08RFF\uff09\u662f\u5b9e\u73b0\u5b89\u5168\u9ad8\u6548\u8bbe\u5907\u8eab\u4efd\u8ba4\u8bc1\u7684\u6709\u524d\u666f\u65b9\u6848\uff0c\u4f46\u73b0\u6709\u65b9\u6cd5\u7684\u8bc6\u522b\u7cbe\u5ea6\u5728\u5b9e\u9645\u591a\u5f84\u573a\u666f\u4e0b\u53d7\u5230\u4e25\u91cd\u5f71\u54cd\u3002\u672c\u6587\u63d0\u51fa\u4e00\u79cd\u9c81\u68d2\u7684\u5c04\u9891\u6307\u7eb9\u8bc6\u522b\u65b9\u6cd5\uff0c\u5229\u7528\u4fe1\u9053\u72b6\u6001\u4fe1\u606f\u9988\u6765\u62b5\u6d88\u591a\u5f84\u4fe1\u9053\u5bf9 RFF \u7279\u5f81\u63d0\u53d6\u7684\u5f71\u54cd\u3002\u76f4\u63a5\u91c7\u7528\u8feb\u96f6\u5747\u8861\u65e0\u6cd5\u5c06\u5c04\u9891\u786c\u4ef6\u635f\u4f24\u4e0e\u4fe1\u9053\u6548\u5e94\u5b8c\u5168\u89e3\u8026\uff0c\u4f7f\u5f97\u4f20\u7edf\u65b9\u6cd5\u6548\u679c\u6709\u9650\u3002\u4e3a\u6b64\uff0c\u672c\u6587\u5145\u5206\u5229\u7528\u591a\u5929\u7ebf\u7684\u6f5c\u529b\uff0c\u63d0\u51fa\u4e00\u79cd\u65b0\u578b\u8bbe\u5907\u4e13\u5c5e\u7279\u5f81\u2014\u2014\u76f8\u5bf9\u5c04\u9891\u6307\u7eb9\uff0c\u8be5\u7279\u5f81\u523b\u753b\u4e86\u591a\u5929\u7ebf\u53d1\u5c04\u673a\u4e2d\u4e0d\u540c\u5c04\u9891\u94fe\u8def\u4e4b\u95f4\u7684\u76f8\u4e92\u5173\u7cfb\u3002\u672c\u6587\u8bbe\u8ba1\u4e86\u4e00\u79cd\u589e\u5f3a\u578b ZF \u540e\u5747\u8861\u7b97\u6cd5\uff0c\u4ee5\u6700\u5927\u7a0b\u5ea6\u5730\u6d88\u9664\u591a\u5f84\u4fe1\u9053\u5f71\u54cd\u5e76\u4fdd\u7559\u7528\u6237\u7684 R-RFF\u3002\u5728\u591a\u79cd\u4fe1\u9053\u6761\u4ef6\u548c\u566a\u58f0\u6c34\u5e73\u4e0b\u5bf9 R-RFF \u7684\u9c81\u68d2\u6027\u8fdb\u884c\u4e86\u8bc4\u4f30\uff0c\u7ed3\u679c\u8868\u660e\uff0c\u6240\u63d0 R-RFF \u65b9\u6cd5\u5728 SNR \u4e3a 30 dB \u7684 3GPP TDL \u62bd\u5934\u5ef6\u8fdf\u7ebf\u4fe1\u9053\u4e0b\uff0c\u5bf9 70 \u4e2a\u8bbe\u5907\u53ef\u5b9e\u73b0 91.2% \u7684\u8bc6\u522b\u51c6\u786e\u7387\u3002<\/p><\/blockquote><\/figure>\n\n\n\n<div class=\"wp-block-uagb-advanced-heading uagb-block-6adec98e lab-subheading\"><h3 class=\"uagb-heading-text\">\ud83d\udca1 \u6838\u5fc3\u8d21\u732e<\/h3><\/div>\n\n\n\n<ul start=\"1\" style=\"border-style:none;border-width:0px\" class=\"wp-block-list lab-feature-list\">\n<li class=\"lab-feature-list\"><strong>\u63d0\u51fa R-RFF \u65b0\u7279\u5f81\uff0c\u6316\u6398\u591a\u5929\u7ebf\u8bbe\u5907\u7684\u7269\u7406\u5c42\u6307\u7eb9\u7ef4\u5ea6<\/strong>\uff1aR-RFF \u5229\u7528\u540c\u4e00\u8bbe\u5907\u4e0d\u540c\u5929\u7ebf\u94fe\u8def\u4e4b\u95f4\u5c04\u9891\u786c\u4ef6\u635f\u4f24\u7684\u7a33\u5b9a\u76f8\u5bf9\u5173\u7cfb\u6784\u5efa\u7279\u5f81\u5411\u91cf\uff0c\u8be5\u7279\u5f81\u672c\u8d28\u4e0a\u662f\u4e00\u79cd\u7269\u7406\u4e0d\u53ef\u514b\u9686\u51fd\u6570\uff08PUF\uff09\uff0c\u4e0e\u4fe1\u9053\u72b6\u6001\u65e0\u5173\uff0c\u4e3a 5G \u591a\u5929\u7ebf\u7cfb\u7edf\u7684\u7269\u7406\u5c42\u5b89\u5168\u63d0\u4f9b\u4e86\u5168\u65b0\u7ef4\u5ea6\uff0c\u540c\u65f6\u652f\u6301\u521d\u59cb\u8ba4\u8bc1\u4e0e\u5468\u671f\u6027\u6301\u7eed\u8ba4\u8bc1\u3002<\/li>\n\n\n\n<li class=\"lab-feature-list\"><strong>\u8bbe\u8ba1\u589e\u5f3a\u578b ZF \u540e\u5747\u8861\u6846\u67b6\uff0c\u4ece\u7406\u8bba\u4e0a\u8bc1\u660e R-RFF \u7684\u4fe1\u9053\u72ec\u7acb\u6027<\/strong>\uff1a\u9488\u5bf9\u9884\u7f16\u7801\u65b9\u6848\u65e0\u6cd5\u5b8c\u5168\u89e3\u8026\u5c04\u9891\u635f\u4f24\u4e0e\u591a\u5f84\u4fe1\u9053\u7684\u95ee\u9898\uff0c\u63d0\u51fa\u57fa\u4e8e CSI \u53cd\u9988\u7684\u540e\u5747\u8861\u51fd\u6570 <math xmlns=\"http:\/\/www.w3.org\/1998\/Math\/MathML\"><semantics><mrow><mi>F<\/mi><mo stretchy=\"false\">(<\/mo><msub><mover accent=\"true\"><mi>H<\/mi><mo>~<\/mo><\/mover><mi>U<\/mi><\/msub><mo stretchy=\"false\">)<\/mo><\/mrow><annotation encoding=\"application\/x-tex\">F(\\tilde{H}_U)<\/annotation><\/semantics><\/math>F(H~U\u200b)\uff0c\u901a\u8fc7\u5229\u7528 TDD \u4e0a\u4e0b\u884c\u4fe1\u9053\u4e92\u6613\u6027\u6784\u9020\u7b49\u6548\u53d8\u6362\uff0c\u7406\u8bba\u8bc1\u660e\u5747\u8861\u540e\u63d0\u53d6\u7684\u7279\u5f81 <math xmlns=\"http:\/\/www.w3.org\/1998\/Math\/MathML\"><semantics><mrow><msub><mi>C<\/mi><mrow><mi>U<\/mi><mi>E<\/mi><\/mrow><\/msub><mo>\u2248<\/mo><msub><mi>T<\/mi><mrow><mi>U<\/mi><mi>E<\/mi><\/mrow><\/msub><mo stretchy=\"false\">(<\/mo><msub><mi>R<\/mi><mrow><mi>U<\/mi><mi>E<\/mi><\/mrow><\/msub><msup><mo stretchy=\"false\">)<\/mo><mrow><mo>\u2212<\/mo><mn>1<\/mn><\/mrow><\/msup><\/mrow><annotation encoding=\"application\/x-tex\">C_{UE} \\approx T_{UE}(R_{UE})^{-1}<\/annotation><\/semantics><\/math>CUE\u200b\u2248TUE\u200b(RUE\u200b)\u22121 \u4e0e\u591a\u5f84\u4fe1\u9053\u65e0\u5173\uff0c\u4ece\u6839\u672c\u4e0a\u4fdd\u8bc1\u4e86\u7279\u5f81\u7684\u9c81\u68d2\u6027\u3002<\/li>\n\n\n\n<li class=\"lab-feature-list\"><strong>\u5efa\u7acb\u5b8c\u6574\u7684 5G NR \u4eff\u771f\u7cfb\u7edf\uff0c\u8986\u76d6\u5168\u90e8 TDL \u4fe1\u9053\u6a21\u578b<\/strong>\uff1a\u57fa\u4e8e MATLAB 5G NR \u5de5\u5177\u7bb1\uff0c\u9488\u5bf9 110 \u4e2a UE \u6a21\u62df\u4e86 AWGN\u3001Rician\u3001TDL-A\/B\/C\/D\/E \u5171 6 \u7c7b\u4fe1\u9053\u573a\u666f\uff0c\u7ed3\u5408\u591a SNR \u7ea7\u522b\u4e0e\u7efc\u5408\u6570\u636e\u589e\u5f3a\u8bad\u7ec3\u7b56\u7565\uff0c\u5168\u9762\u8bc4\u4f30\u4e86\u4e0d\u540c\u591a\u5f84\u6761\u4ef6\u4e0b\u7684 RFF \u6027\u80fd\uff0c\u5e76\u5206\u6790\u4e86 Doppler \u6548\u5e94\u5bf9\u8bc6\u522b\u7cbe\u5ea6\u7684\u5f71\u54cd\uff0c\u7ed9\u51fa\u4e86\u5404 SCS \u914d\u7f6e\u4e0b\u652f\u6301\u79fb\u52a8\u901f\u5ea6\u7684\u5b9a\u91cf\u8fb9\u754c\u3002<\/li>\n<\/ul>\n\n\n\n<div class=\"wp-block-uagb-advanced-heading uagb-block-2f9d57f4 lab-subheading\"><h3 class=\"uagb-heading-text\">\ud83d\udd27 \u65b9\u6cd5\u6982\u89c8<\/h3><\/div>\n\n\n\n<div class=\"wp-block-group lab-paper-results is-nowrap is-layout-flex wp-container-core-group-is-layout-3a88641f wp-block-group-is-layout-flex\">\n<div class=\"wp-block-uagb-image uagb-block-b46d2053 wp-block-uagb-image--layout-default wp-block-uagb-image--effect-static wp-block-uagb-image--align-none wp-container-content-9cfa9a5a\"><figure class=\"wp-block-uagb-image__figure\"><img decoding=\"async\" srcset=\"http:\/\/System.Management.Automation.Internal.Host.InternalHost\/wp-content\/uploads\/2026\/03\/PixPin_2026-03-18_17-34-23.png ,http:\/\/System.Management.Automation.Internal.Host.InternalHost\/wp-content\/uploads\/2026\/03\/PixPin_2026-03-18_17-34-23.png 780w, http:\/\/System.Management.Automation.Internal.Host.InternalHost\/wp-content\/uploads\/2026\/03\/PixPin_2026-03-18_17-34-23.png 360w\" sizes=\"auto, (max-width: 480px) 150px\" src=\"http:\/\/System.Management.Automation.Internal.Host.InternalHost\/wp-content\/uploads\/2026\/03\/PixPin_2026-03-18_17-34-23.png\" alt=\"\" class=\"uag-image-1001\" width=\"802\" height=\"656\" title=\"PixPin_2026-03-18_17-34-23\" loading=\"lazy\" role=\"img\"\/><\/figure><\/div>\n\n\n\n<div class=\"wp-block-group is-vertical is-layout-flex wp-container-core-group-is-layout-831b2db5 wp-block-group-is-layout-flex\">\n<p class=\"lab-experiment-caption has-medium-font-size wp-block-paragraph\">\u7cfb\u7edf\u7531\u914d\u5907 <math xmlns=\"http:\/\/www.w3.org\/1998\/Math\/MathML\"><semantics><mrow><mi>M<\/mi><mo>=<\/mo><mn>32<\/mn><\/mrow><annotation encoding=\"application\/x-tex\">M=32<\/annotation><\/semantics><\/math>\u6839\u5929\u7ebf\u7684 gNB \u548c\u914d\u5907 <math xmlns=\"http:\/\/www.w3.org\/1998\/Math\/MathML\"><semantics><mrow><mi>N<\/mi><mo>=<\/mo><mn>2<\/mn><\/mrow><annotation encoding=\"application\/x-tex\">N=2<\/annotation><\/semantics><\/math>\u6216 <math xmlns=\"http:\/\/www.w3.org\/1998\/Math\/MathML\"><semantics><mrow><mn>4<\/mn><\/mrow><annotation encoding=\"application\/x-tex\">4<\/annotation><\/semantics><\/math>\u6839\u5929\u7ebf\u7684 UE \u7ec4\u6210\uff0c\u5de5\u4f5c\u4e8e TDD-OFDM \u6a21\u5f0f\u3002<strong>R-RFF \u63d0\u53d6\u6d41\u7a0b<\/strong>\u5206\u4e3a\u4e09\u4e2a\u9636\u6bb5\uff1a\u9996\u5148\uff0cgNB \u901a\u8fc7\u5929\u7ebf\u5faa\u73af\u5207\u6362\u7b56\u7565\u83b7\u53d6\u81ea\u8eab\u7684\u76f8\u5bf9\u635f\u4f24\u77e9\u9635 <math xmlns=\"http:\/\/www.w3.org\/1998\/Math\/MathML\"><semantics><mrow><msub><mi>C<\/mi><mrow><mi>g<\/mi><mi>N<\/mi><mi>B<\/mi><\/mrow><\/msub><mo>=<\/mo><msub><mi>T<\/mi><mrow><mi>g<\/mi><mi>N<\/mi><mi>B<\/mi><\/mrow><\/msub><mo stretchy=\"false\">(<\/mo><msub><mi>R<\/mi><mrow><mi>g<\/mi><mi>N<\/mi><mi>B<\/mi><\/mrow><\/msub><msup><mo stretchy=\"false\">)<\/mo><mrow><mo>\u2212<\/mo><mn>1<\/mn><\/mrow><\/msup><\/mrow><annotation encoding=\"application\/x-tex\">C_{gNB} = T_{gNB}(R_{gNB})^{-1}<\/annotation><\/semantics><\/math>\uff1b\u968f\u540e\uff0cUE \u5c06\u4e0b\u884c\u4fe1\u9053\u4f30\u8ba1 <math xmlns=\"http:\/\/www.w3.org\/1998\/Math\/MathML\"><semantics><mrow><msub><mover accent=\"true\"><mi>H<\/mi><mo>^<\/mo><\/mover><mi>D<\/mi><\/msub><\/mrow><annotation encoding=\"application\/x-tex\">\\hat{H}_D<\/annotation><\/semantics><\/math> \u53cd\u9988\u81f3 gNB\uff0cgNB \u5229\u7528\u4e0a\u4e0b\u884c\u4fe1\u9053\u4e92\u6613\u6027 <math xmlns=\"http:\/\/www.w3.org\/1998\/Math\/MathML\"><semantics><mrow><msub><mover accent=\"true\"><mi>H<\/mi><mo>~<\/mo><\/mover><mi>U<\/mi><\/msub><mo>\u2248<\/mo><msubsup><mover accent=\"true\"><mi>H<\/mi><mo>~<\/mo><\/mover><mi>D<\/mi><mi>T<\/mi><\/msubsup><\/mrow><annotation encoding=\"application\/x-tex\">\\tilde{H}_U \\approx \\tilde{H}_D^T<\/annotation><\/semantics><\/math>\u200b \u6784\u9020\u540e\u5747\u8861\u51fd\u6570 <math xmlns=\"http:\/\/www.w3.org\/1998\/Math\/MathML\"><semantics><mrow><mi>F<\/mi><mo>=<\/mo><mo stretchy=\"false\">(<\/mo><msubsup><mi>T<\/mi><mrow><mi>g<\/mi><mi>N<\/mi><mi>B<\/mi><\/mrow><mi>T<\/mi><\/msubsup><msubsup><mover accent=\"true\"><mi>H<\/mi><mo>~<\/mo><\/mover><mi>D<\/mi><mi>T<\/mi><\/msubsup><msubsup><mi>R<\/mi><mrow><mi>U<\/mi><mi>E<\/mi><\/mrow><mi>T<\/mi><\/msubsup><msup><mo stretchy=\"false\">)<\/mo><mrow><mo>\u2212<\/mo><mn>1<\/mn><\/mrow><\/msup><\/mrow><annotation encoding=\"application\/x-tex\">F = (T_{gNB}^T \\tilde{H}_D^T R_{UE}^T)^{-1}<\/annotation><\/semantics><\/math>\uff1b\u6700\u540e\uff0cgNB \u5bf9\u63a5\u6536\u7684\u4e0a\u884c\u4fe1\u9053\u4f30\u8ba1 <math xmlns=\"http:\/\/www.w3.org\/1998\/Math\/MathML\"><semantics><mrow><msub><mover accent=\"true\"><mi>H<\/mi><mo>^<\/mo><\/mover><mi>U<\/mi><\/msub><\/mrow><annotation encoding=\"application\/x-tex\">\\hat{H}_U<\/annotation><\/semantics><\/math>\u200b \u5e94\u7528 <math xmlns=\"http:\/\/www.w3.org\/1998\/Math\/MathML\"><semantics><mrow><mi>F<\/mi><\/mrow><annotation encoding=\"application\/x-tex\">F<\/annotation><\/semantics><\/math>F \u5e76\u5de6\u4e58\u4f2a\u9006\u77e9\u9635 <math xmlns=\"http:\/\/www.w3.org\/1998\/Math\/MathML\"><semantics><mrow><mi>W<\/mi><\/mrow><annotation encoding=\"application\/x-tex\">W<\/annotation><\/semantics><\/math>W\uff0c\u63d0\u53d6\u51fa\u4e0e\u4fe1\u9053\u65e0\u5173\u7684 R-RFF \u7279\u5f81 <math xmlns=\"http:\/\/www.w3.org\/1998\/Math\/MathML\"><semantics><mrow><msub><mi>C<\/mi><mrow><mi>U<\/mi><mi>E<\/mi><\/mrow><\/msub><\/mrow><annotation encoding=\"application\/x-tex\">C_{UE}<\/annotation><\/semantics><\/math>\u200b\u3002\u63d0\u53d6\u7684 R-RFF \u4ee5 <math xmlns=\"http:\/\/www.w3.org\/1998\/Math\/MathML\"><semantics><mrow><msub><mi>N<\/mi><mrow><mi>S<\/mi><mi>C<\/mi><\/mrow><\/msub><mo>\u00d7<\/mo><mi>N<\/mi><mo>\u00d7<\/mo><mi>N<\/mi><\/mrow><annotation encoding=\"application\/x-tex\">N_{SC} \\times N \\times N<\/annotation><\/semantics><\/math> \u7684\u5f20\u91cf\u5f62\u5f0f\u8f93\u5165\u6539\u8fdb\u7248 AlexNet\uff085 \u4e2a\u5377\u79ef\u5c42 + 2 \u4e2a\u5168\u8fde\u63a5\u5c42\uff09\u8fdb\u884c\u5206\u7c7b\uff0c\u8bad\u7ec3\u65f6\u91c7\u7528\u8986\u76d6\u591a\u4fe1\u9053\u7c7b\u578b\u4e0e SNR \u7ea7\u522b\u7684\u7efc\u5408\u4eff\u771f\u7b56\u7565\u4ee5\u589e\u5f3a\u6cdb\u5316\u80fd\u529b\u3002<\/p>\n<\/div>\n<\/div>\n\n\n\n<div class=\"wp-block-uagb-advanced-heading uagb-block-dda34f26 lab-subheading\"><h3 class=\"uagb-heading-text\">\ud83d\udcca \u5b9e\u9a8c\u7ed3\u679c<\/h3><\/div>\n\n\n\n<div class=\"wp-block-group lab-paper-results is-nowrap is-layout-flex wp-container-core-group-is-layout-3a88641f wp-block-group-is-layout-flex\">\n<div class=\"wp-block-uagb-image uagb-block-080de2b0 wp-block-uagb-image--layout-default wp-block-uagb-image--effect-static wp-block-uagb-image--align-none wp-container-content-9cfa9a5a\"><figure class=\"wp-block-uagb-image__figure\"><img decoding=\"async\" srcset=\"http:\/\/System.Management.Automation.Internal.Host.InternalHost\/wp-content\/uploads\/2026\/03\/PixPin_2026-03-18_17-35-34.png ,http:\/\/System.Management.Automation.Internal.Host.InternalHost\/wp-content\/uploads\/2026\/03\/PixPin_2026-03-18_17-35-34.png 780w, http:\/\/System.Management.Automation.Internal.Host.InternalHost\/wp-content\/uploads\/2026\/03\/PixPin_2026-03-18_17-35-34.png 360w\" sizes=\"auto, (max-width: 480px) 150px\" src=\"http:\/\/System.Management.Automation.Internal.Host.InternalHost\/wp-content\/uploads\/2026\/03\/PixPin_2026-03-18_17-35-34.png\" alt=\"\" class=\"uag-image-1002\" width=\"802\" height=\"656\" title=\"PixPin_2026-03-18_17-35-34\" loading=\"lazy\" role=\"img\"\/><\/figure><\/div>\n\n\n\n<div class=\"wp-block-group is-vertical is-layout-flex wp-container-core-group-is-layout-831b2db5 wp-block-group-is-layout-flex\">\n<p class=\"lab-experiment-caption has-medium-font-size wp-block-paragraph\"><strong>\u5728 TDL-C \u591a\u5f84\u4fe1\u9053\u4e0b\uff0cR-RFF \u65b9\u6cd5\u5bf9 30 \u4e2a\u8bbe\u5907\u7684\u8bc6\u522b\u51c6\u786e\u7387\u8fbe\u5230 93.3%\uff08SNR = 25 dB\uff09\uff0c\u800c\u57fa\u51c6\u65b9\u6cd5\u4ec5\u4e3a 57.3%\uff0c\u63d0\u5347\u7ea6 36 \u4e2a\u767e\u5206\u70b9<\/strong>\uff1a\u5982\u539f\u6587 <strong>Fig. 6<\/strong> \u6240\u793a\uff0c\u5728 AWGN \u4fe1\u9053\u4e0b\u4e24\u79cd\u65b9\u6cd5\u5747\u8868\u73b0\u826f\u597d\uff0c\u4f46\u5728\u5f15\u5165\u591a\u5f84\u8870\u843d\u540e\uff0c\u57fa\u51c6\u65b9\u6cd5 [20] \u5728\u4e24\u5f84\u4fe1\u9053\u4e0b\u51c6\u786e\u7387\u964d\u81f3 71.6%\uff0c\u5728 TDL-C \u4fe1\u9053\u4e0b\u8fdb\u4e00\u6b65\u8dcc\u81f3 57.3%\uff1b\u76f8\u6bd4\u4e4b\u4e0b\uff0cR-RFF \u65b9\u6848\u5728 TDL-C \u4fe1\u9053\u4e0b\u4ecd\u4fdd\u6301 93.3% \u7684\u51c6\u786e\u7387\uff0c\u5728 SNR = 15 dB \u7684\u4f4e\u4fe1\u566a\u6bd4\u6761\u4ef6\u4e0b\u4ea6\u8fbe\u5230 59.9%\uff08\u57fa\u51c6\u4ec5 39.9%\uff09\uff0c\u5145\u5206\u9a8c\u8bc1\u4e86\u6240\u63d0\u65b9\u6cd5\u5bf9\u591a\u5f84\u5e72\u6270\u7684\u9c81\u68d2\u6027\u3002<\/p>\n<\/div>\n<\/div>\n\n\n\n<div class=\"wp-block-uagb-advanced-heading uagb-block-e3c2d50d lab-subheading\"><h3 class=\"uagb-heading-text\">\ud83d\udcdd \u5f15\u7528<\/h3><\/div>\n\n\n\n<pre class=\"wp-block-code lab-bibtex-code has-small-font-size\"><code>@article{luo2025rrff,\n  author    = {Hongyi Luo and Guyue Li and Alessandro Brighente and Mauro Conti and Yuexiu Xing and Aiqun Hu and Xianbin Wang},\n  title     = {Channel-Robust {RF} Fingerprint Identification 